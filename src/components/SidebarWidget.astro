---
import { siteConfig } from '../../config';

interface Props {
  showPersonalInfo?: boolean;
  showSiteAnnouncement?: boolean;
  showSiteStats?: boolean;
  compact?: boolean;
}

const {
  showPersonalInfo = true,
  showSiteAnnouncement = true,
  showSiteStats = true,
  compact = false,
} = Astro.props;
---

<aside class:list={['sidebar-widget', { compact }]}>
  {showPersonalInfo && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-user"></i>
        <span>个人信息</span>
      </div>
      <div class="panel-body">
        <div class:list={['sidebar-avatar-wrap', { mini: compact }]}>
          <img src="/avatar.webp" alt="Yuami" class="sidebar-avatar" />
        </div>
        <h2 class:list={['sidebar-name', { mini: compact }]}>Yuami</h2>
        <p class:list={['sidebar-motto', { mini: compact }]}>{siteConfig.subtitle}</p>
        <div class="sidebar-social">
          {siteConfig.socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" title={link.name} class="social-icon">
              <i class={link.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {showSiteAnnouncement && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-bullhorn"></i>
        <span>站点公告</span>
      </div>
      <div class="panel-body">
        <div class="notice-list">
          {siteConfig.siteAnnouncements.map((item) => (
            <div class="notice-item">
              <span class="notice-date">{item.date}</span>
              <p class="notice-text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {showSiteStats && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-chart-bar"></i>
        <span>站点统计</span>
      </div>
      <div class="panel-body">
        <div class="stat-list"
          data-start-date={siteConfig.siteStats.startDate}
          data-total-posts={siteConfig.siteStats.totalPosts}
          data-total-words={siteConfig.siteStats.totalWords}
          data-last-edit={siteConfig.siteStats.lastEdit}
        >
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-file-lines"></i> 总文章数</span>
            <span class="stat-value" id="sidebarStatPosts">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-font"></i> 总字数</span>
            <span class="stat-value" id="sidebarStatWords">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-clock"></i> 运行时长</span>
            <span class="stat-value" id="sidebarStatDays">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-pen-to-square"></i> 最后编辑</span>
            <span class="stat-value" id="sidebarStatLastEdit">--</span>
          </div>
        </div>
      </div>
    </div>
  )}
</aside>

<style>
  .sidebar-widget {
    width: var(--sidebar-width);
    min-width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-height) + 16px);
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-widget.compact {
    width: var(--sidebar-width);
  }

  .sidebar-panel {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    width: 100%;
    transition: all var(--transition-normal);
  }

  .sidebar-panel:hover {
    box-shadow: var(--shadow-hover);
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
  }

  .panel-header i {
    font-size: 0.88rem;
  }

  .panel-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Avatar */
  .sidebar-avatar-wrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--primary-alpha-30);
    box-shadow: 0 4px 15px rgba(125, 152, 245, 0.2);
    transition: all var(--transition-normal);
    margin-bottom: 10px;
  }

  .sidebar-avatar-wrap.mini {
    width: 56px;
    height: 56px;
    margin-bottom: 6px;
    border-width: 2px;
  }

  .sidebar-avatar-wrap:hover {
    transform: scale(1.05);
    border-color: var(--primary);
  }

  .sidebar-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-name {
    font-size: 1.3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 2px;
  }

  .sidebar-name.mini {
    font-size: 1rem;
  }

  .sidebar-motto {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
    margin-bottom: 10px;
  }

  .sidebar-motto.mini {
    font-size: 0.78rem;
    margin-bottom: 6px;
  }

  .sidebar-social {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .social-icon:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(125, 152, 245, 0.3);
  }

  /* Site Announcement */
  .notice-list {
    width: 100%;
  }

  .notice-item {
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .notice-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .notice-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 2px;
  }

  .notice-text {
    font-size: 0.85rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  /* Stats */
  .stat-list {
    width: 100%;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .stat-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-label i {
    color: var(--primary);
    font-size: 0.82rem;
  }

  .stat-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
  }

  @media (max-width: 1024px) {
    .sidebar-widget {
      position: static;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .sidebar-panel {
      flex: 1;
      min-width: 260px;
    }
  }

  @media (max-width: 768px) {
    .sidebar-widget {
      flex-direction: column;
    }
    .sidebar-panel {
      min-width: auto;
    }
  }
</style>

<script>
  // 站点统计数据 - 从 data attributes 读取配置
  const statList = document.querySelector('.stat-list[data-start-date]') as HTMLElement;
  if (statList) {
    const startDate = statList.dataset.startDate || '2026-01-01';
    const totalPosts = parseInt(statList.dataset.totalPosts || '6');
    const totalWords = parseInt(statList.dataset.totalWords || '12000');
    const lastEdit = statList.dataset.lastEdit || '2026-05-01';

    const days = Math.floor((Date.now() - new Date(startDate).getTime()) / (1000 * 60 * 60 * 24));

    const statPosts = document.getElementById('sidebarStatPosts');
    const statWords = document.getElementById('sidebarStatWords');
    const statDays = document.getElementById('sidebarStatDays');
    const statLastEdit = document.getElementById('sidebarStatLastEdit');

    if (statDays) statDays.textContent = days + ' 天';
    if (statPosts) statPosts.textContent = totalPosts + ' 篇';
    if (statWords) {
      if (totalWords >= 10000) {
        statWords.textContent = '约 ' + (totalWords / 10000).toFixed(1) + ' 万字';
      } else {
        statWords.textContent = totalWords + ' 字';
      }
    }
    if (statLastEdit) {
      // 只显示日期部分（如 2026-05-24）
      const dateMatch = lastEdit.match(/\d{4}[-/]\d{2}[-/]\d{2}/);
      statLastEdit.textContent = dateMatch ? dateMatch[0] : lastEdit.substring(0, 10);
    }
  }
</script>
