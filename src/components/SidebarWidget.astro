---
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../utils/dateFormat';

interface Props {
  showPersonalInfo?: boolean;
  showSiteAnnouncement?: boolean;
  showSiteStats?: boolean;
  compact?: boolean; // 保留接口兼容性，但不再影响样式
  totalPosts?: number;
  totalWords?: number;
  lastEdit?: string;
}

const {
  showPersonalInfo = true,
  showSiteAnnouncement = true,
  showSiteStats = true,
  compact: _compact, // 忽略 compact 参数，始终使用完整样式
  totalPosts: propTotalPosts,
  totalWords: propTotalWords,
  lastEdit: propLastEdit,
} = Astro.props;

// 如果未通过props传入统计数据，则自动计算
let totalPosts = propTotalPosts;
let totalWords = propTotalWords;
let lastEdit = propLastEdit;

if (totalPosts === undefined || totalWords === undefined || lastEdit === undefined) {
  const allPots = await getCollection('pots');
  const allDiary = await getCollection('diary');
  if (totalPosts === undefined) totalPosts = allPots.length + allDiary.length;
  if (totalWords === undefined) {
    totalWords = 0;
    allPots.forEach(p => { totalWords += (p.body || '').replace(/\s/g, '').length; });
    allDiary.forEach(d => { totalWords += (d.body || '').replace(/\s/g, '').length; });
  }
  if (lastEdit === undefined) {
    const allDates = [
      ...allPots.map(p => p.data.published || p.data.date || ''),
      ...allDiary.map(d => d.data.date || ''),
    ].filter(Boolean).sort().reverse();
    lastEdit = allDates[0] ? formatDateShort(allDates[0]) : '';
  }
}

// 格式化 lastEdit
if (lastEdit) {
  lastEdit = formatDateShort(lastEdit);
}

const isStatsEnabled = siteConfig.siteStats?.enabled !== false && showSiteStats;
const isAnnouncementEnabled = siteConfig.siteAnnouncements?.enabled !== false && showSiteAnnouncement;
const announcements = siteConfig.siteAnnouncements?.items || siteConfig.siteAnnouncements || [];
---

<aside class="sidebar-widget">
  {showPersonalInfo && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-user"></i>
        <span>个人信息</span>
      </div>
      <div class="panel-body">
        <div class="sidebar-avatar-wrap">
          <img src={siteConfig.avatar || '/home/avatar.webp'} alt={siteConfig.author || 'Yuami'} class="sidebar-avatar" />
        </div>
        <h2 class="sidebar-name">{siteConfig.author || 'Yuami'}</h2>
        <p class="sidebar-motto">{siteConfig.subtitle}</p>
        <div class="sidebar-social">
          {siteConfig.socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" title={link.name} class="social-icon">
              <i class={link.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {isAnnouncementEnabled && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-bullhorn"></i>
        <span>站点公告</span>
      </div>
      <div class="panel-body">
        <div class="notice-list">
          {announcements.map((item: { date: string; text: string }) => (
            <div class="notice-item">
              <span class="notice-date">{formatDateShort(item.date)}</span>
              <p class="notice-text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {isStatsEnabled && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-chart-bar"></i>
        <span>站点统计</span>
      </div>
      <div class="panel-body">
        <div class="stat-list"
          data-start-date={siteConfig.siteStats?.startDate || '2026-01-01'}
          data-total-posts={totalPosts}
          data-total-words={totalWords}
          data-last-edit={lastEdit}
        >
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-file-lines"></i> 总文章数</span>
            <span class="stat-value" id="sidebarStatPosts">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-font"></i> 总字数</span>
            <span class="stat-value" id="sidebarStatWords">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-clock"></i> 运行时长</span>
            <span class="stat-value" id="sidebarStatDays">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-pen-to-square"></i> 最后编辑</span>
            <span class="stat-value" id="sidebarStatLastEdit">--</span>
          </div>
        </div>
      </div>
    </div>
  )}
</aside>

<style>
  .sidebar-widget {
    width: var(--sidebar-width);
    min-width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-height) + 16px);
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-panel {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    width: 100%;
    transition: all var(--transition-normal);
  }

  .sidebar-panel:hover {
    box-shadow: var(--shadow-hover);
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
  }

  .panel-header i {
    font-size: 0.88rem;
  }

  .panel-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sidebar-avatar-wrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--primary-alpha-30);
    box-shadow: 0 4px 15px rgba(125, 152, 245, 0.2);
    transition: all var(--transition-normal);
    margin-bottom: 10px;
  }

  .sidebar-avatar-wrap:hover {
    transform: scale(1.05);
    border-color: var(--primary);
  }

  .sidebar-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-name {
    font-size: 1.3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 2px;
  }

  .sidebar-motto {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
    margin-bottom: 10px;
  }

  .sidebar-social {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .social-icon:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(125, 152, 245, 0.3);
  }

  .notice-list {
    width: 100%;
  }

  .notice-item {
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .notice-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .notice-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 2px;
  }

  .notice-text {
    font-size: 0.85rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .stat-list {
    width: 100%;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .stat-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-label i {
    color: var(--primary);
    font-size: 0.82rem;
  }

  .stat-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
  }

  @media (max-width: 1024px) {
    .sidebar-widget {
      position: static;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .sidebar-panel {
      flex: 1;
      min-width: 260px;
    }
  }

  @media (max-width: 768px) {
    .sidebar-widget {
      flex-direction: column;
    }
    .sidebar-panel {
      min-width: auto;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const statList = document.querySelector('.stat-list[data-start-date]') as HTMLElement;
    if (!statList) return;

    const startDate = statList.dataset.startDate || '2026-01-01';
    const totalPosts = parseInt(statList.dataset.totalPosts || '0');
    const totalWords = parseInt(statList.dataset.totalWords || '0');
    const lastEdit = statList.dataset.lastEdit || '';

    const days = Math.floor((Date.now() - new Date(startDate).getTime()) / (1000 * 60 * 60 * 24));

    const statPosts = document.getElementById('sidebarStatPosts');
    const statWords = document.getElementById('sidebarStatWords');
    const statDays = document.getElementById('sidebarStatDays');
    const statLastEdit = document.getElementById('sidebarStatLastEdit');

    if (statDays) statDays.textContent = days + ' 天';
    if (statPosts) statPosts.textContent = totalPosts + ' 篇';
    if (statWords) {
      if (totalWords >= 10000) {
        statWords.textContent = '约 ' + (totalWords / 10000).toFixed(1) + ' 万字';
      } else {
        statWords.textContent = totalWords + ' 字';
      }
    }
    if (statLastEdit) {
      // lastEdit 已经在构建时格式化为 YYYY-MM-DD，直接显示
      const dateMatch = lastEdit.match(/\d{4}[-/]\d{2}[-/]\d{2}/);
      statLastEdit.textContent = dateMatch ? dateMatch[0] : lastEdit.substring(0, 10);
    }
  });
</script>
