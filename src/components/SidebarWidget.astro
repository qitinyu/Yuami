---
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';

interface Props {
  showPersonalInfo?: boolean;
  showSiteStats?: boolean;
  showSiteRecommend?: boolean;
  compact?: boolean;
}

const {
  showPersonalInfo = true,
  showSiteStats = true,
  showSiteRecommend = true,
  compact = false,
} = Astro.props;

// 动态计算站点统计
const allPosts = await getCollection('posts');
const allDiary = await getCollection('diary');
const allContent = [...allPosts, ...allDiary];

const totalPosts = allContent.length;
const totalWords = allContent.reduce((sum, entry) => {
  const text = entry.body || '';
  return sum + text.replace(/\s/g, '').length;
}, 0);
const lastEdit = allContent
  .map(e => e.data.date)
  .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())[0] || '--';
---

<aside class:list={['sidebar-widget', { compact }]}>
  {showPersonalInfo && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-user"></i>
        <span>个人信息</span>
      </div>
      <div class="panel-body">
        <div class:list={['sidebar-avatar-wrap', { mini: compact }]}>
          <img src="/avatar.webp" alt="Yuami" class="sidebar-avatar" />
        </div>
        <h2 class:list={['sidebar-name', { mini: compact }]}>Yuami</h2>
        <p class:list={['sidebar-motto', { mini: compact }]}>{siteConfig.subtitle}</p>
        <div class="sidebar-social">
          {siteConfig.socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" title={link.name} class="social-icon">
              <i class={link.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {showSiteStats && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-chart-bar"></i>
        <span>站点统计</span>
      </div>
      <div class="panel-body">
        <div class="stat-list" data-start-date={siteConfig.siteStats.startDate}>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-file-lines"></i> 总文章数</span>
            <span class="stat-value">{totalPosts} 篇</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-font"></i> 总字数</span>
            <span class="stat-value">{totalWords >= 10000 ? '约 ' + (totalWords / 10000).toFixed(1) + ' 万字' : totalWords + ' 字'}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-clock"></i> 运行时长</span>
            <span class="stat-value" id="sidebarStatDays">--</span>
          </div>
          <div class="stat-row">
            <span class="stat-label"><i class="fa-solid fa-pen-to-square"></i> 最后编辑</span>
            <span class="stat-value">{lastEdit}</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {showSiteRecommend && (
    <div class="sidebar-panel">
      <div class="panel-header">
        <i class="fa-solid fa-star"></i>
        <span>站点推荐</span>
      </div>
      <div class="panel-body">
        <div class="recommend-list">
          {siteConfig.siteRecommendations.map((site) => (
            <a href={site.url} target="_blank" rel="noopener" class="recommend-item">
              <div class="recommend-info">
                <span class="recommend-name">{site.name}</span>
                <span class="recommend-desc">{site.desc}</span>
              </div>
              <i class="fa-solid fa-arrow-up-right-from-square recommend-link-icon"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}
</aside>

<style>
  .sidebar-widget {
    width: var(--sidebar-width);
    min-width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-height) + 16px);
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-widget.compact {
    width: var(--sidebar-width);
  }

  .sidebar-panel {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    width: 100%;
    transition: all var(--transition-normal);
  }

  .sidebar-panel:hover {
    box-shadow: var(--shadow-hover);
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
  }

  .panel-header i {
    font-size: 0.88rem;
  }

  .panel-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Avatar */
  .sidebar-avatar-wrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--primary-alpha-30);
    box-shadow: 0 4px 15px rgba(125, 152, 245, 0.2);
    transition: all var(--transition-normal);
    margin-bottom: 10px;
  }

  .sidebar-avatar-wrap.mini {
    width: 56px;
    height: 56px;
    margin-bottom: 6px;
    border-width: 2px;
  }

  .sidebar-avatar-wrap:hover {
    transform: scale(1.05);
    border-color: var(--primary);
  }

  .sidebar-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-name {
    font-size: 1.3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 2px;
  }

  .sidebar-name.mini {
    font-size: 1rem;
  }

  .sidebar-motto {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
    margin-bottom: 10px;
  }

  .sidebar-motto.mini {
    font-size: 0.78rem;
    margin-bottom: 6px;
  }

  .sidebar-social {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .social-icon:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(125, 152, 245, 0.3);
  }

  /* Stats */
  .stat-list {
    width: 100%;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .stat-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-label i {
    color: var(--primary);
    font-size: 0.82rem;
  }

  .stat-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
  }

  /* Site Recommendations */
  .recommend-list {
    width: 100%;
  }

  .recommend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .recommend-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .recommend-item:hover .recommend-name {
    color: var(--primary);
  }

  .recommend-item:hover .recommend-link-icon {
    color: var(--primary);
    transform: translate(2px, -2px);
  }

  .recommend-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .recommend-name {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .recommend-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .recommend-link-icon {
    color: var(--text-muted);
    font-size: 0.7rem;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  @media (max-width: 1024px) {
    .sidebar-widget {
      position: static;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .sidebar-panel {
      flex: 1;
      min-width: 260px;
    }
  }

  @media (max-width: 768px) {
    .sidebar-widget {
      flex-direction: column;
    }
    .sidebar-panel {
      min-width: auto;
    }
  }
</style>

<script>
  // 运行时长 - 唯一需要在客户端动态计算的数据
  const statList = document.querySelector('.stat-list[data-start-date]') as HTMLElement;
  if (statList) {
    const startDate = statList.dataset.startDate || '2026-01-01';
    const days = Math.floor((Date.now() - new Date(startDate).getTime()) / (1000 * 60 * 60 * 24));
    const statDays = document.getElementById('sidebarStatDays');
    if (statDays) statDays.textContent = days + ' 天';
  }
</script>
