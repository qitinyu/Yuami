---
import { siteConfig } from '../../config';

const sakura = siteConfig.sakura;
const isEnabled = sakura.enabled;
const isMobileOff = sakura.mobileOff;
---

{isEnabled && (
  <div class="sakura-container" id="sakuraContainer"
    data-petals={sakura.petals}
    data-min-size={sakura.minSize}
    data-max-size={sakura.maxSize}
    data-min-duration={sakura.minDuration}
    data-max-duration={sakura.maxDuration}
    data-color={sakura.color}
    data-mobile-off={isMobileOff ? 'true' : 'false'}
  ></div>
)}

<style is:inline>
  .sakura-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    pointer-events: none !important;
    z-index: 9998 !important;
    overflow: hidden !important;
  }
  .sakura-petal {
    position: absolute !important;
    top: -40px;
    pointer-events: none !important;
    will-change: transform, opacity;
  }
  .sakura-petal svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  @keyframes sakuraFall {
    0% {
      opacity: 0;
      transform: translateX(0) translateY(0) rotate(0deg) scale(1);
    }
    8% {
      opacity: 0.9;
    }
    85% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
      transform: translateX(var(--sway-x, 80px)) translateY(var(--fall-height, 100vh)) rotate(var(--rotate-end, 720deg)) scale(0.5);
    }
  }
  @keyframes sakuraSway {
    0%, 100% { margin-left: 0; }
    25% { margin-left: 35px; }
    50% { margin-left: -25px; }
    75% { margin-left: 20px; }
  }
</style>

<script>
  const container = document.getElementById('sakuraContainer');
  if (container) {
    const petals = parseInt(container.dataset.petals || '30');
    const minSize = parseInt(container.dataset.minSize || '12');
    const maxSize = parseInt(container.dataset.maxSize || '26');
    const minDuration = parseInt(container.dataset.minDuration || '5');
    const maxDuration = parseInt(container.dataset.maxDuration || '10');
    const color = container.dataset.color || '#ffb7c5';
    const mobileOff = container.dataset.mobileOff === 'true';

    // 手机端关闭检查
    if (mobileOff && window.innerWidth <= 768) {
      container.style.display = 'none';
    } else {
      function createPetal() {
        const petal = document.createElement('div');
        petal.className = 'sakura-petal';

        const size = minSize + Math.random() * (maxSize - minSize);
        const duration = minDuration + Math.random() * (maxDuration - minDuration);
        // 起始X均匀覆盖整个视口宽度
        const startX = Math.random() * (window.innerWidth + 200) - 100;
        const swayX = (Math.random() - 0.5) * 350;
        const rotateEnd = 360 + Math.random() * 720;
        const delay = Math.random() * maxDuration;

        petal.style.left = startX + 'px';
        petal.style.width = size + 'px';
        petal.style.height = size + 'px';
        petal.style.setProperty('--sway-x', swayX + 'px');
        petal.style.setProperty('--fall-height', (window.innerHeight + 80) + 'px');
        petal.style.setProperty('--rotate-end', rotateEnd + 'deg');
        petal.style.animation = `sakuraFall ${duration}s ease-in-out ${delay}s infinite, sakuraSway ${duration * 0.4}s ease-in-out ${delay}s infinite`;

        const opacity = 0.55 + Math.random() * 0.4;
        petal.style.opacity = String(opacity);

        // 创建花瓣SVG - 更大更清晰的花瓣
        petal.innerHTML = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 1C12 1 14.5 7 19 8.5C19 8.5 14.5 11 14.5 16C14.5 16 12 12.5 9.5 16C9.5 11 5 8.5 5 8.5C9.5 7 12 1 12 1Z" fill="${color}" opacity="0.92"/>
          <path d="M12 4C12 4 13.5 7.5 16 8.5C16 8.5 13.5 10 13.5 13.5C13.5 13.5 12 11 10.5 13.5C10.5 10 8 8.5 8 8.5C10.5 7.5 12 4 12 4Z" fill="${color}" opacity="0.55"/>
        </svg>`;

        container.appendChild(petal);
      }

      // 创建花瓣
      for (let i = 0; i < petals; i++) {
        createPetal();
      }

      // 窗口大小变化时重新计算位置
      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        if (mobileOff && window.innerWidth <= 768) {
          container.style.display = 'none';
        } else {
          container.style.display = '';
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            container.innerHTML = '';
            for (let i = 0; i < petals; i++) {
              createPetal();
            }
          }, 300);
        }
      });

      // 页面不可见时暂停动画
      document.addEventListener('visibilitychange', () => {
        container.style.animationPlayState = document.hidden ? 'paused' : 'running';
        const allPetals = container.querySelectorAll('.sakura-petal');
        allPetals.forEach((p) => {
          (p as HTMLElement).style.animationPlayState = document.hidden ? 'paused' : 'running';
        });
      });
    }
  }
</script>
