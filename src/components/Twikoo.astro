---
/**
 * 评论系统通用组件
 * 支持双评论系统: Twikoo / Giscus
 * 在 config.ts 的 comment 字段中选择启用哪个系统
 *
 * Props:
 *   bare (boolean) - 为 true 时不渲染外层卡片和"评论区"标题
 */
import { siteConfig } from '../../config';

const comment = siteConfig.comment;
const isCommentEnabled = comment?.enable !== false;
const system = comment?.system || 'twikoo';
const bare = Astro.props.bare === true;

const twikooEnvId = comment?.twikoo?.envId || '';
const twikooLang = comment?.twikoo?.lang || 'zh-CN';

const giscusConfig = comment?.giscus || {};
---

{isCommentEnabled && (
  bare ? (
    <div id="commentContainer" data-system={system}></div>
  ) : (
    <div class="comment-card-bg">
      <h3 class="comment-section-title">评论区</h3>
      <div id="commentContainer" data-system={system}></div>
    </div>
  )
)}

{isCommentEnabled && system === 'giscus' && (
  <script define:vars={{ giscusConfig }} is:inline>
    (function() {
      const container = document.getElementById('commentContainer');
      if (!container || container.dataset.system !== 'giscus') return;

      const g = giscusConfig;
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', g.repo || '');
      script.setAttribute('data-repo-id', g.repoId || '');
      script.setAttribute('data-category', g.category || '');
      script.setAttribute('data-category-id', g.categoryId || '');
      script.setAttribute('data-mapping', g.mapping || 'pathname');
      script.setAttribute('data-strict', g.strict || '0');
      script.setAttribute('data-reactions-enabled', g.reactionsEnabled || '1');
      script.setAttribute('data-emit-metadata', g.emitMetadata || '0');
      script.setAttribute('data-input-position', g.inputPosition || 'top');
      script.setAttribute('data-theme', g.theme || 'noborder_light');
      script.setAttribute('data-lang', g.lang || 'zh-CN');
      script.setAttribute('data-loading', g.loading || 'lazy');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;

      container.appendChild(script);

      // 主题色适配：监听主题变化并更新 giscus 主题
      function updateGiscusTheme() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const theme = isDark ? 'noborder_dark' : 'noborder_light';
        const iframe = document.querySelector('iframe.giscus-frame');
        if (iframe) {
          iframe.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
        }
      }

      // 主题切换时更新 giscus
      const observer = new MutationObserver(() => {
        updateGiscusTheme();
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  </script>
)}

{isCommentEnabled && system === 'twikoo' && (
  <script define:vars={{ twikooEnvId, twikooLang }} is:inline>
    (function() {
      const container = document.getElementById('commentContainer');
      if (!container || container.dataset.system !== 'twikoo') return;

      if (!twikooEnvId) {
        container.innerHTML = '<div style="text-align:center;padding:24px 16px;background:var(--primary-alpha);border-radius:var(--radius-sm);border:1px dashed var(--border-color);"><i class="fa-solid fa-comments" style="font-size:1.5rem;color:var(--primary);display:block;margin-bottom:8px;"></i><p style="font-size:0.88rem;color:var(--primary);margin-bottom:4px;">Twikoo 评论系统待配置</p><p style="font-size:0.78rem;color:var(--text-muted);">请在 config.ts 中填写 comment.twikoo.envId 后即可启用</p></div>';
        return;
      }

      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = src;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      function initTwikoo() {
        if (typeof twikoo !== 'undefined') {
          twikoo.init({
            envId: twikooEnvId,
            el: '#commentContainer',
            lang: twikooLang || 'zh-CN',
            path: window.location.pathname,
          }).then(() => {
            console.log('Twikoo 评论系统加载完成');
          }).catch((err) => {
            console.warn('Twikoo 初始化失败:', err);
            container.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:16px;">评论系统初始化失败，请刷新重试</p>';
          });
        } else {
          container.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:16px;">评论系统加载异常，请刷新重试</p>';
        }
      }

      loadScript('https://cdn.jsdelivr.net/npm/twikoo@1.7.9/dist/twikoo.min.js')
        .then(initTwikoo)
        .catch(() => {
          loadScript('https://registry.npmmirror.com/twikoo/1.7.9/files/dist/twikoo.min.js')
            .then(initTwikoo)
            .catch(() => {
              container.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:16px;">评论系统加载失败，请检查网络后刷新重试</p>';
            });
        });
    })();
  </script>
)}

<style>
  .comment-card-bg {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    margin-top: 2rem;
  }

  .comment-section-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
    position: relative;
    padding-left: 16px;
  }

  .comment-section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 60%;
    background: linear-gradient(180deg, var(--primary), var(--primary-light));
    border-radius: 3px;
  }

  /* Twikoo 主题适配 */
  #commentContainer[data-system="twikoo"] :global(.tk-meta) {
    color: var(--text-secondary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-content) {
    color: var(--text-primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-tag) {
    color: var(--primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-action-link) {
    color: var(--primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-submit) {
    background-color: var(--primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-input) {
    background-color: var(--bg-card);
    border-color: var(--border-color);
    color: var(--text-primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-row .tk-col) {
    background-color: var(--bg-card);
    border-color: var(--border-color);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-expand) {
    background-color: var(--bg-card);
    color: var(--primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-time) {
    color: var(--text-muted);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-nick) {
    color: var(--primary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-avatar) {
    border-color: var(--primary-alpha-30);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-comments-count) {
    color: var(--text-secondary);
  }
  #commentContainer[data-system="twikoo"] :global(.tk-main .tk-content p) {
    color: var(--text-primary);
  }

  /* Giscus 适配 */
  #commentContainer[data-system="giscus"] {
    min-height: 200px;
  }
  #commentContainer[data-system="giscus"] :global(.giscus) {
    max-width: 100%;
  }
</style>
