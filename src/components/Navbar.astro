---
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';
const currentPath = Astro.url.pathname;
const colorPickerEnabled = siteConfig.themeColorPicker?.enabled ?? false;
const bgToggleAvailable = siteConfig.background?.enabled ?? false;
const sakuraToggleAvailable = siteConfig.sakura?.enabled ?? false;
const logoType = siteConfig.logo?.type || 'both';
const logoText = siteConfig.logo?.text || siteConfig.title || 'Yuami';
const logoImage = siteConfig.logo?.image || '';

// 构建搜索索引（博文 + 旅记）
const allPots = await getCollection('pots');
const allDiary = await getCollection('diary');
const searchIndex = [
  ...allPots.map(p => ({
    title: p.data.title,
    type: '博文',
    url: `/blog/${p.slug}`,
    tags: (p.data.tags || []).join(' '),
    desc: p.data.description || p.data.excerpt || '',
  })),
  ...allDiary.map(d => ({
    title: d.data.title,
    type: '旅记',
    url: `/travel/${d.slug}`,
    tags: (d.data.tags || []).join(' '),
    desc: d.data.excerpt || '',
  })),
];
---

<nav class="navbar glass" id="navbar">
  <div class="navbar-inner">
    <!-- Logo -->
    <a href="/home" class="navbar-logo" title={logoText}>
      {(logoType === 'image' || logoType === 'both') && logoImage && (
        <img src={logoImage} alt={logoText} class="logo-img" />
      )}
      {(logoType === 'text' || logoType === 'both') && (
        <span class="logo-text">{logoText}</span>
      )}
    </a>

    <!-- Desktop Navigation -->
    <ul class="navbar-menu" id="navMenu">
      {siteConfig.navItems.map((item) => (
        <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
          <a
            href={item.path}
            class={`nav-link ${currentPath === item.path || (item.children && item.children.some(c => currentPath.startsWith(c.path))) ? 'active' : ''}`}
          >
            {item.name}
            {item.children && <i class="fa-solid fa-chevron-down dropdown-arrow"></i>}
          </a>
          {item.children && (
            <ul class="dropdown-menu">
              {item.children.map((child) => (
                <li>
                  <a href={child.path} class={`dropdown-link ${currentPath === child.path ? 'active' : ''}`}>
                    {child.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Right: Search + Color Picker + Theme Toggle + Mobile Menu -->
    <div class="navbar-actions">
      <!-- 全局搜索按钮 -->
      <div class="nav-search-wrapper">
        <button class="nav-search-btn" id="navSearchBtn" title="搜索" aria-label="搜索博客内容">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        <div class="nav-search-panel" id="navSearchPanel">
          <div class="nav-search-input-wrap">
            <i class="fa-solid fa-magnifying-glass nav-search-input-icon"></i>
            <input type="text" id="navSearchInput" class="nav-search-input" placeholder="输入关键字搜索整个博客..." />
            <button class="nav-search-close" id="navSearchClose" aria-label="关闭">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          <div class="nav-search-results" id="navSearchResults"></div>
          <div class="nav-search-hint" id="navSearchHint">
            <i class="fa-solid fa-circle-info"></i>
            <span>输入关键字后，将跳转到博文或旅记页面进行筛选</span>
          </div>
        </div>
      </div>
      {colorPickerEnabled && (
        <div class="color-picker-wrapper">
          <button class="color-picker-btn" id="colorPickerBtn" title="切换主题色" aria-label="切换主题色">
            <i class="fa-solid fa-palette"></i>
          </button>
          <div class="color-picker-panel" id="colorPickerPanel">
            <div class="picker-section-label">色轮选择</div>
            <div class="color-bar" id="colorBar">
              <div class="color-bar-gradient"></div>
              <div class="color-bar-thumb" id="colorBarThumb"></div>
            </div>
            <div class="color-picker-presets">
              <button class="color-preset" data-color="#7D98F5" style="background:#7D98F5;" title="默认蓝"></button>
              <button class="color-preset" data-color="#F5767D" style="background:#F5767D;" title="樱粉"></button>
              <button class="color-preset" data-color="#76F5A0" style="background:#76F5A0;" title="薄荷"></button>
              <button class="color-preset" data-color="#F5C876" style="background:#F5C876;" title="琥珀"></button>
              <button class="color-preset" data-color="#C076F5" style="background:#C076F5;" title="紫罗兰"></button>
              <button class="color-preset" data-color="#76D4F5" style="background:#76D4F5;" title="天蓝"></button>
              <button class="color-preset" data-color="#F576D4" style="background:#F576D4;" title="桃红"></button>
              <button class="color-preset" data-color="#A0F576" style="background:#A0F576;" title="青柠"></button>
            </div>
            {bgToggleAvailable && (
              <>
                <hr class="picker-divider" />
                <div class="picker-section-label">全局背景</div>
                <div class="picker-toggle-row">
                  <span class="picker-toggle-text">选择开启全局背景</span>
                  <label class="picker-toggle">
                    <input type="checkbox" id="bgToggle" class="toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </>
            )}
            {sakuraToggleAvailable && (
              <>
                <hr class="picker-divider" />
                <div class="picker-section-label">樱花特效</div>
                <div class="picker-toggle-row">
                  <span class="picker-toggle-text">选择开启樱花特效</span>
                  <label class="picker-toggle">
                    <input type="checkbox" id="sakuraToggle" class="toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </>
            )}
          </div>
        </div>
      )}
      <button class="theme-toggle" id="themeToggle" title="切换主题" aria-label="切换明暗主题">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>
      <button class="mobile-toggle" id="mobileToggle" aria-label="打开菜单" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
<div class="mobile-menu" id="mobileMenu">
  <ul class="mobile-menu-list">
    {siteConfig.navItems.map((item, idx) => (
      <li class="mobile-nav-group">
        {item.children ? (
          <button class="mobile-parent-btn" type="button" data-expanded="false" data-group={idx}>
            <span>{item.name}</span>
            <i class="fa-solid fa-chevron-down mobile-expand-icon"></i>
          </button>
        ) : (
          <a href={item.path} class="mobile-simple-link">{item.name}</a>
        )}
        {item.children && (
          <ul class="mobile-sub-list" data-sub={idx}>
            {item.children.map((child) => (
              <li>
                <a href={child.path} class="mobile-sub-link">{child.name}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</div>

<!-- 注入搜索索引 -->
<script define:vars={{ searchIndex }}>
  window.__yuami_search_index = searchIndex;
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 1000;
    transition: transform 0.35s ease;
  }

  /* Nav自动隐藏/展开 */
  .navbar.nav-hidden {
    transform: translateY(-100%);
  }

  .navbar.nav-visible {
    transform: translateY(0);
  }

  .navbar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .logo-img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }

  .logo-text {
    font-size: 1.3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .navbar-menu {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .dropdown-arrow {
    font-size: 0.6rem;
    transition: transform var(--transition-fast);
  }

  .nav-item:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 110px;
    padding: 4px;
    background: var(--bg-glass);
    border: 1px solid var(--bg-glass-border);
    border-radius: var(--radius-sm);
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-fast);
  }

  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 8px 14px;
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.92rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .dropdown-link:hover,
  .dropdown-link.active {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* 全局搜索 */
  .nav-search-wrapper {
    position: relative;
  }

  .nav-search-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 1rem;
  }

  .nav-search-btn:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .nav-search-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 360px;
    background: var(--bg-glass);
    border: 1px solid var(--bg-glass-border);
    border-radius: var(--radius-md);
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 0.25s ease;
    z-index: 1001;
  }

  .nav-search-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-search-input-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
    pointer-events: none;
  }

  .nav-search-input {
    width: 100%;
    padding: 10px 36px 10px 34px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.92rem;
    font-family: inherit;
    outline: none;
    transition: all var(--transition-fast);
  }

  .nav-search-input:focus {
    border-color: var(--primary);
  }

  .nav-search-input::placeholder {
    color: var(--text-muted);
  }

  .nav-search-close {
    position: absolute;
    right: 8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    cursor: pointer;
    background: none;
    border: none;
    font-size: 0.85rem;
    transition: all var(--transition-fast);
  }

  .nav-search-close:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .nav-search-results {
    margin-top: 12px;
    max-height: 320px;
    overflow-y: auto;
  }

  .nav-search-result-item {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    text-decoration: none;
    transition: all var(--transition-fast);
    margin-bottom: 6px;
    border: 1px solid var(--border-color);
  }

  .nav-search-result-item:hover {
    background: var(--primary-alpha);
    border-color: var(--primary);
  }

  .nav-search-result-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .nav-search-result-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-search-result-type {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 8px;
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.7rem;
  }

  .nav-search-hint {
    margin-top: 12px;
    padding: 8px 12px;
    background: var(--primary-alpha);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-search-hint i {
    color: var(--primary);
    font-size: 0.78rem;
  }

  .nav-search-empty {
    text-align: center;
    padding: 24px 12px;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 1rem;
  }

  .theme-toggle:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  /* Color Picker */
  .color-picker-wrapper {
    position: relative;
  }

  .color-picker-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 1rem;
  }

  .color-picker-btn:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .color-picker-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 240px;
    background: var(--bg-glass);
    border: 1px solid var(--bg-glass-border);
    border-radius: var(--radius-md);
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 0.25s ease;
    z-index: 1001;
    max-height: 80vh;
    overflow-y: auto;
  }

  .color-picker-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .color-bar {
    position: relative;
    height: 20px;
    border-radius: 10px;
    margin-bottom: 14px;
    cursor: pointer;
  }

  .color-bar-gradient {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: linear-gradient(to right,
      #ff0000, #ff8800, #ffff00, #88ff00, #00ff00,
      #00ff88, #00ffff, #0088ff, #0000ff, #8800ff,
      #ff00ff, #ff0088, #ff0000
    );
  }

  .color-bar-thumb {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid #fff;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: left 0.1s ease;
  }

  .color-picker-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .color-preset {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .color-preset:hover {
    transform: scale(1.2);
    border-color: var(--text-secondary);
  }

  .color-preset.active {
    border-color: var(--text-primary);
    transform: scale(1.15);
  }

  /* 色轮面板分区标签 */
  .picker-section-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }

  /* 分割线 */
  .picker-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 12px 0;
  }

  /* 开关行 */
  .picker-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }

  .picker-toggle-text {
    font-size: 0.78rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* 滑动开关 */
  .picker-toggle {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
    flex-shrink: 0;
  }

  .toggle-input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--text-muted);
    border-radius: 20px;
    transition: 0.3s;
  }

  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    left: 2px;
    bottom: 2px;
    background: white;
    border-radius: 50%;
    transition: 0.3s;
  }

  .toggle-input:checked + .toggle-slider {
    background: var(--primary);
  }

  .toggle-input:checked + .toggle-slider::before {
    transform: translateX(16px);
  }

  /* 汉堡按钮 */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    cursor: pointer;
    position: relative;
    z-index: 1001;
  }

  .mobile-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* ===== Mobile Overlay ===== */
  .mobile-menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1001;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  /* ===== Mobile Menu ===== */
  .mobile-menu {
    display: none;
    position: fixed;
    top: var(--nav-height);
    right: 0;
    width: 240px;
    max-width: 80vw;
    background: var(--bg-card);
    border-radius: 0 0 0 var(--radius-md);
    border-left: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    z-index: 1002;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    max-height: calc(100vh - var(--nav-height));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 8px;
    margin: 0;
  }

  .mobile-nav-group {
    display: block;
  }

  .mobile-parent-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
    background: none;
    text-align: left;
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-parent-btn:active {
    background: var(--primary-alpha);
  }

  .mobile-parent-btn span {
    flex: 1;
  }

  .mobile-expand-icon {
    font-size: 0.65rem;
    color: var(--text-muted);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .mobile-parent-btn[data-expanded="true"] .mobile-expand-icon {
    transform: rotate(180deg);
    color: var(--primary);
  }

  .mobile-parent-btn[data-expanded="true"] {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .mobile-simple-link {
    display: block;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-simple-link:active {
    background: var(--primary-alpha);
  }

  .mobile-sub-list {
    padding: 0;
    margin: 0 0 0 14px;
    border-left: 2px solid var(--primary-alpha);
    list-style: none;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease;
  }

  .mobile-sub-list.expanded {
    opacity: 1;
    padding: 4px 0;
  }

  .mobile-sub-link {
    display: block;
    padding: 10px 14px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 400;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-sub-link:active {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  /* ===== Mobile Responsive ===== */
  @media (max-width: 768px) {
    .navbar-menu {
      display: none !important;
    }
    .mobile-toggle {
      display: flex !important;
    }
    .mobile-menu-overlay {
      display: block;
    }
    .mobile-menu {
      display: block;
    }
    .navbar-inner {
      padding: 0 14px;
    }
    .color-picker-panel {
      right: -60px;
      width: 220px;
    }
    .nav-search-panel {
      right: -80px;
      width: 300px;
    }
  }
</style>

<script>
  // ===== View Transitions 兼容：使用 astro:page-load 在每次导航后重新初始化 =====
  // AbortController 用于清理旧的 window/document 事件监听器
  let navAbortController = new AbortController();
  let colorDragAbortController = new AbortController();

  // HSL转Hex
  function hslToHex(h: number, s: number, l: number): string {
    s /= 100; l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
      return Math.round(255 * color).toString(16).padStart(2, '0');
    };
    return `#${f(0)}${f(8)}${f(4)}`;
  }

  // Hex转HSL
  function hexToHsl(hex: string): { h: number; s: number; l: number } {
    hex = hex.replace('#', '');
    const r = parseInt(hex.substring(0, 2), 16) / 255;
    const g = parseInt(hex.substring(2, 4), 16) / 255;
    const b = parseInt(hex.substring(4, 6), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0;
    const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = ((g - b) / d + (g < b ? 6 : 0)) * 60; break;
        case g: h = ((b - r) / d + 2) * 60; break;
        case b: h = ((r - g) / d + 4) * 60; break;
      }
    }
    return { h: Math.round(h), s: Math.round(s * 100), l: Math.round(l * 100) };
  }

  function lighten(hex: string, amount: number): string {
    const hsl = hexToHsl(hex);
    return hslToHex(hsl.h, Math.max(hsl.s - 5, 30), Math.min(hsl.l + amount, 85));
  }
  function darken(hex: string, amount: number): string {
    const hsl = hexToHsl(hex);
    return hslToHex(hsl.h, Math.min(hsl.s + 5, 100), Math.max(hsl.l - amount, 20));
  }

  function applyThemeColor(hex: string) {
    const root = document.documentElement;
    root.style.setProperty('--primary', hex);
    root.style.setProperty('--primary-light', lighten(hex, 15));
    root.style.setProperty('--primary-dark', darken(hex, 15));
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    root.style.setProperty('--primary-alpha', `rgba(${r}, ${g}, ${b}, 0.15)`);
    root.style.setProperty('--primary-alpha-30', `rgba(${r}, ${g}, ${b}, 0.3)`);
    root.style.setProperty('--shadow-sm', `0 2px 8px rgba(${r}, ${g}, ${b}, 0.08)`);
    root.style.setProperty('--shadow-md', `0 4px 20px rgba(${r}, ${g}, ${b}, 0.12)`);
    root.style.setProperty('--shadow-lg', `0 8px 40px rgba(${r}, ${g}, ${b}, 0.16)`);
    root.style.setProperty('--shadow-hover', `0 8px 30px rgba(${r}, ${g}, ${b}, 0.2)`);
    root.style.setProperty('--border-color', `rgba(${r}, ${g}, ${b}, 0.15)`);
    localStorage.setItem('yuami_theme_color', hex);
    const colorBarThumb = document.getElementById('colorBarThumb');
    if (colorBarThumb) {
      const hsl = hexToHsl(hex);
      const pct = (hsl.h / 360) * 100;
      colorBarThumb.style.left = pct + '%';
      colorBarThumb.style.background = hex;
    }
    document.querySelectorAll('.color-preset').forEach(btn => {
      const el = btn as HTMLElement;
      el.classList.toggle('active', el.dataset.color === hex);
    });
  }

  function initNavbar() {
    // 清理旧的 window/document 监听器
    navAbortController.abort();
    navAbortController = new AbortController();
    colorDragAbortController.abort();
    colorDragAbortController = new AbortController();
    const navSignal = navAbortController.signal;
    const colorSignal = colorDragAbortController.signal;

    // ===== Theme toggle =====
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');

    function updateThemeIcon() {
      const current = document.documentElement.getAttribute('data-theme');
      if (themeIcon) {
        themeIcon.className = current === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }
    }
    updateThemeIcon();

    themeToggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeIcon();
    });

    // ===== Navbar auto-hide/show on scroll =====
    const navbar = document.getElementById('navbar');
    let lastScrollY = window.scrollY;
    let ticking = false;
    let isHoveringNav = false;

    if (navbar) {
      navbar.addEventListener('mouseenter', () => { isHoveringNav = true; });
      navbar.addEventListener('mouseleave', () => { isHoveringNav = false; });

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const currentScrollY = window.scrollY;
            if (isHoveringNav) {
              navbar.classList.remove('nav-hidden');
              navbar.classList.add('nav-visible');
            } else if (currentScrollY <= 80) {
              navbar.classList.remove('nav-hidden');
              navbar.classList.add('nav-visible');
              navbar.style.boxShadow = 'none';
            } else if (currentScrollY > lastScrollY && currentScrollY > 200) {
              navbar.classList.add('nav-hidden');
              navbar.classList.remove('nav-visible');
            } else {
              navbar.classList.remove('nav-hidden');
              navbar.classList.add('nav-visible');
              navbar.style.boxShadow = 'var(--shadow-md)';
            }
            lastScrollY = currentScrollY;
            ticking = false;
          });
          ticking = true;
        }
      }, { signal: navSignal });
    }

    // ===== Mobile Menu =====
    const mobileToggle = document.getElementById('mobileToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileOverlay = document.getElementById('mobileMenuOverlay');

    function openMenu() {
      mobileToggle?.classList.add('active');
      mobileMenu?.classList.add('active');
      mobileOverlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileToggle?.classList.remove('active');
      mobileMenu?.classList.remove('active');
      mobileOverlay?.classList.remove('active');
      document.body.style.overflow = '';
    }

    mobileToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (mobileMenu?.classList.contains('active')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileOverlay?.addEventListener('click', () => {
      closeMenu();
    });

    document.querySelectorAll('.mobile-sub-link, .mobile-simple-link').forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // ===== 手风琴子菜单 =====
    document.querySelectorAll('.mobile-parent-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = btn.getAttribute('data-expanded') === 'true';
        const groupIdx = btn.getAttribute('data-group');
        const subList = document.querySelector(`.mobile-sub-list[data-sub="${groupIdx}"]`) as HTMLElement;

        document.querySelectorAll('.mobile-parent-btn').forEach(otherBtn => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('data-expanded', 'false');
            const otherIdx = otherBtn.getAttribute('data-group');
            const otherSub = document.querySelector(`.mobile-sub-list[data-sub="${otherIdx}"]`) as HTMLElement;
            if (otherSub) {
              otherSub.style.maxHeight = '0';
              otherSub.classList.remove('expanded');
            }
          }
        });

        if (expanded) {
          btn.setAttribute('data-expanded', 'false');
          if (subList) {
            subList.style.maxHeight = '0';
            subList.classList.remove('expanded');
          }
        } else {
          btn.setAttribute('data-expanded', 'true');
          if (subList) {
            subList.style.maxHeight = subList.scrollHeight + 'px';
            subList.classList.add('expanded');
          }
        }
      });
    });

    // ===== Color Picker (主题色切换) =====
    const colorPickerBtn = document.getElementById('colorPickerBtn');
    const colorPickerPanel = document.getElementById('colorPickerPanel');
    const colorBar = document.getElementById('colorBar');

    // 初始化已记忆的主题色
    const savedColor = localStorage.getItem('yuami_theme_color');
    if (savedColor) {
      applyThemeColor(savedColor);
    }

    colorPickerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      colorPickerPanel?.classList.toggle('active');
    });

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.color-picker-wrapper')) {
        colorPickerPanel?.classList.remove('active');
      }
    }, { signal: navSignal });

    document.querySelectorAll('.color-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const color = (e.currentTarget as HTMLElement).dataset.color;
        if (color) applyThemeColor(color);
      });
    });

    // 颜色条拖拽/点击选择
    if (colorBar) {
      let isDragging = false;

      function pickColorFromBar(e: MouseEvent | TouchEvent) {
        const rect = colorBar!.getBoundingClientRect();
        let clientX: number;
        if ('touches' in e) {
          clientX = e.touches[0].clientX;
        } else {
          clientX = e.clientX;
        }
        let pct = (clientX - rect.left) / rect.width;
        pct = Math.max(0, Math.min(1, pct));
        const hue = Math.round(pct * 360);
        const hex = hslToHex(hue, 65, 70);
        applyThemeColor(hex);
      }

      colorBar.addEventListener('mousedown', (e) => {
        isDragging = true;
        pickColorFromBar(e);
      });

      colorBar.addEventListener('touchstart', (e) => {
        isDragging = true;
        pickColorFromBar(e);
      }, { passive: true });

      document.addEventListener('mousemove', (e) => {
        if (isDragging) pickColorFromBar(e);
      }, { signal: colorSignal });

      document.addEventListener('touchmove', (e) => {
        if (isDragging) pickColorFromBar(e);
      }, { passive: true, signal: colorSignal });

      document.addEventListener('mouseup', () => { isDragging = false; }, { signal: colorSignal });
      document.addEventListener('touchend', () => { isDragging = false; }, { signal: colorSignal });
    }

    // ===== 全局背景开关 =====
    const bgToggle = document.getElementById('bgToggle') as HTMLInputElement | null;
    const siteBackground = document.getElementById('siteBackground');
    if (bgToggle && siteBackground) {
      const bgPref = localStorage.getItem('yuami_bg_enabled');
      const isBgOn = bgPref !== 'false'; // 默认开启
      bgToggle.checked = isBgOn;
      if (!isBgOn) {
        siteBackground.classList.add('disabled');
        document.documentElement.classList.add('bg-user-off');
      }

      bgToggle.addEventListener('change', () => {
        if (bgToggle.checked) {
          siteBackground.classList.remove('disabled');
          document.documentElement.classList.remove('bg-user-off');
          localStorage.setItem('yuami_bg_enabled', 'true');
        } else {
          siteBackground.classList.add('disabled');
          document.documentElement.classList.add('bg-user-off');
          localStorage.setItem('yuami_bg_enabled', 'false');
        }
      });
    }

    // ===== 樱花特效开关 =====
    const sakuraToggle = document.getElementById('sakuraToggle') as HTMLInputElement | null;
    const sakuraContainer = document.getElementById('sakuraContainer');
    if (sakuraToggle && sakuraContainer) {
      const sakuraPref = localStorage.getItem('yuami_sakura_enabled');
      const isSakuraOn = sakuraPref !== 'false'; // 默认开启
      sakuraToggle.checked = isSakuraOn;
      if (!isSakuraOn) {
        sakuraContainer.style.display = 'none';
        document.documentElement.classList.add('sakura-user-off');
      }

      sakuraToggle.addEventListener('change', () => {
        if (sakuraToggle.checked) {
          sakuraContainer.style.display = '';
          document.documentElement.classList.remove('sakura-user-off');
          localStorage.setItem('yuami_sakura_enabled', 'true');
          // 重新触发樱花创建
          window.dispatchEvent(new Event('resize'));
        } else {
          sakuraContainer.style.display = 'none';
          document.documentElement.classList.add('sakura-user-off');
          localStorage.setItem('yuami_sakura_enabled', 'false');
        }
      });
    }

    // ===== 全局搜索 =====
    const navSearchBtn = document.getElementById('navSearchBtn');
    const navSearchPanel = document.getElementById('navSearchPanel');
    const navSearchInput = document.getElementById('navSearchInput') as HTMLInputElement | null;
    const navSearchClose = document.getElementById('navSearchClose');
    const navSearchResults = document.getElementById('navSearchResults');
    const navSearchHint = document.getElementById('navSearchHint');

    navSearchBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      navSearchPanel?.classList.toggle('active');
      if (navSearchPanel?.classList.contains('active')) {
        setTimeout(() => navSearchInput?.focus(), 100);
      }
    });

    navSearchClose?.addEventListener('click', () => {
      navSearchPanel?.classList.remove('active');
      if (navSearchInput) navSearchInput.value = '';
      if (navSearchResults) navSearchResults.innerHTML = '';
      if (navSearchHint) navSearchHint.style.display = '';
    });

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.nav-search-wrapper')) {
        navSearchPanel?.classList.remove('active');
      }
    }, { signal: navSignal });

    // 搜索输入
    navSearchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      if (navSearchHint) navSearchHint.style.display = query ? 'none' : '';
      if (!navSearchResults) return;
      if (!query) {
        navSearchResults.innerHTML = '';
        return;
      }

      const index = (window as any).__yuami_search_index || [];
      const matches = index.filter((item: { title: string; tags: string; desc: string; type: string; url: string }) => {
        const titleMatch = item.title.toLowerCase().includes(query);
        const tagMatch = item.tags.toLowerCase().includes(query);
        const descMatch = item.desc.toLowerCase().includes(query);
        return titleMatch || tagMatch || descMatch;
      }).slice(0, 10);

      if (matches.length === 0) {
        navSearchResults.innerHTML = '<div class="nav-search-empty">未找到相关内容</div>';
        return;
      }

      navSearchResults.innerHTML = matches.map((item: { url: string; title: string; type: string; desc: string }) => `
        <a href="${item.url}" class="nav-search-result-item">
          <div class="nav-search-result-title">${item.title}</div>
          <div class="nav-search-result-meta">
            <span class="nav-search-result-type">${item.type}</span>
            <span>${item.desc.substring(0, 40)}${item.desc.length > 40 ? '...' : ''}</span>
          </div>
        </a>
      `).join('');
    });

    // 回车跳转到博文页面并触发全局搜索
    navSearchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = (e.target as HTMLInputElement).value.trim();
        if (!query) return;
        // 保存查询到全局变量，跳转到博文页面
        (window as any).__yuami_global_search = query;
        navSearchPanel?.classList.remove('active');
        // 跳转到博文页面
        window.location.href = '/blog';
      }
    });
  }

  // 初始化 + View Transitions 导航后重新初始化
  document.addEventListener('astro:page-load', initNavbar);
</script>
