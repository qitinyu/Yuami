---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftSidebar from '../../components/LeftSidebar.astro';
import Twikoo from '../../components/Twikoo.astro';
import Encryptor from '../../components/Encryptor.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../config';
import { formatDate, formatDateShort } from '../../utils/dateFormat';

export async function getStaticPaths() {
  const pots = await getCollection('pots');
  // 置顶文章优先排序，同级别按日期倒序
  const sortedPots = [...pots].sort((a, b) => {
    const pinnedA = a.data.pinned === true;
    const pinnedB = b.data.pinned === true;
    if (pinnedA && !pinnedB) return -1;
    if (!pinnedA && pinnedB) return 1;
    const dateA = a.data.published || a.data.date || '';
    const dateB = b.data.published || b.data.date || '';
    return dateB.localeCompare(dateA);
  });
  return sortedPots.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index > 0 ? sortedPots[index - 1] : null,
      nextPost: index < sortedPots.length - 1 ? sortedPots[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
const title = post.data.title;
const publishedRaw = post.data.published || post.data.date || '';
const publishedFormatted = formatDate(publishedRaw);
const tags = post.data.tags || [];
const description = post.data.description || post.data.excerpt || '';
const author = post.data.author || '';
const licenseName = post.data.licenseName || '';
const image = post.data.image || post.data.cover || '';
const isEncrypted = !!(post.data.encrypted && post.data.password);
const password = post.data.password || '';
const isPinned = post.data.pinned === true;

// 随机推荐2篇文章（排除当前文章）
const allPots = await getCollection('pots');
const allDiary = await getCollection('diary');
const otherPots = allPots.filter(p => p.slug !== post.slug);
const shuffled = otherPots.sort(() => Math.random() - 0.5);
const recommendPosts = shuffled.slice(0, 2);

// 构建时计算站点统计（传给 SidebarWidget，使用完整日期字符串）
const totalPostsStat = allPots.length + allDiary.length;
let totalWordsStat = 0;
allPots.forEach(p => { totalWordsStat += (p.body || '').replace(/\s/g, '').length; });
allDiary.forEach(d => { totalWordsStat += (d.body || '').replace(/\s/g, '').length; });
const allDates = [
  ...allPots.map(p => p.data.published || p.data.date || ''),
  ...allDiary.map(d => d.data.date || ''),
].filter(Boolean).sort().reverse();
const lastEditStat = allDates[0] ? formatDateShort(allDates[0]) : '';
---

<BaseLayout title={title}>
  <div class="article-layout">
    <!-- Center: Article Main Content (DOM first for mobile order) -->
    <article class="article-main">
      <header class="article-header">
        {isEncrypted && (
          <div class="encrypted-badge">
            <i class="fa-solid fa-lock"></i> 加密文章
          </div>
        )}
        {isPinned && (
          <span class="pinned-badge"><i class="fa-solid fa-thumbtack"></i> 置顶</span>
        )}
        <h1 class="article-title">{title}</h1>
        <div class="article-meta">
          <span class="article-date"><i class="fa-regular fa-calendar"></i> {publishedFormatted}</span>
          {author && <span class="article-author"><i class="fa-solid fa-user-pen"></i> {author}</span>}
          <div class="article-tags">
            {tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        </div>
        {description && <p class="article-description">{description}</p>}
      </header>

      {image && (
        <div class="article-cover">
          <img src={image} alt={title} onerror="this.style.display='none';" />
        </div>
      )}

      <div class="article-content prose" id="articleContent">
        {isEncrypted ? (
          <Encryptor password={password}>
            <Content />
          </Encryptor>
        ) : (
          <Content />
        )}
      </div>

      {licenseName && (
        <div class="article-license" id="licenseSection">
          <i class="fa-solid fa-scale-balanced"></i>
          <span>本文采用 {licenseName} 协议发布</span>
        </div>
      )}

      <div class="article-share">
        <button class="btn btn-ghost" id="shareBtn" title="复制链接">
          <i class="fa-solid fa-link"></i> 复制链接
        </button>
      </div>

      <div class="article-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> {prevPost.data.title}</a>
        ) : (
          <span class="btn btn-ghost" style="opacity:0.4;cursor:default;">已是最新一篇</span>
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="btn btn-ghost">{nextPost.data.title} <i class="fa-solid fa-arrow-right"></i></a>
        ) : (
          <span class="btn btn-ghost" style="opacity:0.4;cursor:default;">已是最后一篇</span>
        )}
      </div>

      {recommendPosts.length > 0 && (
        <div class="article-recommend">
          <h3 class="section-title">随机推荐</h3>
          <div class="recommend-grid">
            {recommendPosts.map(rp => (
              <a href={`/blog/${rp.slug}`} class="recommend-card card" style="text-decoration:none;">
                <div class="recommend-body">
                  <h4>{rp.data.title}</h4>
                  <p>{rp.data.description || rp.data.excerpt || rp.data.tags?.join(', ') || '点击阅读'}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {siteConfig.comment?.enable !== false && (
      <div class="comment-area">
        <h3 class="section-title">评论区</h3>
        <Twikoo bare />
      </div>
      )}
    </article>

    <!-- Left Sidebar: 3 Plugins (DOM second, CSS order: -1 on desktop to move left; mobile: natural order after article) -->
    <aside class="article-sidebar">
      <LeftSidebar
        totalPosts={totalPostsStat}
        totalWords={totalWordsStat}
        lastEdit={lastEditStat}
      />
    </aside>

    <!-- Right Sidebar: TOC (Table of Contents) -->
    <aside class="article-toc-sidebar" id="articleTocSidebar">
      <div class="toc-panel" id="tocPanel">
        <div class="toc-header">
          <i class="fa-solid fa-list"></i><span>目录</span>
          <button class="toc-collapse-btn" id="tocCollapseBtn" aria-label="折叠目录">
            <i class="fa-solid fa-chevron-up"></i>
          </button>
        </div>
        <div class="toc-body" id="tocBody">
          <nav class="toc-nav" id="tocNav"></nav>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .article-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
  }

  /* --- Article Main Content (DOM first) --- */
  .article-main {
    flex: 1;
    min-width: 0;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    padding: 32px 36px;
    box-shadow: var(--shadow-sm);
    /* On desktop, center between two sidebars */
    order: 1;
  }

  /* --- Left Sidebar (3 plugins, DOM second, CSS order moves it left on desktop) --- */
  .article-sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    order: 0; /* Desktop: left of article */
    position: sticky;
    top: calc(var(--nav-height) + 16px);
    height: fit-content;
  }

  /* --- Right Sidebar: TOC --- */
  .article-toc-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-height) + 16px);
    height: fit-content;
    max-height: calc(100vh - var(--nav-height) - 32px);
    overflow-y: auto;
    order: 2;
  }

  .toc-panel {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    width: 100%;
    transition: all var(--transition-normal);
  }

  .toc-panel:hover {
    box-shadow: var(--shadow-hover);
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
  }

  .toc-header i { font-size: 0.85rem; }

  /* TOC collapse button */
  .toc-collapse-btn {
    margin-left: auto;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .toc-collapse-btn:hover {
    background: var(--primary-alpha);
  }

  .toc-collapse-btn.collapsed i {
    transform: rotate(180deg);
  }

  .toc-body {
    padding: 8px 0;
    transition: all var(--transition-fast);
    overflow: hidden;
  }

  .toc-body.collapsed {
    max-height: 0 !important;
    padding: 0;
  }

  .toc-nav {
    width: 100%;
  }

  /* ===== TOC 层级样式 ===== */

  /* # (h1) - 顶格，不缩进 */
  .toc-nav .toc-h1 {
    margin-bottom: 2px;
  }

  .toc-nav .toc-h1-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .toc-nav .toc-h1-link:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .toc-nav .toc-h1-link.active {
    color: #fff;
    background: var(--primary);
    font-weight: 700;
  }

  .toc-nav .toc-h1-link .toc-arrow {
    font-size: 0.6rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .toc-nav .toc-h1-link.active .toc-arrow {
    color: #fff;
  }

  .toc-nav .toc-h1-link.expanded .toc-arrow {
    transform: rotate(90deg);
  }

  /* ## (h2) - 缩进 2em */
  .toc-nav .toc-h2-list {
    padding-left: 2em;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }

  .toc-nav .toc-h2-list.expanded {
    max-height: 3000px;
  }

  .toc-nav .toc-h2-item {
    margin-bottom: 1px;
  }

  .toc-nav .toc-h2-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .toc-nav .toc-h2-link:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .toc-nav .toc-h2-link.active {
    color: #fff;
    background: var(--primary);
    font-weight: 600;
  }

  .toc-nav .toc-h2-link .toc-arrow {
    font-size: 0.55rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .toc-nav .toc-h2-link.active .toc-arrow {
    color: #fff;
  }

  .toc-nav .toc-h2-link.expanded .toc-arrow {
    transform: rotate(90deg);
  }

  /* ### (h3) - 缩进 4em，每个独占一行 */
  .toc-nav .toc-h3-list {
    padding-left: 2em;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }

  .toc-nav .toc-h3-list.expanded {
    max-height: 2000px;
  }

  /* 每个 h3 链接独占一行，分行显示 */
  .toc-nav .toc-h3-item {
    display: block;
    margin-bottom: 1px;
  }

  .toc-nav .toc-h3-link {
    display: block;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.82rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-nav .toc-h3-link:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .toc-nav .toc-h3-link.active {
    color: #fff;
    background: var(--primary);
    font-weight: 600;
  }

  /* #### (h4) - 最深层缩进 */
  .toc-nav .toc-h4-list {
    padding-left: 2em;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }

  .toc-nav .toc-h4-list.expanded {
    max-height: 1500px;
  }

  .toc-nav .toc-h4-item {
    display: block;
    margin-bottom: 1px;
  }

  .toc-nav .toc-h4-link {
    display: block;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.85;
  }

  .toc-nav .toc-h4-link:hover {
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .toc-nav .toc-h4-link.active {
    color: #fff;
    background: var(--primary);
    font-weight: 600;
    opacity: 1;
  }

  /* --- Article Header & Content --- */
  .article-header {
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-color);
  }

  .encrypted-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    background: var(--primary-alpha);
    color: var(--primary);
    margin-bottom: 10px;
  }

  .article-title {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .article-date { font-size: 0.95rem; color: var(--text-muted); }
  .article-author { font-size: 0.95rem; color: var(--text-muted); }
  .article-author i { color: var(--primary); margin-right: 4px; }
  .article-tags { display: flex; gap: 8px; }

  .article-description {
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    font-style: italic;
  }

  .article-cover {
    margin-bottom: 20px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .article-license {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.85rem;
    margin-bottom: 20px;
  }

  .article-content { margin-bottom: 28px; }
  .article-share { margin-bottom: 28px; display: flex; gap: 8px; }

  .article-nav {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 28px;
  }

  .article-recommend { margin-bottom: 28px; }

  .recommend-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .recommend-card { padding: 16px; cursor: pointer; transition: all var(--transition-fast); }
  .recommend-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .recommend-body h4 { font-size: 0.98rem; color: var(--text-primary); margin-bottom: 4px; transition: color var(--transition-fast); }
  .recommend-card:hover .recommend-body h4 { color: var(--primary); }
  .recommend-body p { font-size: 0.85rem; color: var(--text-muted); }

  /* 评论区区域 */
  .comment-area {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .comment-area .section-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
    position: relative;
    padding-left: 16px;
  }

  .comment-area .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 60%;
    background: linear-gradient(180deg, var(--primary), var(--primary-light));
    border-radius: 3px;
  }

  /* 复制成功提示 */
  .share-toast {
    position: fixed;
    top: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(-20px);
    background: var(--primary);
    color: #fff;
    padding: 8px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    box-shadow: 0 4px 12px rgba(125, 152, 245, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 9999;
  }

  .share-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* --- Tablet (≤1200px) - 隐藏右侧目录 --- */
  @media (max-width: 1200px) {
    .article-toc-sidebar {
      display: none;
    }
  }

  /* --- Tablet/Mobile (≤1024px) - 单列布局，文章在上，插件在下 --- */
  @media (max-width: 1024px) {
    .article-layout {
      flex-direction: column;
    }
    .article-main {
      order: 0; /* 文章在前 */
    }
    .article-sidebar {
      order: 1; /* 插件在后 */
      position: static;
      width: 100%;
    }
    .article-sidebar :global(.left-sidebar) {
      position: static;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .article-sidebar :global(.sidebar-panel) {
      flex: 1;
      min-width: 260px;
    }
  }

  /* --- Mobile (≤768px) --- */
  @media (max-width: 768px) {
    .article-layout {
      padding: 20px 14px;
    }
    .article-main {
      padding: 22px 16px;
    }
    .article-title {
      font-size: 1.4rem;
    }
    .article-sidebar :global(.left-sidebar) {
      flex-direction: column;
    }
    .article-sidebar :global(.sidebar-panel) {
      min-width: auto;
    }
    .recommend-grid {
      grid-template-columns: 1fr;
    }
    .article-nav {
      flex-direction: column;
      gap: 10px;
      align-items: center;
      text-align: center;
    }
  }
</style>

<script>
  let tocAbortController = new AbortController();

  document.addEventListener('astro:page-load', () => {
    const articleContent = document.getElementById('articleContent');
    if (!articleContent) return;

    tocAbortController.abort();
    tocAbortController = new AbortController();
    const tocSignal = tocAbortController.signal;

    // Share - 直接复制链接到剪贴板
    const shareBtn = document.getElementById('shareBtn');
    shareBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        let toast = document.querySelector('.share-toast') as HTMLElement;
        if (!toast) {
          toast = document.createElement('div');
          toast.className = 'share-toast';
          toast.textContent = '链接已复制到剪贴板';
          document.body.appendChild(toast);
        }
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 2000);
      } catch {
        const textArea = document.createElement('textarea');
        textArea.value = window.location.href;
        textArea.style.position = 'fixed';
        textArea.style.left = '-9999px';
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        alert('链接已复制到剪贴板！');
      }
    });

    // ====== TOC (Table of Contents) Generator ======
    // 使用 MutationObserver 确保加密文章解锁后也能正确生成 TOC
    function buildTOC() {
      const tocNav = document.getElementById('tocNav');
      const tocSidebar = document.getElementById('articleTocSidebar');

      if (!articleContent || !tocNav) {
        if (tocSidebar) tocSidebar.style.display = 'none';
        return;
      }

      // 查找所有 h1-h4 标题
      const allHeadings = articleContent.querySelectorAll('h1, h2, h3, h4');

      // 过滤掉装饰性 motto 标题（如 ### <span style="color:red"><u><i>...</i></u></span>）
      const headings = Array.from(allHeadings).filter((heading) => {
        const el = heading as HTMLElement;
        // 跳过 H3 中包含 color:red 样式 span 的 motto 装饰标题
        if (el.tagName === 'H3' || el.tagName === 'H2') {
          const styledSpan = el.querySelector('span[style]');
          if (styledSpan) {
            const style = styledSpan.getAttribute('style') || '';
            if (/color:\s*red/i.test(style)) return false;
          }
        }
        // 跳过没有文本内容的标题
        const text = (el.textContent || '').trim();
        if (!text) return false;
        return true;
      });

      if (headings.length === 0) {
        if (tocSidebar) tocSidebar.style.display = 'none';
        return;
      }

      // 显示 TOC 侧边栏
      if (tocSidebar) tocSidebar.style.display = '';

      // Build TOC tree structure
      interface TocH4 { id: string; text: string; level: number; }
      interface TocH3 { id: string; text: string; level: number; children: TocH4[]; }
      interface TocH2 { id: string; text: string; level: number; children: TocH3[]; }
      interface TocH1 { id: string; text: string; level: number; children: TocH2[]; }

      const tocTree: TocH1[] = [];
      let currentH1: TocH1 | null = null;
      let currentH2: TocH2 | null = null;
      let currentH3: TocH3 | null = null;
      let headingIndex = 0;
      const usedIds = new Set<string>();

      // 改进的 ID 生成：提取纯文本并生成更健壮的 slug
      function generateSlug(text: string): string {
        return text
          .toLowerCase()
          .replace(/<[^>]*>/g, '')           // 移除 HTML 标签
          .replace(/[^\w\u4e00-\u9fff\s-]/g, '') // 保留字母数字中文和连字符
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '')
          .substring(0, 60);
      }

      headings.forEach((heading) => {
        const el = heading as HTMLElement;
        const text = (el.textContent || '').trim();

        // 确保每个标题都有唯一 ID
        if (!el.id) {
          const slug = generateSlug(text);
          let finalId = slug || 'toc-heading';
          let counter = 1;
          while (usedIds.has(finalId)) {
            finalId = slug + '-' + counter;
            counter++;
          }
          el.id = finalId;
        }
        usedIds.add(el.id);
        headingIndex++;

        if (el.tagName === 'H1') {
          currentH1 = { id: el.id, text, level: 1, children: [] };
          currentH2 = null;
          currentH3 = null;
          tocTree.push(currentH1);
        } else if (el.tagName === 'H2') {
          const h2Item: TocH2 = { id: el.id, text, level: 2, children: [] };
          currentH2 = h2Item;
          currentH3 = null;
          if (currentH1) {
            currentH1.children.push(h2Item);
          } else {
            currentH1 = { id: '', text: '', level: 1, children: [h2Item] };
            tocTree.push(currentH1);
          }
        } else if (el.tagName === 'H3') {
          const h3Item: TocH3 = { id: el.id, text, level: 3, children: [] };
          currentH3 = h3Item;
          if (currentH2) {
            currentH2.children.push(h3Item);
          } else if (currentH1) {
            const virtualH2: TocH2 = { id: '', text: '', level: 2, children: [h3Item] };
            currentH1.children.push(virtualH2);
            currentH2 = virtualH2;
          } else {
            const virtualH2: TocH2 = { id: '', text: '', level: 2, children: [h3Item] };
            currentH1 = { id: '', text: '', level: 1, children: [virtualH2] };
            currentH2 = virtualH2;
            tocTree.push(currentH1);
          }
        } else if (el.tagName === 'H4') {
          const h4Item: TocH4 = { id: el.id, text, level: 4 };
          if (currentH3) {
            currentH3.children.push(h4Item);
          } else if (currentH2) {
            const virtualH3: TocH3 = { id: '', text: '', level: 3, children: [h4Item] };
            currentH2.children.push(virtualH3);
            currentH3 = virtualH3;
          } else if (currentH1) {
            const virtualH3: TocH3 = { id: '', text: '', level: 3, children: [h4Item] };
            const virtualH2: TocH2 = { id: '', text: '', level: 2, children: [virtualH3] };
            currentH1.children.push(virtualH2);
            currentH2 = virtualH2;
            currentH3 = virtualH3;
          } else {
            const virtualH3: TocH3 = { id: '', text: '', level: 3, children: [h4Item] };
            const virtualH2: TocH2 = { id: '', text: '', level: 2, children: [virtualH3] };
            currentH1 = { id: '', text: '', level: 1, children: [virtualH2] };
            currentH2 = virtualH2;
            currentH3 = virtualH3;
            tocTree.push(currentH1);
          }
        }
      });

      // Render TOC HTML
      let tocHtml = '';

      function renderH1(h1: TocH1, i: number) {
        if (!h1.text) {
          // 虚拟 h1，直接渲染其 h2 子元素（提升为顶级）
          h1.children.forEach((h2, j) => {
            renderH2AsTop(h2, i, j);
          });
          return;
        }

        const hasChildren = h1.children.length > 0;
        tocHtml += `<div class="toc-h1">`;
        tocHtml += `<a href="#${h1.id}" class="toc-h1-link" data-id="${h1.id}">`;
        tocHtml += `<span class="toc-arrow"><i class="fa-solid fa-chevron-right"></i></span>`;
        tocHtml += `<span class="toc-text">${h1.text}</span></a>`;

        if (hasChildren) {
          tocHtml += `<div class="toc-h2-list" id="toc-h2-${i}">`;
          h1.children.forEach((h2, j) => {
            renderH2(h2, i, j);
          });
          tocHtml += `</div>`;
        }
        tocHtml += `</div>`;
      }

      function renderH2AsTop(h2: TocH2, i: number, j: number) {
        const h2HasChildren = h2.children.length > 0;
        if (!h2.text) {
          // 虚拟 h2 作为顶层，直接渲染 h3
          if (h2HasChildren) {
            h2.children.forEach((h3, k) => {
              renderH3AsTop(h3, i, j, k);
            });
          }
          return;
        }
        tocHtml += `<div class="toc-h1">`;
        tocHtml += `<a href="#${h2.id}" class="toc-h1-link" data-id="${h2.id}">`;
        tocHtml += `<span class="toc-arrow"><i class="fa-solid fa-chevron-right"></i></span>`;
        tocHtml += `<span class="toc-text">${h2.text}</span></a>`;

        if (h2HasChildren) {
          tocHtml += `<div class="toc-h2-list expanded" id="toc-h2-v-${i}-${j}">`;
          h2.children.forEach((h3, k) => {
            renderH3(h3, i, j, k);
          });
          tocHtml += `</div>`;
        }
        tocHtml += `</div>`;
      }

      function renderH2(h2: TocH2, i: number, j: number) {
        const h2HasChildren = h2.children.length > 0;
        if (!h2.text) {
          // 虚拟 h2，直接渲染 h3
          if (h2HasChildren) {
            h2.children.forEach((h3, k) => {
              renderH3(h3, i, j, k);
            });
          }
          return;
        }
        tocHtml += `<div class="toc-h2-item">`;
        tocHtml += `<a href="#${h2.id}" class="toc-h2-link" data-id="${h2.id}">`;
        tocHtml += `<span class="toc-arrow"><i class="fa-solid fa-chevron-right"></i></span>`;
        tocHtml += `<span class="toc-text">${h2.text}</span></a>`;

        if (h2HasChildren) {
          tocHtml += `<div class="toc-h3-list" id="toc-h3-${i}-${j}">`;
          h2.children.forEach((h3, k) => {
            renderH3(h3, i, j, k);
          });
          tocHtml += `</div>`;
        }
        tocHtml += `</div>`;
      }

      function renderH3AsTop(h3: TocH3, i: number, j: number, k: number) {
        const h3HasChildren = h3.children.length > 0;
        if (!h3.text) return;
        tocHtml += `<div class="toc-h1">`;
        tocHtml += `<a href="#${h3.id}" class="toc-h1-link" data-id="${h3.id}">`;
        tocHtml += `<span class="toc-arrow"><i class="fa-solid fa-chevron-right"></i></span>`;
        tocHtml += `<span class="toc-text">${h3.text}</span></a>`;

        if (h3HasChildren) {
          tocHtml += `<div class="toc-h2-list expanded" id="toc-h3-v-${i}-${j}-${k}">`;
          h3.children.forEach((h4, l) => {
            renderH4(h4, i, j, k, l);
          });
          tocHtml += `</div>`;
        }
        tocHtml += `</div>`;
      }

      function renderH3(h3: TocH3, i: number, j: number, k: number) {
        const h3HasChildren = h3.children.length > 0;
        if (!h3.text) {
          if (h3HasChildren) {
            h3.children.forEach((h4, l) => {
              renderH4(h4, i, j, k, l);
            });
          }
          return;
        }
        tocHtml += `<div class="toc-h3-item">`;
        tocHtml += `<a href="#${h3.id}" class="toc-h3-link" data-id="${h3.id}">`;
        tocHtml += `<span class="toc-arrow"><i class="fa-solid fa-chevron-right"></i></span>`;
        tocHtml += `<span class="toc-text">${h3.text}</span></a>`;

        if (h3HasChildren) {
          tocHtml += `<div class="toc-h4-list" id="toc-h4-${i}-${j}-${k}">`;
          h3.children.forEach((h4, l) => {
            renderH4(h4, i, j, k, l);
          });
          tocHtml += `</div>`;
        }
        tocHtml += `</div>`;
      }

      function renderH4(h4: TocH4, i: number, j: number, k: number, l: number) {
        tocHtml += `<div class="toc-h4-item">`;
        tocHtml += `<a href="#${h4.id}" class="toc-h4-link" data-id="${h4.id}">${h4.text}</a>`;
        tocHtml += `</div>`;
      }

      tocTree.forEach((h1, i) => renderH1(h1, i));
      tocNav.innerHTML = tocHtml;

      // ===== 展开折叠逻辑 =====
      const h1Links = tocNav.querySelectorAll('.toc-h1-link');
      const h2Links = tocNav.querySelectorAll('.toc-h2-link');
      const h3Links = tocNav.querySelectorAll('.toc-h3-link');
      const h4Links = tocNav.querySelectorAll('.toc-h4-link');

      // 辅助函数：点击标题链接后，跳转到对应标题并自动展开 <details>
      function navigateToHeading(headingId: string) {
        if (!headingId) return;
        const headingEl = document.getElementById(headingId);
        if (!headingEl) return;
        // 自动展开包含该标题的 <details> 元素
        const detailsEl = headingEl.closest('details');
        if (detailsEl && !detailsEl.open) {
          detailsEl.open = true;
        }
        headingEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // h1 点击展开/折叠 h2 列表
      h1Links.forEach(link => {
        link.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const h1Div = target.closest('.toc-h1');
          const subList = h1Div?.querySelector('.toc-h2-list') as HTMLElement | null;
          if (subList) {
            e.preventDefault();
            subList.classList.toggle('expanded');
            target.classList.toggle('expanded');
          }
          navigateToHeading(target.getAttribute('data-id') || '');
        });
      });

      // h2 点击展开/折叠 h3 列表
      h2Links.forEach(link => {
        link.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const h2Item = target.closest('.toc-h2-item');
          const subList = h2Item?.querySelector('.toc-h3-list') as HTMLElement | null;
          if (subList) {
            e.preventDefault();
            subList.classList.toggle('expanded');
            target.classList.toggle('expanded');
          }
          navigateToHeading(target.getAttribute('data-id') || '');
        });
      });

      // h3 点击展开/折叠 h4 列表
      h3Links.forEach(link => {
        link.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const h3Item = target.closest('.toc-h3-item');
          const subList = h3Item?.querySelector('.toc-h4-list') as HTMLElement | null;
          if (subList) {
            e.preventDefault();
            subList.classList.toggle('expanded');
            target.classList.toggle('expanded');
          }
          navigateToHeading(target.getAttribute('data-id') || '');
        });
      });

      // h4 点击直接跳转
      h4Links.forEach(link => {
        link.addEventListener('click', () => {
          const target = link as HTMLElement;
          navigateToHeading(target.getAttribute('data-id') || '');
        });
      });

      // 自动展开第一级 h1 和 h2
      const firstH2List = tocNav.querySelector('.toc-h2-list:not(.expanded)');
      const firstH1Link = tocNav.querySelector('.toc-h1-link:not(.expanded)');
      if (firstH2List) firstH2List.classList.add('expanded');
      if (firstH1Link) firstH1Link.classList.add('expanded');
      const firstH3List = tocNav.querySelector('.toc-h3-list');
      const firstH2Link = tocNav.querySelector('.toc-h2-link');
      if (firstH3List) firstH3List.classList.add('expanded');
      if (firstH2Link) firstH2Link.classList.add('expanded');

      // ===== Scroll Spy - 滚动时高亮当前标题 =====
      const allHeadingEls = Array.from(headings) as HTMLElement[];
      let scrollTick = false;

      function updateActiveHeading() {
        let activeId = '';
        allHeadingEls.forEach(h => {
          const rect = h.getBoundingClientRect();
          if (rect.top <= 140) {
            activeId = h.id;
          }
        });

        // 移除所有 active
        h1Links.forEach(l => l.classList.remove('active'));
        h2Links.forEach(l => l.classList.remove('active'));
        h3Links.forEach(l => l.classList.remove('active'));
        h4Links.forEach(l => l.classList.remove('active'));

        if (activeId) {
          const activeLink = tocNav.querySelector(`[data-id="${activeId}"]`);
          if (activeLink) {
            activeLink.classList.add('active');
            // 确保父级列表展开
            const parentH2List = activeLink.closest('.toc-h2-list');
            if (parentH2List && !parentH2List.classList.contains('expanded')) {
              parentH2List.classList.add('expanded');
              const parentH1Link = parentH2List.previousElementSibling;
              if (parentH1Link) parentH1Link.classList.add('expanded');
            }
            const parentH3List = activeLink.closest('.toc-h3-list');
            if (parentH3List && !parentH3List.classList.contains('expanded')) {
              parentH3List.classList.add('expanded');
              const parentH2Link = parentH3List.previousElementSibling;
              if (parentH2Link) parentH2Link.classList.add('expanded');
            }
            const parentH4List = activeLink.closest('.toc-h4-list');
            if (parentH4List && !parentH4List.classList.contains('expanded')) {
              parentH4List.classList.add('expanded');
              const parentH3Link = parentH4List.previousElementSibling;
              if (parentH3Link) parentH3Link.classList.add('expanded');
            }
          }
        }
      }

      window.addEventListener('scroll', () => {
        if (!scrollTick) {
          requestAnimationFrame(() => {
            updateActiveHeading();
            scrollTick = false;
          });
          scrollTick = true;
        }
      }, { signal: tocSignal });

      // 初始检查一次
      updateActiveHeading();
    }

    // 初始构建 TOC
    buildTOC();

    // 监听加密内容解锁后重新构建 TOC
    const encryptorContent = document.getElementById('encryptorContent');
    if (encryptorContent) {
      const observer = new MutationObserver(() => {
        // 加密内容显示后重新构建
        if (encryptorContent.style.display !== 'none') {
          setTimeout(buildTOC, 100);
          observer.disconnect(); // 只需重建一次
        }
      });
      observer.observe(encryptorContent, { attributes: true, attributeFilter: ['style'] });
    }

    // TOC collapse button
    const tocCollapseBtn = document.getElementById('tocCollapseBtn');
    const tocBody = document.getElementById('tocBody');
    tocCollapseBtn?.addEventListener('click', () => {
      tocCollapseBtn.classList.toggle('collapsed');
      tocBody?.classList.toggle('collapsed');
    });

    // ====== :spoiler[text] 隐藏文字处理 ======
    // 将 :spoiler[内容] 语法转换为可点击的隐藏文字
    function processSpoilers() {
      if (!articleContent) return;
      const walker = document.createTreeWalker(articleContent, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        if (node.textContent && node.textContent.includes(':spoiler[')) {
          textNodes.push(node);
        }
      }

      textNodes.forEach(textNode => {
        const text = textNode.textContent || '';
        const spoilerRegex = /:spoiler\[([^\]]*)\]/g;

        if (!spoilerRegex.test(text)) return;
        spoilerRegex.lastIndex = 0;

        const fragment = document.createDocumentFragment();
        let lastIndex = 0;

        let match: RegExpExecArray | null;

        while ((match = spoilerRegex.exec(text)) !== null) {
          // 添加 spoiler 之前的文本
          if (match.index > lastIndex) {
            fragment.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
          }
          // 创建 spoiler span
          const span = document.createElement('span');
          span.className = 'spoiler-text';
          span.textContent = match[1];
          span.addEventListener('click', () => {
            span.classList.toggle('revealed');
          });
          fragment.appendChild(span);
          lastIndex = spoilerRegex.lastIndex;
        }

        // 添加剩余文本
        if (lastIndex < text.length) {
          fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
        }

        if (fragment.childNodes.length > 0) {
          textNode.parentNode?.replaceChild(fragment, textNode);
        }
      });
    }

    processSpoilers();
  });
</script>
