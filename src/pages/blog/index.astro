---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const blogPosts = allPosts
  .map(post => ({
    slug: post.slug,
    title: post.data.title,
    date: post.data.date,
    tags: post.data.tags,
    excerpt: post.data.excerpt || '',
    cover: post.data.cover || '',
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(blogPosts.flatMap(p => p.tags))];
---

<BaseLayout title="博文">
  <div class="page-layout">
    <SidebarWidget />

    <div class="page-main">
      <!-- Search & Filter -->
      <div class="filter-bar">
        <div class="search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="searchInput" placeholder="搜索文章..." class="search-input" />
        </div>
        <div class="tag-filter" id="tagFilter">
          <span class="tag active" data-tag="all">全部</span>
          {allTags.map(tag => (
            <span class="tag" data-tag={tag}>{tag}</span>
          ))}
        </div>
      </div>

      <!-- Blog Grid -->
      <div class="blog-grid" id="blogGrid">
        {blogPosts.map((post, index) => (
          <article class="blog-card card" data-tags={post.tags.join(',')} data-title={post.title} data-index={index} style={`animation-delay: ${(index % 6) * 0.08}s`}>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-date"><i class="fa-regular fa-calendar"></i> {post.date}</span>
              </div>
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="blog-card-excerpt">{post.excerpt}</p>
              <div class="blog-card-tags">
                {post.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 24px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .filter-bar {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    max-width: 400px;
  }

  .search-box:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-alpha);
  }

  .search-box i {
    color: var(--text-muted);
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    color: var(--text-primary);
    font-size: 0.92rem;
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-filter .tag.active {
    background: var(--primary);
    color: #fff;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .blog-card {
    overflow: hidden;
    animation: fadeInUp 0.5s ease both;
  }

  .blog-card.hidden-page {
    display: none;
  }

  .blog-card-body {
    padding: 18px;
  }

  .blog-card-meta {
    margin-bottom: 6px;
  }

  .blog-date {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .blog-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .blog-card-title a {
    color: var(--text-primary);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .blog-card-title a:hover {
    color: var(--primary);
  }

  .blog-card-excerpt {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 32px;
    padding: 12px 0;
  }

  .pagination.hidden {
    display: none;
  }

  .page-btn {
    min-width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0 10px;
  }

  .page-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .page-btn.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(125, 152, 245, 0.3);
  }

  .page-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .page-btn i {
    font-size: 0.8rem;
  }

  .page-info {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 8px;
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .page-btn {
      min-width: 32px;
      height: 32px;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const ITEMS_PER_PAGE = 6;

  const tagFilter = document.getElementById('tagFilter');
  const blogCards = Array.from(document.querySelectorAll('.blog-card'));
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const paginationEl = document.getElementById('pagination');

  let currentPage = 1;
  let currentTag = 'all';
  let searchQuery = '';

  function getFilteredCards() {
    return blogCards.filter(card => {
      const el = card as HTMLElement;
      const tags = el.dataset.tags || '';
      const title = el.dataset.title?.toLowerCase() || '';
      const tagMatch = currentTag === 'all' || tags.includes(currentTag);
      const searchMatch = !searchQuery || title.includes(searchQuery);
      return tagMatch && searchMatch;
    });
  }

  function renderPagination(filteredCards: HTMLElement[]) {
    if (!paginationEl) return;
    const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));

    if (totalPages <= 1) {
      paginationEl.classList.add('hidden');
      return;
    }
    paginationEl.classList.remove('hidden');

    if (currentPage > totalPages) currentPage = totalPages;

    let html = '';
    html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-action="prev"><i class="fa-solid fa-chevron-left"></i></button>`;

    for (let i = 1; i <= totalPages; i++) {
      if (totalPages <= 7 || i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      } else if (Math.abs(i - currentPage) === 2) {
        html += `<span class="page-info">...</span>`;
      }
    }

    html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-action="next"><i class="fa-solid fa-chevron-right"></i></button>`;
    paginationEl.innerHTML = html;
  }

  function applyFilters() {
    const filteredCards = getFilteredCards();
    const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));

    if (currentPage > totalPages) currentPage = totalPages;

    blogCards.forEach(card => {
      (card as HTMLElement).classList.add('hidden-page');
    });

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const pageCards = filteredCards.slice(start, start + ITEMS_PER_PAGE);
    pageCards.forEach((card, i) => {
      (card as HTMLElement).classList.remove('hidden-page');
      (card as HTMLElement).style.animationDelay = `${i * 0.08}s`;
    });

    renderPagination(filteredCards);
  }

  // Tag filter
  tagFilter?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('tag')) return;
    tagFilter.querySelectorAll('.tag').forEach(t => t.classList.remove('active'));
    target.classList.add('active');
    currentTag = target.dataset.tag || 'all';
    currentPage = 1;
    applyFilters();
  });

  // Search
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    currentPage = 1;
    applyFilters();
  });

  // Pagination click
  paginationEl?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.page-btn') as HTMLElement;
    if (!btn || btn.classList.contains('disabled') || btn.classList.contains('active')) return;

    const action = btn.dataset.action;
    const page = btn.dataset.page;

    if (action === 'prev') currentPage--;
    else if (action === 'next') currentPage++;
    else if (page) currentPage = parseInt(page);

    applyFilters();
    const container = document.querySelector('.page-main');
    if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  applyFilters();
</script>
