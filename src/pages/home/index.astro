---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { siteConfig } from '../../../config';
---

<BaseLayout title="尺素">
  <div class="home-layout">
    <Sidebar />
    <main class="home-main" data-article-count="6" data-last-edit="2026-05-18">
      <!-- 青衿 (Typewriter) -->
      <section class="home-section">
        <h2 class="section-title">青衿</h2>
        <div class="section-card card">
          <div class="typewriter-content">
            <div class="typewriter-text" id="typewriterText"></div>
            <span class="typewriter-cursor">|</span>
          </div>
        </div>
      </section>

      <!-- 悟我 (About Me) -->
      <section class="home-section">
        <h2 class="section-title">悟我</h2>
        <div class="section-card card">
          <p>你好，欢迎来到我的个人主页。</p>
          <p>这个世界五彩斑斓，而我依旧想要一个安静简约的地方存放躁动的心灵。</p>
          <p>这里存放的，不仅是我的思考，还有对美好生活的向往。</p>
          <div class="about-links">
            <a href="https://github.com/qitinyu" target="_blank" rel="noopener" class="about-link">
              <i class="fa-brands fa-github"></i> GitHub
            </a>
            <a href="https://yqamm.cc.cd" target="_blank" rel="noopener" class="about-link">
              <i class="fa-solid fa-globe"></i> 主站
            </a>
          </div>
        </div>
      </section>

      <!-- 项目展示 -->
      <section class="home-section">
        <h2 class="section-title">项目展示</h2>
        <div class="projects-grid">
          {siteConfig.projects.map((project) => (
            <article class="project-card card">
              <div class="project-card-body">
                <h3 class="project-name">{project.name}</h3>
                <p class="project-desc">{project.desc}</p>
              </div>
              <div class="project-card-footer">
                <a href={project.preview} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
                  <i class="fa-solid fa-eye"></i> 预览
                </a>
                <a href={project.github} target="_blank" rel="noopener" class="project-github" title="查看源码">
                  <i class="fa-brands fa-github"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .home-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 28px;
    padding: 36px 32px;
    min-height: calc(100vh - var(--nav-height) - 100px);
  }

  .home-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .home-section { display: flex; flex-direction: column; }

  .section-card { padding: 32px; }

  .section-card p {
    color: var(--text-primary);
    margin-bottom: 12px;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .typewriter-content {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    min-height: 2em;
  }

  .typewriter-text {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.9;
  }

  .typewriter-cursor {
    font-size: 1.25rem;
    color: var(--primary);
    animation: blink 1s step-end infinite;
    font-weight: 300;
    margin-left: 2px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .about-links { display: flex; gap: 12px; margin-top: 12px; }

  .about-link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: var(--radius-sm);
    background: var(--primary-alpha); color: var(--primary);
    font-size: 1rem; cursor: pointer; transition: all var(--transition-fast);
  }

  .about-link:hover { background: var(--primary); color: #fff; }

  .projects-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

  .project-card { padding: 28px; display: flex; flex-direction: column; }
  .project-card-body { flex: 1; }
  .project-name { font-size: 1.2rem; font-weight: 600; color: var(--text-primary); margin-bottom: 10px; }
  .project-desc { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 16px; }

  .project-card-footer { display: flex; align-items: center; justify-content: space-between; }
  .btn-sm { padding: 8px 18px; font-size: 0.9rem; }

  .project-github {
    font-size: 1.2rem; color: var(--text-muted); cursor: pointer; transition: all var(--transition-fast);
  }

  .project-github:hover { color: var(--primary); transform: scale(1.15); }

  @media (max-width: 1024px) {
    .home-layout { flex-direction: column; }
  }

  @media (max-width: 768px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const texts = [
    '这个世界五彩斑斓，而我依旧想要一个安静简约的地方存放躁动的心灵。',
    '生活不止眼前的代码，还有星辰与大海。',
    '生命绚烂，别被黑暗压垮。',
    '记录生活中的每一份美好与感动。',
  ];

  const typewriterEl = document.getElementById('typewriterText');
  let textIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function typewrite() {
    if (!typewriterEl) return;
    const currentText = texts[textIndex];
    if (isDeleting) {
      typewriterEl.textContent = currentText.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typewriterEl.textContent = currentText.substring(0, charIndex + 1);
      charIndex++;
    }
    let delay = isDeleting ? 40 : 80;
    if (!isDeleting && charIndex === currentText.length) {
      delay = 2500;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      textIndex = (textIndex + 1) % texts.length;
      delay = 500;
    }
    setTimeout(typewrite, delay);
  }
  typewrite();
</script>
