---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { projects, typewriterTexts, aboutMe } from '../data/chisu';
import SidebarWidget from '../components/SidebarWidget.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../utils/dateFormat';

const allPots = await getCollection('pots');
const allDiary = await getCollection('diary');
const totalPosts = allPots.length + allDiary.length;
// 计算总字数（从content body的raw content统计）
let totalWords = 0;
allPots.forEach(p => { totalWords += (p.body || '').replace(/\s/g, '').length; });
allDiary.forEach(d => { totalWords += (d.body || '').replace(/\s/g, '').length; });
// 最后编辑日期
const allDates = [
  ...allPots.map(p => p.data.published || p.data.date || ''),
  ...allDiary.map(d => d.data.date || ''),
].filter(Boolean).sort().reverse();
const lastEdit = allDates[0] ? formatDateShort(allDates[0]) : '';
---

<BaseLayout title="尺素">
  <div class="page-layout">
    <!-- Center Content -->
    <div class="page-main">
      <!-- 青矜 (Typewriter) -->
      <section class="home-section">
        <h2 class="section-title">青衿</h2>
        <div class="section-card card">
          <div class="typewriter-content">
            <div class="typewriter-text" id="typewriterText"></div>
            <span class="typewriter-cursor">|</span>
          </div>
        </div>
      </section>

      <!-- 悟我 (About Me) -->
      <section class="home-section">
        <h2 class="section-title">悟我</h2>
        <div class="section-card card">
          {aboutMe.paragraphs.map(p => <p>{p}</p>)}
          <div class="about-links">
            {aboutMe.links.map(link => (
              <a href={link.url} target="_blank" rel="noopener" class="about-link">
                <i class={link.icon}></i> {link.name}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 项目展示 -->
      <section class="home-section">
        <h2 class="section-title">项目展示</h2>
        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card card">
              <div class="project-card-body">
                <h3 class="project-name">{project.name}</h3>
                <p class="project-desc">{project.desc}</p>
              </div>
              <div class="project-card-footer">
                <a href={project.preview} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
                  <i class="fa-solid fa-eye"></i> 预览
                </a>
                <a href={project.github} target="_blank" rel="noopener" class="project-github" title="查看源码">
                  <i class="fa-brands fa-github"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <SidebarWidget
      totalPosts={totalPosts}
      totalWords={totalWords}
      lastEdit={lastEdit}
    />
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
    min-height: calc(100vh - var(--nav-height) - 80px);
  }

  /* --- Main Content --- */
  .page-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .home-section {
    display: flex;
    flex-direction: column;
  }

  .section-card {
    padding: 22px;
  }

  .section-card p {
    color: var(--text-primary);
    margin-bottom: 8px;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  /* Typewriter */
  .typewriter-content {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    min-height: 2em;
  }

  .typewriter-text {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.8;
  }

  .typewriter-cursor {
    font-size: 1.1rem;
    color: var(--primary);
    animation: blink 1s step-end infinite;
    font-weight: 300;
    margin-left: 2px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* About links */
  .about-links {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background: var(--primary-alpha);
    color: var(--primary);
    font-size: 0.92rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .about-link:hover {
    background: var(--primary);
    color: #fff;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .project-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .project-card-body { flex: 1; }

  .project-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .btn-sm { padding: 6px 14px; font-size: 0.85rem; }

  .project-github {
    font-size: 1.1rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .project-github:hover {
    color: var(--primary);
    transform: scale(1.1);
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
  }

  @media (max-width: 768px) {
    .projects-grid { grid-template-columns: 1fr; }
    .page-layout { padding: 20px 14px; gap: 16px; }
  }
</style>

<script define:vars={{ typewriterTexts }}>
  // 打字机文字从chisu.ts注入
  window.__yuami_typewriter_texts = typewriterTexts;
</script>

<script>
  let typewriterTimer: ReturnType<typeof setTimeout> | null = null;

  document.addEventListener('astro:page-load', () => {
    // Typewriter effect - 从chisu.ts注入的文字
    if (typewriterTimer) clearTimeout(typewriterTimer);
    const typewriterEl = document.getElementById('typewriterText');
    if (!typewriterEl) return;

    const texts = window.__yuami_typewriter_texts || [
      '这个世界五彩斑斓，而我依旧想要一个安静简约的地方存放躁动的心灵。',
      '生活不止眼前的代码，还有星辰与大海。',
      '生命绚烂，别被黑暗压垮。',
      '记录生活中的每一份美好与感动。',
    ];

    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function typewrite() {
      const currentText = texts[textIndex];
      if (isDeleting) {
        typewriterEl.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
      } else {
        typewriterEl.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
      }
      let delay = isDeleting ? 40 : 80;
      if (!isDeleting && charIndex === currentText.length) {
        delay = 2500;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
        delay = 500;
      }
      typewriterTimer = setTimeout(typewrite, delay);
    }
    typewrite();
  });
</script>
