---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { projects } from '../data/chisu';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../utils/dateFormat';
import { scanDirectoryImages } from '../utils/image-scanner';

const allPots = await getCollection('pots');
const allDiary = await getCollection('diary');
const totalPosts = allPots.length + allDiary.length;
let totalWords = 0;
allPots.forEach(p => { totalWords += (p.body || '').replace(/\s/g, '').length; });
allDiary.forEach(d => { totalWords += (d.body || '').replace(/\s/g, '').length; });
const allDates = [
  ...allPots.map(p => p.data.published || p.data.date || ''),
  ...allDiary.map(d => d.data.date || ''),
].filter(Boolean).sort().reverse();
const lastEdit = allDates[0] ? formatDateShort(allDates[0]) : '';

// 轩窗配置
const xcConfig = siteConfig.xuanchuang || {};
const carouselInterval = xcConfig.carouselInterval || 5000;
const carouselApiUrl = xcConfig.carouselApiUrl || '';

// 扫描轮播图目录，收集所有图片
let carouselImages: string[] = [];
if (!carouselApiUrl) {
  const rawImages = xcConfig.carouselImages || [];
  for (const imgPath of rawImages) {
    const ext = imgPath.split('.').pop()?.toLowerCase() || '';
    const imageExts = ['webp', 'jpg', 'jpeg', 'png', 'gif', 'avif', 'svg', 'bmp'];
    if (imageExts.includes(ext)) {
      carouselImages.push(imgPath);
    } else {
      const dirPath = imgPath.replace(/^\//, '');
      const scanned = scanDirectoryImages(dirPath);
      carouselImages.push(...scanned);
    }
  }
  carouselImages = [...new Set(carouselImages)];
}

// 站点公告与统计配置
const isStatsEnabled = siteConfig.siteStats?.enabled !== false;
const isAnnouncementEnabled = siteConfig.siteAnnouncements?.enabled !== false;
const announcements = siteConfig.siteAnnouncements?.items || siteConfig.siteAnnouncements || [];
const busuanziEnabled = siteConfig.busuanzi?.enabled !== false;
const siteStartDate = siteConfig.siteStats?.startDate || '2026-01-01';

// 社交链接
const socialLinks = siteConfig.socialLinks || [];

// 头像
const avatar = siteConfig.avatar || '/home/avatar.webp';
const authorName = siteConfig.author || 'Yuami';
---

<BaseLayout title="轩窗">
  <div class="page-layout page-layout-centered" id="homePageLayout">
    <!-- 入场动画检测：同步执行避免闪烁 -->
    <script is:inline>
      (function() {
        if (sessionStorage.getItem('yuami_play_entrance') === '1') {
          document.getElementById('homePageLayout').classList.add('home-entrance', 'animate-in');
        }
      })();
    </script>

    <!-- Main Content -->
    <div class="page-main">
      <!-- 青衿: Carousel (重新设计) -->
      <section class="home-section">
        <h2 class="section-title">青衿</h2>
        <div class="qingjin-card card">
          <div class="carousel-wrapper" id="carouselWrapper"
            data-interval={carouselInterval}
            data-api-url={carouselApiUrl}
            data-images={JSON.stringify(carouselImages)}
          >
            <div class="carousel-images" id="carouselImages">
              {carouselImages.length > 0 ? carouselImages.map((src, i) => (
                <div class={`carousel-img-item ${i === 0 ? 'active' : ''}`} data-src={src}>
                  <img src={src} alt="" loading="lazy" />
                </div>
              )) : (
                <div class="carousel-img-item active carousel-placeholder">
                  <i class="fa-solid fa-image"></i>
                  <span>暂无图片</span>
                </div>
              )}
            </div>
            <!-- 文字浮层 -->
            <div class="carousel-overlay-info">
              <div class="carousel-avatar-wrap">
                <img src={avatar} alt={authorName} class="carousel-avatar" />
              </div>
              <div class="carousel-author-info">
                <h3 class="carousel-author-name">{authorName}</h3>
                <p class="carousel-author-signature">生命绚烂,别被黑暗压垮.</p>
                <div class="carousel-social-icons">
                  {socialLinks.map(link => (
                    <a href={link.url} target="_blank" rel="noopener" title={link.name} class="carousel-social-icon">
                      <i class={link.icon}></i>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 微言: 三卡片(站点公告/站点统计/访问统计) -->
      <section class="home-section">
        <h2 class="section-title">微言</h2>
        <div class="weiyan-grid">
          <!-- 站点公告 -->
          {isAnnouncementEnabled && (
            <div class="weiyan-card card">
              <div class="weiyan-header">
                <i class="fa-solid fa-bullhorn"></i>
                <span>站点公告</span>
              </div>
              <div class="weiyan-body">
                <div class="notice-list">
                  {announcements.map((item: { date: string; text: string }) => (
                    <div class="notice-item">
                      <span class="notice-date">{formatDateShort(item.date)}</span>
                      <p class="notice-text">{item.text}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          <!-- 站点统计 -->
          {isStatsEnabled && (
            <div class="weiyan-card card">
              <div class="weiyan-header">
                <i class="fa-solid fa-chart-bar"></i>
                <span>站点统计</span>
              </div>
              <div class="weiyan-body">
                <div class="stat-list"
                  data-start-date={siteStartDate}
                  data-total-posts={totalPosts}
                  data-total-words={totalWords}
                  data-last-edit={lastEdit}
                >
                  <div class="stat-row">
                    <span class="stat-label"><i class="fa-solid fa-file-lines"></i> 总文章数</span>
                    <span class="stat-value" id="sidebarStatPosts">--</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label"><i class="fa-solid fa-font"></i> 总字数</span>
                    <span class="stat-value" id="sidebarStatWords">--</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label"><i class="fa-solid fa-clock"></i> 运行时长</span>
                    <span class="stat-value" id="sidebarStatDays">--</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label"><i class="fa-solid fa-pen-to-square"></i> 最后编辑</span>
                    <span class="stat-value" id="sidebarStatLastEdit">--</span>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- 访问统计 -->
          {busuanziEnabled && (
            <div class="weiyan-card card">
              <div class="weiyan-header">
                <i class="fa-solid fa-chart-line"></i>
                <span>访问统计</span>
              </div>
              <div class="weiyan-body">
                <div class="busuanzi-stats">
                  <div class="busuanzi-stat-main">
                    <span class="busuanzi-stat-label">总访问量</span>
                    <span class="busuanzi-stat-number" id="busuanzi_value_site_pv">—</span>
                  </div>
                  <div class="busuanzi-stat-row">
                    <div class="busuanzi-stat-half">
                      <span class="busuanzi-stat-label-sm">访客数</span>
                      <span class="busuanzi-stat-value" id="busuanzi_value_site_uv">—</span>
                    </div>
                    <div class="busuanzi-stat-divider"></div>
                    <div class="busuanzi-stat-half">
                      <span class="busuanzi-stat-label-sm">本文阅读</span>
                      <span class="busuanzi-stat-value" id="busuanzi_value_page_pv">—</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- 悟我: Projects (3列布局) -->
      <section class="home-section">
        <h2 class="section-title">悟我</h2>
        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card card">
              <div class="project-card-body">
                <h3 class="project-name">{project.name}</h3>
                <p class="project-desc">{project.desc}</p>
              </div>
              <div class="project-card-footer">
                <a href={project.preview} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
                  <i class="fa-solid fa-eye"></i> 预览
                </a>
                <a href={project.github} target="_blank" rel="noopener" class="project-github" title="查看源码">
                  <i class="fa-brands fa-github"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style is:inline>
  /* ====== 轩窗版块组合弹出动画 ====== */
  @keyframes componentPopIn {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    60% {
      transform: translateY(-4px) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .page-layout-centered {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
    min-height: calc(100vh - var(--nav-height) - 80px);
    justify-content: center;
  }

  /* 入场动画：各区块初始隐藏 */
  .home-entrance .home-section,
  .home-entrance .article-sidebar {
    opacity: 0;
  }
  .home-entrance.animate-in .home-section,
  .home-entrance.animate-in .article-sidebar {
    animation: componentPopIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .home-entrance.animate-in .home-section:nth-child(1) {
    animation-delay: 0.15s;
  }
  .home-entrance.animate-in .home-section:nth-child(2) {
    animation-delay: 0.3s;
  }
  .home-entrance.animate-in .home-section:nth-child(3) {
    animation-delay: 0.45s;
  }

  /* --- Main Content --- */
  .page-main {
    flex: 1;
    min-width: 0;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .home-section {
    display: flex;
    flex-direction: column;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 14px;
    position: relative;
    padding-left: 14px;
  }

  .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 20px;
    border-radius: 2px;
    background: var(--primary);
  }

  /* ====== 青衿: Carousel 重新设计 ====== */
  .qingjin-card {
    padding: 0;
    overflow: hidden;
    position: relative;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    min-height: 380px;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .carousel-images {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 380px;
  }

  .carousel-img-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1.2s ease, transform 1.2s ease;
    z-index: 0;
  }

  .carousel-img-item.active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  .carousel-img-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-placeholder {
    background: linear-gradient(135deg, var(--primary-alpha), var(--primary-alpha-30));
    color: var(--primary);
    flex-direction: column;
    gap: 8px;
    font-size: 1rem;
    opacity: 1;
    transform: scale(1);
  }

  .carousel-placeholder i {
    font-size: 2.5rem;
  }

  /* 固定文字浮层已移除 */

  /* 头像+作者信息浮层（左下角） */
  .carousel-overlay-info {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 10;
    padding: 24px 28px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    color: var(--primary);
  }

  .carousel-avatar-wrap {
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    overflow: hidden;
  }

  .carousel-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-author-info {
    flex: 1;
    min-width: 0;
  }

  .carousel-author-name {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 4px;
  }

  .carousel-author-signature {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--primary);
    opacity: 0.85;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .carousel-social-icons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .carousel-social-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--primary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .carousel-social-icon:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
  }

  /* ====== 微言: 三卡片 ====== */
  .weiyan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .weiyan-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .weiyan-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
  }

  .weiyan-header i {
    font-size: 0.88rem;
  }

  .weiyan-body {
    padding: 14px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* 站点公告 */
  .notice-list {
    width: 100%;
  }

  .notice-item {
    padding: 6px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .notice-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .notice-date {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 2px;
  }

  .notice-text {
    font-size: 0.82rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  /* 站点统计 */
  .stat-list {
    width: 100%;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px dashed var(--border-color);
  }

  .stat-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-label {
    font-size: 0.82rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-label i {
    color: var(--primary);
    font-size: 0.78rem;
  }

  .stat-value {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary);
  }

  /* 访问统计 */
  .busuanzi-stats {
    width: 100%;
  }

  .busuanzi-stat-main {
    text-align: center;
    margin-bottom: 10px;
  }

  .busuanzi-stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .busuanzi-stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1.2;
  }

  .busuanzi-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding-top: 8px;
    border-top: 1px dashed var(--border-color);
  }

  .busuanzi-stat-half {
    flex: 1;
    text-align: center;
  }

  .busuanzi-stat-divider {
    width: 1px;
    height: 28px;
    background: var(--border-color);
    flex-shrink: 0;
  }

  .busuanzi-stat-label-sm {
    display: block;
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .busuanzi-stat-value {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
  }

  /* ====== 悟我: Projects 3列布局 ====== */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .project-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .project-card-body { flex: 1; }

  .project-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 12px;
    line-height: 1.6;
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .btn-sm { padding: 6px 14px; font-size: 0.85rem; }

  .project-github {
    font-size: 1.1rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .project-github:hover {
    color: var(--primary);
    transform: scale(1.1);
  }

  /* ====== Mobile ====== */
  @media (max-width: 1024px) {
    .page-layout-centered { flex-direction: column; }
    .weiyan-grid { grid-template-columns: 1fr; }
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .page-layout-centered { padding: 20px 14px; gap: 16px; }
    .carousel-wrapper { min-height: 280px; }
    .carousel-images { min-height: 280px; }
    .carousel-overlay-info { padding: 16px 18px; gap: 12px; }
    .carousel-avatar-wrap { width: 80px; height: 80px; }
    .carousel-author-name { font-size: 1.15rem; }
    .carousel-social-icon { width: 28px; height: 28px; font-size: 0.78rem; }
    .projects-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .carousel-wrapper { min-height: 240px; }
    .carousel-images { min-height: 240px; }
  }
</style>

<script>
  let carouselTimerId: ReturnType<typeof setInterval> | null = null;

  document.addEventListener('astro:page-load', () => {
    // ====== 入场动画清理 ======
    sessionStorage.removeItem('yuami_play_entrance');

    // ====== 轮播图 (跃动替换) ======
    const wrapper = document.getElementById('carouselWrapper');
    if (wrapper) {
      const interval = parseInt(wrapper.dataset.interval || '5000');
      const apiUrl = wrapper.dataset.apiUrl || '';
      const imagesData = JSON.parse(wrapper.dataset.images || '[]');
      const items = Array.from(wrapper.querySelectorAll('.carousel-img-item'));
      let currentIndex = 0;

      function showNext() {
        if (items.length <= 1) return;
        const prev = items[currentIndex];
        currentIndex = (currentIndex + 1) % items.length;
        const next = items[currentIndex];
        prev.classList.remove('active');
        next.classList.add('active');
      }

      // Start auto rotation
      if (items.length > 1) {
        if (carouselTimerId) clearInterval(carouselTimerId);
        carouselTimerId = setInterval(showNext, interval);
      }

      // If API URL provided, dynamically fetch images
      if (apiUrl) {
        const imagesContainer = document.getElementById('carouselImages');
        if (imagesContainer) {
          let apiIndex = 0;
          const apiInterval = setInterval(() => {
            const url = apiUrl + (apiUrl.includes('?') ? '&' : '?') + '_t=' + Date.now();
            const newItem = document.createElement('div');
            newItem.className = 'carousel-img-item';
            newItem.innerHTML = `<img src="${url}" alt="" onerror="this.parentElement.remove()" />`;

            const oldActive = imagesContainer.querySelector('.carousel-img-item.active');
            if (oldActive) oldActive.classList.remove('active');
            newItem.classList.add('active');

            const allItems = imagesContainer.querySelectorAll('.carousel-img-item');
            if (allItems.length > 5) {
              allItems[0].remove();
            }

            imagesContainer.appendChild(newItem);
            apiIndex++;
          }, interval);
        }
      }
    }

    // ====== 站点统计填充 ======
    const statList = document.querySelector('.weiyan-card .stat-list[data-start-date]') as HTMLElement;
    if (statList) {
      const startDate = statList.dataset.startDate || '2026-01-01';
      const totalPosts = parseInt(statList.dataset.totalPosts || '0');
      const totalWords = parseInt(statList.dataset.totalWords || '0');
      const lastEdit = statList.dataset.lastEdit || '';

      const days = Math.floor((Date.now() - new Date(startDate).getTime()) / (1000 * 60 * 60 * 24));

      const statPosts = document.getElementById('sidebarStatPosts');
      const statWords = document.getElementById('sidebarStatWords');
      const statDays = document.getElementById('sidebarStatDays');
      const statLastEdit = document.getElementById('sidebarStatLastEdit');

      if (statDays) statDays.textContent = days + ' 天';
      if (statPosts) statPosts.textContent = totalPosts + ' 篇';
      if (statWords) {
        if (totalWords >= 10000) {
          statWords.textContent = '约 ' + (totalWords / 10000).toFixed(1) + ' 万字';
        } else {
          statWords.textContent = totalWords + ' 字';
        }
      }
      if (statLastEdit) {
        const dateMatch = lastEdit.match(/\d{4}[-/]\d{2}[-/]\d{2}/);
        statLastEdit.textContent = dateMatch ? dateMatch[0] : lastEdit.substring(0, 10);
      }
    }
  });
</script>
