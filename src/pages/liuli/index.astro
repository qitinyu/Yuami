---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../config';

const shiyiConfig = siteConfig.liuli?.shiyi;
const shiyiUrl = shiyiConfig?.url || '';
const shiyiEnabled = shiyiConfig?.enabled !== false;
const isConfigured = shiyiUrl.length > 0;
---

<BaseLayout title="拾遗 - 留言板">
  <div class="page-layout page-layout-centered">
    <div class="page-main">
      <!-- 页面题头 -->
      <div class="page-header">
        <h1 class="page-title">拾遗</h1>
        <p class="page-subtitle">留下一句话，点亮一片星光</p>
      </div>

      <div class="shiyi-container">
        {!shiyiEnabled ? (
          <div class="sy-not-configured card">
            <div class="sy-nc-icon">
              <i class="fa-solid fa-comment-slash"></i>
            </div>
            <h3 class="sy-nc-title">留言功能已关闭</h3>
            <p class="sy-nc-desc">请在 config.ts 中将 liuli.shiyi.enabled 设为 true 来启用。</p>
            <div class="sy-nc-code">
              <code>config.ts → liuli → shiyi → enabled: true</code>
            </div>
          </div>
        ) : isConfigured ? (
          <!-- Yuamli iframe 嵌入 -->
          <div class="sy-iframe-wrap card">
            <div class="sy-toolbar">
              <div class="sy-toolbar-left">
                <i class="fa-solid fa-comment-dots"></i>
                <span class="sy-url-text" id="syUrlDisplay">{shiyiUrl}</span>
              </div>
              <div class="sy-toolbar-right">
                <button class="sy-refresh-btn" id="syRefreshBtn" title="刷新">
                  <i class="fa-solid fa-rotate-right"></i>
                </button>
                <a href={shiyiUrl} target="_blank" rel="noopener" class="sy-open-btn" title="在新标签页打开">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>
            <div class="sy-iframe-container">
              <iframe
                src={shiyiUrl}
                class="sy-iframe"
                id="syIframe"
                sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-popups-to-escape-sandbox"
                loading="lazy"
                title="留言板"
              ></iframe>
            </div>
          </div>
        ) : (
          <!-- 未配置提示 -->
          <div class="sy-not-configured card">
            <div class="sy-nc-icon">
              <i class="fa-solid fa-comment-dots"></i>
            </div>
            <h3 class="sy-nc-title">尚未配置留言系统地址</h3>
            <p class="sy-nc-desc">请在 config.ts 中的 liuli.shiyi.url 填入你的 Yuamli 留言系统地址。</p>
            <div class="sy-nc-code">
              <code>config.ts → liuli → shiyi → url: 'https://your-yuamli-url'</code>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout {
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    gap: 24px;
  }

  .page-layout-centered {
    min-height: calc(100vh - 60px);
    padding: 24px 16px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .page-header {
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .page-title::before {
    content: '';
    width: 4px;
    height: 22px;
    border-radius: 2px;
    background: var(--primary);
  }

  .page-subtitle {
    font-size: 0.92rem;
    color: var(--text-muted);
    padding-left: 14px;
  }

  .shiyi-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sy-iframe-wrap {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .sy-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: var(--primary-alpha);
    border-bottom: 1px solid var(--border-color);
    gap: 12px;
  }

  .sy-toolbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex: 1;
  }

  .sy-toolbar-left i {
    color: var(--primary);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .sy-url-text {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sy-toolbar-right {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .sy-refresh-btn {
    width: 30px;
    height: 30px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-size: 0.8rem;
  }

  .sy-refresh-btn:hover {
    background: var(--bg-input);
    color: var(--primary);
  }

  .sy-open-btn {
    width: 30px;
    height: 30px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .sy-open-btn:hover {
    background: var(--bg-input);
    color: var(--primary);
  }

  .sy-iframe-container {
    width: 100%;
    height: 75vh;
    min-height: 400px;
    position: relative;
    background: var(--bg-card);
  }

  .sy-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .sy-not-configured {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    text-align: center;
  }

  .sy-nc-icon {
    font-size: 2.5rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .sy-nc-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .sy-nc-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .sy-nc-code {
    display: inline-block;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    font-size: 0.82rem;
    color: var(--primary);
    font-family: 'Courier New', monospace;
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
  }

  @media (max-width: 640px) {
    .sy-iframe-container {
      height: 60vh;
      min-height: 300px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const refreshBtn = document.getElementById('syRefreshBtn');
    const iframe = document.getElementById('syIframe') as HTMLIFrameElement | null;

    refreshBtn?.addEventListener('click', () => {
      if (iframe) {
        iframe.src = iframe.src;
      }
    });
  });
</script>
