---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';
import Twikoo from '../../components/Twikoo.astro';
import { siteConfig } from '../../../config';
import { friendsList } from '../../data/friends';
---

<BaseLayout title="萍踪">
  <div class="page-layout">
    <SidebarWidget />

    <div class="page-main">
      <!-- Apply section -->
      <div class="apply-section card">
        <h3 class="apply-title"><i class="fa-solid fa-handshake"></i> 申请友链</h3>
        <p class="apply-desc">欢迎交换友链！请在评论区留下你的站点信息：名称、地址、头像、描述。</p>
        <div class="apply-info">
          <div class="info-item">
            <span class="info-label">名称：</span>
            <span>Yuami</span>
          </div>
          <div class="info-item">
            <span class="info-label">地址：</span>
            <a href={siteConfig.url} target="_blank" rel="noopener">{siteConfig.url}</a>
          </div>
          <div class="info-item">
            <span class="info-label">描述：</span>
            <span>生命绚烂，别被黑暗压垮</span>
          </div>
        </div>
      </div>

      <!-- Friends Grid -->
      <div class="friends-grid">
        {friendsList.map((friend, index) => (
          <a href={friend.url} target="_blank" rel="noopener" class="friend-card card" style={`animation-delay: ${index * 0.06}s`}>
            <div class="friend-avatar">
              <img src={friend.avatar} alt={friend.name} class="friend-avatar-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
              <div class="avatar-placeholder" style="display:none;">
                <i class="fa-solid fa-user"></i>
              </div>
            </div>
            <div class="friend-info">
              <h3 class="friend-name">{friend.name}</h3>
              <p class="friend-desc">{friend.desc}</p>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square friend-link-icon"></i>
          </a>
        ))}
      </div>

      <!-- Twikoo Comments -->
      <Twikoo />
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 24px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .apply-section {
    padding: 22px;
    margin-bottom: 24px;
  }

  .apply-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 6px;
  }

  .apply-title i {
    margin-right: 6px;
  }

  .apply-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .apply-info {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 10px 14px;
    background: var(--primary-alpha);
    border-radius: var(--radius-sm);
  }

  .info-item {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .info-label {
    font-weight: 500;
    color: var(--text-primary);
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px;
    cursor: pointer;
    text-decoration: none;
    animation: fadeInUp 0.5s ease both;
  }

  .friend-avatar {
    flex-shrink: 0;
  }

  .friend-avatar-img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--primary-alpha-30);
  }

  .avatar-placeholder {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--primary-alpha);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 1.1rem;
  }

  .friend-info {
    flex: 1;
    min-width: 0;
  }

  .friend-name {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .friend-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-link-icon {
    color: var(--text-muted);
    font-size: 0.75rem;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .friend-card:hover .friend-link-icon {
    color: var(--primary);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column-reverse; }
    .friends-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .friends-grid { grid-template-columns: 1fr; }
  }
</style>
