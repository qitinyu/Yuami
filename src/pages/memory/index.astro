---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';
import { albumList } from '../../data/memory';
import { scanHuiyiImages } from '../../utils/image-scanner';

// 构建时扫描图片目录
const scannedAlbums = scanHuiyiImages();

// 合并 memory.ts 中的元数据和自动扫描的图片数据
const allAlbums = albumList.map(album => {
  const scanned = scannedAlbums.get(album.id);
  if (scanned) {
    return {
      ...album,
      images: scanned.images,
      cover: scanned.cover || album.cover,
      count: scanned.count,
    };
  }
  return {
    ...album,
    images: [],
    count: 0,
  };
}).filter(album => album.count > 0 || album.images.length > 0);

// 发现 memory.ts 中未定义的目录，也自动加入
for (const [id, data] of scannedAlbums) {
  if (!albumList.find(a => a.id === id)) {
    allAlbums.push({
      id,
      title: id,
      desc: '',
      cover: data.cover,
      count: data.count,
      images: data.images,
    });
  }
}

// 将图片数据序列化为 JSON 供前端使用
const albumsJson = JSON.stringify(allAlbums.map(a => ({
  id: a.id,
  title: a.title,
  desc: a.desc || '',
  images: a.images,
  cover: a.cover,
  count: a.count || a.images.length,
})));
---

<BaseLayout title="回忆">
  <div class="page-layout">
    <div class="page-main">
      <!-- 相册列表视图 -->
      <div id="albumListView">
        <div class="album-grid" id="albumGrid">
          {allAlbums.map((album, index) => (
            <article class="album-card card" data-album-id={album.id} data-index={index} style={`animation-delay: ${(index % 6) * 0.08}s`}>
              <div class="album-cover">
                <img src={album.cover} alt={album.title} class="album-cover-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="album-cover-placeholder" style="display:none;">
                  <i class="fa-solid fa-images"></i>
                  <span class="album-count">{album.count || album.images.length} 张</span>
                </div>
              </div>
              <div class="album-info">
                <h3 class="album-title">{album.title}</h3>
                <p class="album-desc">{album.desc}</p>
                <span class="album-badge">{album.count || album.images.length} 张照片</span>
              </div>
            </article>
          ))}
        </div>

        <!-- 相册分页 -->
        <div class="pagination" id="albumPagination"></div>
      </div>

      <!-- 图片网格视图 -->
      <div id="photoGridView" style="display:none;">
        <div class="photo-view-header">
          <button class="back-btn" id="backBtn">
            <i class="fa-solid fa-arrow-left"></i>
            <span>返回相册</span>
          </button>
          <h2 class="photo-view-title" id="photoViewTitle"></h2>
          <span class="photo-view-count" id="photoViewCount"></span>
        </div>
        <div class="photo-grid-view" id="photoGridContainer"></div>
        <!-- 图片分页 -->
        <div class="pagination" id="photoPagination"></div>
      </div>

      <!-- Lightbox -->
      <div class="lightbox" id="lightbox">
        <div class="lightbox-overlay" id="lightboxOverlay"></div>
        <button class="lightbox-close" id="lightboxClose" aria-label="关闭"><i class="fa-solid fa-xmark"></i></button>
        <button class="lightbox-prev" id="lightboxPrev" aria-label="上一张"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="lightbox-next" id="lightboxNext" aria-label="下一张"><i class="fa-solid fa-chevron-right"></i></button>
        <div class="lightbox-img-wrap">
          <img id="lightboxImg" src="" alt="" />
        </div>
        <div class="lightbox-counter" id="lightboxCounter"></div>
      </div>
    </div>

    <SidebarWidget />
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  /* ====== 相册卡片 ====== */
  .album-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .album-card {
    overflow: hidden;
    cursor: pointer;
    animation: fadeInUp 0.5s ease both;
    transition: all var(--transition-fast);
  }

  .album-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .album-card.hidden-page {
    display: none;
  }

  .album-cover {
    height: 140px;
    overflow: hidden;
  }

  .album-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all var(--transition-normal);
  }

  .album-card:hover .album-cover-img {
    transform: scale(1.05);
  }

  .album-cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary-alpha), var(--primary-alpha-30));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--primary);
    transition: all var(--transition-normal);
  }

  .album-cover-placeholder i {
    font-size: 2.5rem;
  }

  .album-count {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 12px;
    background: var(--bg-glass);
    color: var(--text-secondary);
  }

  .album-card:hover .album-cover-placeholder {
    transform: scale(1.05);
  }

  .album-info {
    padding: 14px;
  }

  .album-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .album-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .album-badge {
    font-size: 0.75rem;
    color: var(--primary);
    background: var(--primary-alpha);
    padding: 2px 10px;
    border-radius: 12px;
  }

  /* ====== 图片网格视图 ====== */
  .photo-view-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .back-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .back-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .back-btn i {
    font-size: 0.85rem;
  }

  .photo-view-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .photo-view-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--bg-card);
    padding: 4px 12px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  /* ====== 瀑布流布局 - 图片自适应实际尺寸 ====== */
  .photo-grid-view {
    column-count: 4;
    column-gap: 12px;
  }

  .photo-grid-item {
    break-inside: avoid;
    margin-bottom: 12px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    animation: fadeInUp 0.4s ease both;
    transition: all var(--transition-fast);
    position: relative;
  }

  .photo-grid-item:hover {
    box-shadow: var(--shadow-hover);
    z-index: 1;
  }

  .photo-grid-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--transition-normal), filter var(--transition-normal);
    border-radius: var(--radius-sm);
  }

  .photo-grid-item:hover img {
    transform: scale(1.03);
  }

  .photo-grid-item::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
    box-shadow: inset 0 0 0 2px var(--primary-alpha-30);
  }

  .photo-grid-item:hover::after {
    opacity: 1;
  }

  .photo-grid-item.hidden-page {
    display: none;
  }

  /* ====== Lightbox ====== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    background: rgba(0, 0, 0, 0.9);
  }

  .lightbox.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255,255,255,0.1);
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    transition: all var(--transition-fast);
    z-index: 1;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.25);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255,255,255,0.1);
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    transition: all var(--transition-fast);
    z-index: 1;
  }

  .lightbox-prev { left: 16px; }
  .lightbox-next { right: 16px; }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255,255,255,0.25);
  }

  .lightbox-prev.disabled,
  .lightbox-next.disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .lightbox-img-wrap {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img-wrap img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 6px;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    z-index: 1;
  }

  /* 分页样式已移至 global.css */

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
    .album-grid { grid-template-columns: repeat(2, 1fr); }
    .photo-grid-view { column-count: 3; }
  }

  @media (max-width: 860px) {
    .album-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .album-grid { grid-template-columns: 1fr; }
    .photo-grid-view { column-count: 2; }
  }
</style>

<script define:vars={{ albumsData: albumsJson }}>
  // 将构建时的相册数据注入前端
  window.__yuamiAlbums = JSON.parse(albumsData);
</script>

<script>
  let memoryAbortController = new AbortController();

  document.addEventListener('astro:page-load', () => {
    const albumListView = document.getElementById('albumListView');
    if (!albumListView) return;

    memoryAbortController.abort();
    memoryAbortController = new AbortController();
    const memorySignal = memoryAbortController.signal;

    const ALBUMS_PER_PAGE = 6;
    const PHOTOS_PER_PAGE = 24;

    const albumCards = Array.from(document.querySelectorAll('.album-card'));
    const photoGridView = document.getElementById('photoGridView');
    const albumPaginationEl = document.getElementById('albumPagination');
    const photoPaginationEl = document.getElementById('photoPagination');
    const backBtn = document.getElementById('backBtn');
    const photoViewTitle = document.getElementById('photoViewTitle');
    const photoViewCount = document.getElementById('photoViewCount');
    const photoGridContainer = document.getElementById('photoGridContainer');

    // Lightbox elements
    const lightbox = document.getElementById('lightbox');
    const lightboxOverlay = document.getElementById('lightboxOverlay');
    const lightboxClose = document.getElementById('lightboxClose');
    const lightboxPrev = document.getElementById('lightboxPrev');
    const lightboxNext = document.getElementById('lightboxNext');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightboxCounter');

    let albumPage = 1;
    let photoPage = 1;
    let currentAlbumImages: string[] = [];
    let currentAlbumTitle = '';
    let lightboxIndex = 0;

    // ====== 通用分页渲染 ======
    function renderPagination(el: HTMLElement | null, totalPages: number, currentPage: number, onPageChange: (page: number) => void) {
      if (!el) return;
      if (totalPages <= 1) { el.classList.add('hidden'); return; }
      el.classList.remove('hidden');

      let html = '';
      // 上一页
      html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-action="prev"><i class="fa-solid fa-chevron-left"></i></button>`;

      // 页码
      const maxVisible = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
      let endPage = Math.min(totalPages, startPage + maxVisible - 1);
      if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
      }

      if (startPage > 1) {
        html += `<button class="page-btn" data-page="1">1</button>`;
        if (startPage > 2) {
          html += `<span class="page-ellipsis">...</span>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<span class="page-ellipsis">...</span>`;
        }
        html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
      }

      // 下一页
      html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-action="next"><i class="fa-solid fa-chevron-right"></i></button>`;
      el.innerHTML = html;

      // 绑定事件
      el.querySelectorAll('.page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const b = btn as HTMLElement;
          if (b.classList.contains('disabled') || b.classList.contains('active')) return;
          const action = b.dataset.action;
          const page = b.dataset.page;
          let newPage = currentPage;
          if (action === 'prev') newPage = currentPage - 1;
          else if (action === 'next') newPage = currentPage + 1;
          else if (page) newPage = parseInt(page);
          onPageChange(newPage);
        });
      });
    }

    // ====== 相册列表分页 ======
    function applyAlbumPage() {
      const totalPages = Math.max(1, Math.ceil(albumCards.length / ALBUMS_PER_PAGE));
      if (albumPage > totalPages) albumPage = totalPages;

      albumCards.forEach(card => { (card as HTMLElement).classList.add('hidden-page'); });
      const start = (albumPage - 1) * ALBUMS_PER_PAGE;
      albumCards.slice(start, start + ALBUMS_PER_PAGE).forEach((card, i) => {
        (card as HTMLElement).classList.remove('hidden-page');
        (card as HTMLElement).style.animationDelay = `${i * 0.08}s`;
      });

      renderPagination(albumPaginationEl, totalPages, albumPage, (page) => {
        albumPage = page;
        applyAlbumPage();
        document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // ====== 图片网格分页 ======
    function applyPhotoPage() {
      const photoItems = Array.from(photoGridContainer?.querySelectorAll('.photo-grid-item') || []);
      const totalPages = Math.max(1, Math.ceil(currentAlbumImages.length / PHOTOS_PER_PAGE));
      if (photoPage > totalPages) photoPage = totalPages;

      photoItems.forEach(item => { (item as HTMLElement).classList.add('hidden-page'); });
      const start = (photoPage - 1) * PHOTOS_PER_PAGE;
      photoItems.slice(start, start + PHOTOS_PER_PAGE).forEach((item, i) => {
        (item as HTMLElement).classList.remove('hidden-page');
        (item as HTMLElement).style.animationDelay = `${i * 0.04}s`;
      });

      renderPagination(photoPaginationEl, totalPages, photoPage, (page) => {
        photoPage = page;
        applyPhotoPage();
        document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // ====== 打开相册 ======
    function openAlbum(albumId: string) {
      const albums: Array<{id: string; title: string; images: string[]; count: number}> = (window as any).__yuamiAlbums || [];
      const album = albums.find(a => a.id === albumId);
      if (!album || !album.images || album.images.length === 0) return;

      currentAlbumImages = album.images;
      currentAlbumTitle = album.title;
      photoPage = 1;

      if (photoViewTitle) photoViewTitle.textContent = album.title;
      if (photoViewCount) photoViewCount.textContent = `${album.images.length} 张`;

      // 渲染图片网格
      if (photoGridContainer) {
        photoGridContainer.innerHTML = '';
        album.images.forEach((src, index) => {
          const item = document.createElement('div');
          item.className = 'photo-grid-item';
          item.style.animationDelay = `${(index % PHOTOS_PER_PAGE) * 0.04}s`;
          item.innerHTML = `<img src="${src}" alt="照片 ${index + 1}" loading="lazy" onerror="this.parentElement.style.display='none'" />`;
          item.addEventListener('click', () => openLightbox(index));
          photoGridContainer.appendChild(item);
        });
      }

      // 切换视图
      if (albumListView) albumListView.style.display = 'none';
      if (photoGridView) photoGridView.style.display = 'block';

      applyPhotoPage();
      document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ====== 返回相册列表 ======
    backBtn?.addEventListener('click', () => {
      if (photoGridView) photoGridView.style.display = 'none';
      if (albumListView) albumListView.style.display = 'block';
      closeLightbox();
    });

    // ====== Lightbox ======
    function openLightbox(index: number) {
      lightboxIndex = index;
      updateLightbox();
      lightbox?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.classList.remove('active');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!lightboxImg) return;
      lightboxImg.src = currentAlbumImages[lightboxIndex] || '';
      if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${currentAlbumImages.length}`;

      if (lightboxPrev) {
        lightboxPrev.classList.toggle('disabled', lightboxIndex === 0);
      }
      if (lightboxNext) {
        lightboxNext.classList.toggle('disabled', lightboxIndex === currentAlbumImages.length - 1);
      }
    }

    lightboxOverlay?.addEventListener('click', closeLightbox);
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', () => {
      if (lightboxIndex > 0) { lightboxIndex--; updateLightbox(); }
    });
    lightboxNext?.addEventListener('click', () => {
      if (lightboxIndex < currentAlbumImages.length - 1) { lightboxIndex++; updateLightbox(); }
    });

    // 键盘导航
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && lightboxIndex > 0) { lightboxIndex--; updateLightbox(); }
      if (e.key === 'ArrowRight' && lightboxIndex < currentAlbumImages.length - 1) { lightboxIndex++; updateLightbox(); }
    }, { signal: memorySignal });

    // ====== 相册卡片点击 ======
    albumCards.forEach(card => {
      card.addEventListener('click', () => {
        const albumId = (card as HTMLElement).dataset.albumId;
        if (albumId) openAlbum(albumId);
      });
    });

    // ====== 初始化 ======
    applyAlbumPage();
  });
</script>
