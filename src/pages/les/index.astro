---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Twikoo from '../../components/Twikoo.astro';
import { lesList } from '../../data/les';

const types = ['全部', '一完结', '连载中', '全完结' ];
---

<BaseLayout title="LES">
  <div class="page-layout page-layout-centered">
    <div class="page-main">
      <!-- 页面题头 -->
      <div class="page-header">
        <h1 class="page-title">LES</h1>
        <p class="page-subtitle">聆听过的声音，珍藏过的故事</p>
      </div>

      <div class="type-filter" id="typeFilter">
        {types.map(t => (
          <span class={`filter-tab ${t === '全部' ? 'active' : ''}`} data-type={t} style="cursor: pointer;">{t}</span>
        ))}
      </div>

      <div class="les-grid" id="lesGrid">
        {lesList.map((item, index) => (
          <article class="les-card card" data-type={item.type} data-status={item.status} data-index={index} style={`animation-delay: ${(index % 6) * 0.08}s`}>
            <a href={item.url || 'javascript:void(0)'} class="les-card-link" target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined}>
              <div class="les-cover">
                {item.cover ? (
                  <img src={item.cover} alt={item.title} class="cover-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                ) : null}
                <div class="cover-placeholder" style={item.cover ? 'display:none;' : ''}>
                  <i class="fa-solid fa-palette"></i>
                </div>
                <span class="type-badge">{item.status}</span>
              </div>
              <div class="les-info">
                <h3 class="les-title">{item.title}</h3>
                <div class="les-meta">
                  <span class="cv-tag">{item.cv}</span>
                  <span class="cp-tag">{item.cp}</span>
                  <span class="status-tag">{item.status}</span>
                </div>
                <p class="les-comment">{item.comment}</p>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>

      <!-- Twikoo Comments -->
      <Twikoo />
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout-centered {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
    justify-content: center;
  }

  .page-main {
    flex: 1;
    min-width: 0;
    max-width: 1100px;
  }

  /* 页面题头 */
  .page-header {
    margin-bottom: 20px;
  }

  .page-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    position: relative;
    padding-left: 14px;
  }

  .page-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 24px;
    border-radius: 2px;
    background: var(--primary);
  }

  .page-subtitle {
    font-size: 0.92rem;
    color: var(--text-muted);
    padding-left: 14px;
  }

  .type-filter {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    justify-content: center;
  }

  .filter-tab {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover,
  .filter-tab.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .les-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .les-card {
    overflow: hidden;
    animation: fadeInUp 0.5s ease both;
    cursor: pointer;
  }

  .les-card-link {
    display: flex;
    text-decoration: none;
    color: inherit;
  }

  .les-card.hidden-page {
    display: none;
  }

  .les-cover {
    width: 100px;
    min-height: 140px;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all var(--transition-normal);
  }

  .les-card:hover .cover-img {
    transform: scale(1.05);
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary-alpha), var(--primary-alpha-30));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 1.8rem;
    transition: all var(--transition-normal);
  }

  .les-card:hover .cover-placeholder {
    transform: scale(1.05);
  }

  .type-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 0.65rem;
    background: var(--primary);
    color: #fff;
  }

  .les-info {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .les-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    transition: color var(--transition-fast);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .les-card:hover .les-title {
    color: var(--primary);
  }

  .les-meta {
    margin-bottom: 4px;
  }
 
  .cv-tag,
  .cp-tag,
  .status-tag
   {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 0.65rem;
    background: var(--primary-alpha);
    color: var(--primary);
   
  }
  .cp-tag,
  .status-tag{
   margin-left: 6px;
}
  .les-comment {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 分页样式已移至 global.css */

  @media (max-width: 1024px) {
    .page-layout-centered { flex-direction: column; }
    .les-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .les-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .les-grid { grid-template-columns: 1fr; }
    .les-cover { width: 80px; min-height: 110px; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const lesGrid = document.getElementById('lesGrid');
    if (!lesGrid) return;

    const ITEMS_PER_PAGE = 6;

    const typeFilter = document.getElementById('typeFilter');
    const lesCards = Array.from(document.querySelectorAll('.les-card'));
    const paginationEl = document.getElementById('pagination');

    let currentPage = 1;
    let currentType = '全部';

    function getFilteredCards() {
      return lesCards.filter(card => {
        const el = card as HTMLElement;
        return currentType === '全部' || el.dataset.status === currentType;
      });
    }

    function renderPagination(filteredCards: HTMLElement[]) {
      if (!paginationEl) return;
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));
      if (totalPages <= 1) { paginationEl.classList.add('hidden'); return; }
      paginationEl.classList.remove('hidden');
      if (currentPage > totalPages) currentPage = totalPages;

      let html = '';
      html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-action="prev"><i class="fa-solid fa-chevron-left"></i></button>`;
      const maxVisible = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
      let endPage = Math.min(totalPages, startPage + maxVisible - 1);
      if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
      }
      if (startPage > 1) {
        html += `<button class="page-btn" data-page="1">1</button>`;
        if (startPage > 2) {
          html += `<span class="page-ellipsis">...</span>`;
        }
      }
      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }
      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<span class="page-ellipsis">...</span>`;
        }
        html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
      }
      html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-action="next"><i class="fa-solid fa-chevron-right"></i></button>`;
      paginationEl.innerHTML = html;
    }

    function applyFilters() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;

      lesCards.forEach(card => { (card as HTMLElement).classList.add('hidden-page'); });
      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      filteredCards.slice(start, start + ITEMS_PER_PAGE).forEach((card, i) => {
        (card as HTMLElement).classList.remove('hidden-page');
        (card as HTMLElement).style.animationDelay = `${i * 0.08}s`;
      });
      renderPagination(filteredCards);
    }

    typeFilter?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('filter-tab')) return;
      typeFilter.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
      target.classList.add('active');
      currentType = target.dataset.type || '全部';
      currentPage = 1;
      applyFilters();
    });

    paginationEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.page-btn') as HTMLElement;
      if (!btn || btn.classList.contains('disabled') || btn.classList.contains('active')) return;
      const action = btn.dataset.action;
      const page = btn.dataset.page;
      if (action === 'prev') currentPage--;
      else if (action === 'next') currentPage++;
      else if (page) currentPage = parseInt(page);
      applyFilters();
      document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    applyFilters();
  });
</script>
