---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';
import Twikoo from '../../components/Twikoo.astro';
import { animeList } from '../../data/anime';

const statuses = ['全部', 'completed', 'watching', 'planned'];
const statusLabels: Record<string, string> = {
  completed: '看过',
  watching: '在看',
  planned: '想看',
};
---

<BaseLayout title="番剧">
  <div class="page-layout">
    <div class="page-main">
      <div class="status-filter" id="statusFilter">
        {statuses.map(s => (
          <span class={`filter-tab ${s === '全部' ? 'active' : ''}`} data-status={s} style="cursor: pointer;">
            {s === '全部' ? '全部' : statusLabels[s] || s}
          </span>
        ))}
      </div>

      <div class="anime-grid" id="animeGrid">
        {animeList.map((item, index) => (
          <article class="anime-card card" data-status={item.status} data-index={index} style={`animation-delay: ${(index % 6) * 0.08}s`}>
            <a href={item.link || 'javascript:void(0)'} class="anime-card-link" target={item.link ? '_blank' : undefined} rel={item.link ? 'noopener noreferrer' : undefined}>
              <div class="anime-cover">
                {item.cover ? (
                  <img src={item.cover} alt={item.title} class="cover-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                ) : null}
                <div class="cover-placeholder" style={item.cover ? 'display:none;' : ''}>
                  <i class="fa-solid fa-tv"></i>
                </div>
                <span class="status-badge">{statusLabels[item.status] || item.status}</span>
              </div>
              <div class="anime-info">
                <h3 class="anime-title">{item.title}</h3>
                <div class="anime-meta">
                  <span class="meta-item"><i class="fa-solid fa-star"></i> {item.rating}</span>
                  <span class="meta-item"><i class="fa-solid fa-calendar"></i> {item.year}</span>
                  <span class="meta-item"><i class="fa-solid fa-film"></i> {item.episodes}</span>
                </div>
                <div class="anime-genre">
                  {item.genre.map(g => (
                    <span class="genre-tag">{g}</span>
                  ))}
                </div>
                {item.studio && <div class="anime-studio"><i class="fa-solid fa-building"></i> {item.studio}</div>}
                <p class="anime-description">{item.description}</p>
                {item.progress !== undefined && item.totalEpisodes && (
                  <div class="anime-progress">
                    <div class="progress-bar">
                      <div class="progress-fill" style={`width: ${(item.progress / item.totalEpisodes) * 100}%`}></div>
                    </div>
                    <span class="progress-text">{item.progress}/{item.totalEpisodes} 集</span>
                  </div>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>

      <!-- Twikoo Comments -->
      <Twikoo />
    </div>

    <SidebarWidget />
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .status-filter {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    justify-content: center;
  }

  .filter-tab {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover,
  .filter-tab.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .anime-card {
    overflow: hidden;
    animation: fadeInUp 0.5s ease both;
    cursor: pointer;
  }

  .anime-card-link {
    display: flex;
    text-decoration: none;
    color: inherit;
  }

  .anime-card.hidden-page {
    display: none;
  }

  .anime-cover {
    width: 110px;
    min-height: 150px;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all var(--transition-normal);
  }

  .anime-card:hover .cover-img {
    transform: scale(1.05);
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary-alpha), var(--primary-alpha-30));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 1.8rem;
    transition: all var(--transition-normal);
  }

  .anime-card:hover .cover-placeholder {
    transform: scale(1.05);
  }

  .status-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 0.65rem;
    background: var(--primary);
    color: #fff;
  }

  .anime-info {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .anime-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    transition: color var(--transition-fast);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-card:hover .anime-title {
    color: var(--primary);
  }

  .anime-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .meta-item {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .meta-item i {
    color: var(--primary);
    font-size: 0.6rem;
  }

  .anime-genre {
    display: flex;
    gap: 3px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .genre-tag {
    font-size: 0.65rem;
    padding: 1px 6px;
    border-radius: 8px;
    background: var(--primary-alpha);
    color: var(--primary);
  }

  .anime-studio {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .anime-studio i {
    color: var(--primary);
    font-size: 0.6rem;
    margin-right: 2px;
  }

  .anime-description {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-progress {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .progress-bar {
    flex: 1;
    height: 3px;
    background: var(--border-color);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--primary);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .progress-text {
    font-size: 0.65rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* 分页样式已移至 global.css */

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
    .anime-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .anime-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .anime-grid { grid-template-columns: 1fr; }
    .anime-cover { width: 90px; min-height: 120px; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const animeGrid = document.getElementById('animeGrid');
    if (!animeGrid) return;

    const ITEMS_PER_PAGE = 6;

    const statusFilter = document.getElementById('statusFilter');
    const animeCards = Array.from(document.querySelectorAll('.anime-card'));
    const paginationEl = document.getElementById('pagination');

    let currentPage = 1;
    let currentStatus = '全部';

    function getFilteredCards() {
      return animeCards.filter(card => {
        const el = card as HTMLElement;
        return currentStatus === '全部' || el.dataset.status === currentStatus;
      });
    }

    function renderPagination(filteredCards: HTMLElement[]) {
      if (!paginationEl) return;
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));
      if (totalPages <= 1) { paginationEl.classList.add('hidden'); return; }
      paginationEl.classList.remove('hidden');
      if (currentPage > totalPages) currentPage = totalPages;

      let html = '';
      html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-action="prev"><i class="fa-solid fa-chevron-left"></i></button>`;
      const maxVisible = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
      let endPage = Math.min(totalPages, startPage + maxVisible - 1);
      if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
      }
      if (startPage > 1) {
        html += `<button class="page-btn" data-page="1">1</button>`;
        if (startPage > 2) {
          html += `<span class="page-ellipsis">...</span>`;
        }
      }
      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }
      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<span class="page-ellipsis">...</span>`;
        }
        html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
      }
      html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-action="next"><i class="fa-solid fa-chevron-right"></i></button>`;
      paginationEl.innerHTML = html;
    }

    function applyFilters() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;

      animeCards.forEach(card => { (card as HTMLElement).classList.add('hidden-page'); });
      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      filteredCards.slice(start, start + ITEMS_PER_PAGE).forEach((card, i) => {
        (card as HTMLElement).classList.remove('hidden-page');
        (card as HTMLElement).style.animationDelay = `${i * 0.08}s`;
      });
      renderPagination(filteredCards);
    }

    statusFilter?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('filter-tab')) return;
      statusFilter.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
      target.classList.add('active');
      currentStatus = target.dataset.status || '全部';
      currentPage = 1;
      applyFilters();
    });

    paginationEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.page-btn') as HTMLElement;
      if (!btn || btn.classList.contains('disabled') || btn.classList.contains('active')) return;
      const action = btn.dataset.action;
      const page = btn.dataset.page;
      if (action === 'prev') currentPage--;
      else if (action === 'next') currentPage++;
      else if (page) currentPage = parseInt(page);
      applyFilters();
      document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    applyFilters();
  });
</script>
