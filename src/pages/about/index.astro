---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';

// 关于页面内容 - 通过单独的 md 文件控制
// 读取 markdown 内容并渲染
const aboutContent = `
<h1>关于我</h1>
<p>你好，欢迎来到我的个人空间。</p>
<p>我是 YuQi，一个喜欢折腾的BOY。</p>

<h2>关于本站</h2>
<p>这是一个基于 Astro 框架搭建的二次元/简约风格个人博客，记录生活中的思考、创造与感悟。</p>
<p>本站使用的技术栈：</p>
<ul>
<li><strong>框架</strong>：Astro v6</li>
<li><strong>样式</strong>：自定义 CSS + CSS Variables</li>
<li><strong>字体</strong>：朱雀仿宋 / Noto Sans SC</li>
<li><strong>特效</strong>：樱花飘落、Live2D 看板娘</li>
</ul>


<h2>联系方式</h2>
<ul>
<li>GitHub：<a href="https://github.com/qitinyu" target="_blank">qitinyu</a></li>
<li>B站：<a href="https://space.bilibili.com/3461582895974946" target="_blank">个人空间</a></li>
<li>Email：484894496@qq.com</li>
</ul>

<h2>致谢</h2>
<ul>
<li><p>开源项目<a href="https://mizuki.mysqil.com/" 
target="_blank">Mizuki</a>的灵感让这个博客成为可能.</p></li>
<li><p>感谢<a href="https://z.ai" target="_blank">Z.ai</a>-Agent提供技术支持.</p></li>
</ul>
`;
---

<BaseLayout title="关于">
  <div class="page-layout">
    <div class="page-main">
      <div class="about-content card prose" set:html={aboutContent} />
    </div>

    <SidebarWidget />
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .about-content {
    padding: 32px;
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
  }
</style>
