---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarWidget from '../../components/SidebarWidget.astro';

// 关于页面内容 - 通过单独的 md 文件控制
// 读取 markdown 内容并渲染
const aboutContent = `
<h1>关于我</h1>
<p>你好，欢迎来到我的个人空间。</p>
<p>我是 Yuami，一个喜欢折腾的普通人。</p>

<h2>关于本站</h2>
<p>这是一个基于 Astro 框架搭建的二次元风格个人博客，记录生活中的思考、创造与感悟。</p>
<p>本站使用的技术栈：</p>
<ul>
<li><strong>框架</strong>：Astro v6</li>
<li><strong>样式</strong>：自定义 CSS + CSS Variables</li>
<li><strong>字体</strong>：朱雀仿宋 / Noto Sans SC</li>
<li><strong>特效</strong>：樱花飘落、Live2D 看板娘</li>
</ul>

<h2>关于我</h2>
<ul>
<li>热爱前端开发，喜欢折腾各种有趣的技术</li>
<li>二次元爱好者，追番、玩游戏</li>
<li>偶尔写写文字，记录生活的点滴</li>
<li>座右铭：生命绚烂，别被黑暗压垮</li>
</ul>

<h2>联系方式</h2>
<ul>
<li>GitHub：<a href="https://github.com/qitinyu" target="_blank">qitinyu</a></li>
<li>B站：<a href="https://space.bilibili.com/3461582895974946" target="_blank">个人空间</a></li>
<li>Email：484894496@qq.com</li>
</ul>

<h2>致谢</h2>
<p>感谢所有开源项目的贡献者，让这个博客成为可能。</p>
`;
---

<BaseLayout title="关于">
  <div class="page-layout">
    <SidebarWidget />

    <div class="page-main">
      <div class="about-content card prose" set:html={aboutContent} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 24px;
    padding: 28px 24px;
  }

  .page-main {
    flex: 1;
    min-width: 0;
  }

  .about-content {
    padding: 32px;
  }

  @media (max-width: 1024px) {
    .page-layout { flex-direction: column; }
  }
</style>
