---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/dateFormat';

export async function getStaticPaths() {
  const diaries = await getCollection('diary');
  // 按日期倒序
  const sortedDiaries = [...diaries].sort((a, b) => {
    const dateA = a.data.date || '';
    const dateB = b.data.date || '';
    return dateB.localeCompare(dateA);
  });
  return sortedDiaries.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index > 0 ? sortedDiaries[index - 1] : null,
      nextPost: index < sortedDiaries.length - 1 ? sortedDiaries[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
const title = post.data.title;
const publishedRaw = post.data.date || '';
const publishedFormatted = formatDate(publishedRaw);
const tags = post.data.tags || [];
const excerpt = post.data.excerpt || '';
const cover = post.data.cover || '';
// diary 的 mood 字段（用于显示心情标签）
const mood = post.data.mood || '';

// 随机推荐2篇旅记（排除当前文章）
const allDiary = await getCollection('diary');
const otherDiaries = allDiary.filter(d => d.slug !== post.slug);
const shuffled = otherDiaries.sort(() => Math.random() - 0.5);
const recommendPosts = shuffled.slice(0, 2);
---

<BaseLayout title={title}>
  <div class="article-layout">
    <!-- Center: Article Main Content -->
    <article class="article-main">
      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <div class="article-meta">
          <span class="article-date"><i class="fa-regular fa-calendar"></i> {publishedFormatted}</span>
          {mood && <span class="article-mood"><i class="fa-solid fa-cloud-sun"></i> {mood}</span>}
          <div class="article-tags">
            {tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        </div>
        {excerpt && <p class="article-description">{excerpt}</p>}
      </header>

      {cover && (
        <div class="article-cover">
          <img src={cover} alt={title} onerror="this.style.display='none';" />
        </div>
      )}

      <div class="article-content prose" id="articleContent">
        <Content />
      </div>

      <div class="article-share">
        <button class="btn btn-ghost" id="shareBtn" title="复制链接">
          <i class="fa-solid fa-link"></i> 复制链接
        </button>
      </div>

      <div class="article-nav">
        {prevPost ? (
          <a href={`/travel/${prevPost.slug}`} class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> {prevPost.data.title}</a>
        ) : (
          <span class="btn btn-ghost" style="opacity:0.4;cursor:default;">已是最新一篇</span>
        )}
        {nextPost ? (
          <a href={`/travel/${nextPost.slug}`} class="btn btn-ghost">{nextPost.data.title} <i class="fa-solid fa-arrow-right"></i></a>
        ) : (
          <span class="btn btn-ghost" style="opacity:0.4;cursor:default;">已是最后一篇</span>
        )}
      </div>

      {recommendPosts.length > 0 && (
        <div class="article-recommend">
          <h3 class="section-title">随机推荐</h3>
          <div class="recommend-grid">
            {recommendPosts.map(rp => (
              <a href={`/travel/${rp.slug}`} class="recommend-card card" style="text-decoration:none;">
                <div class="recommend-body">
                  <h4>{rp.data.title}</h4>
                  <p>{rp.data.excerpt || rp.data.tags?.join(', ') || '点击阅读'}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  </div>
</BaseLayout>

<style is:inline>
  .article-layout {
    max-width: 860px;
    margin: 0 auto;
    padding: 28px 24px;
  }

  /* --- Article Main Content --- */
  .article-main {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    padding: 32px 36px;
  }

  /* ===== 文章主体样式 ===== */
  .article-header { margin-bottom: 24px; }

  .article-title {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .article-date,
  .article-mood {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .article-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .article-tags .tag {
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.78rem;
    background: var(--primary-alpha);
    color: var(--primary);
    border: 1px solid var(--border-color);
  }

  .article-description {
    margin-top: 14px;
    padding: 12px 16px;
    background: var(--primary-alpha);
    border-left: 3px solid var(--primary);
    border-radius: 4px;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .article-cover {
    margin: 0 0 24px 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-content { margin-bottom: 28px; }

  .article-license {
    margin: 20px 0;
    padding: 12px 16px;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.86rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .article-share {
    display: flex;
    justify-content: center;
    margin: 24px 0;
  }

  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 24px 0;
    flex-wrap: wrap;
  }

  .article-recommend { margin: 28px 0; }

  .section-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 14px;
    padding-left: 12px;
    border-left: 4px solid var(--primary);
  }

  .recommend-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .recommend-card {
    padding: 14px 16px;
    transition: all var(--transition-fast);
  }

  .recommend-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary-alpha-30);
  }

  .recommend-body h4 {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .recommend-body p {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .btn-ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-alpha);
  }

  /* 分享提示 */
  .share-toast {
    position: fixed;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--primary);
    color: #fff;
    padding: 10px 22px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 9999;
  }

  .share-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* --- Mobile (≤768px) --- */
  @media (max-width: 768px) {
    .article-layout {
      padding: 20px 14px;
    }
    .article-main {
      padding: 22px 16px;
    }
    .article-title {
      font-size: 1.4rem;
    }
    .recommend-grid {
      grid-template-columns: 1fr;
    }
    .article-nav {
      flex-direction: column;
      gap: 10px;
      align-items: center;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // 分享按钮
    const shareBtn = document.getElementById('shareBtn');
    if (shareBtn) {
      let toast: HTMLElement | null = null;
      const showToast = (msg: string) => {
        if (!toast) {
          toast = document.createElement('div');
          toast.className = 'share-toast';
          document.body.appendChild(toast);
        }
        toast!.textContent = msg;
        toast!.classList.add('show');
        setTimeout(() => toast!.classList.remove('show'), 1800);
      };
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          showToast('链接已复制到剪贴板');
        } catch (e) {
          showToast('复制失败，请手动复制');
        }
      });
    }
  });
</script>
