---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../../utils/dateFormat';

const allDiary = await getCollection('diary');
const dairyPosts = allDiary
  .map(post => ({
    slug: post.slug,
    title: post.data.title,
    date: formatDateShort(post.data.date),
    tags: post.data.tags,
    excerpt: post.data.excerpt || '',
    cover: post.data.cover || '',
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(dairyPosts.flatMap(p => p.tags))];
---

<BaseLayout title="旅记">
  <div class="page-layout page-layout-centered">
    <div class="page-main">
      <!-- 页面题头 -->
      <div class="page-header">
        <h1 class="page-title">旅记</h1>
        <p class="page-subtitle">走过的路，看过的风景</p>
      </div>

      <!-- 工具栏 -->
      <div class="filter-bar">
        <div class="filter-toolbar">
          <button class="layout-toggle-btn" id="layoutToggleBtn" title="切换卡片布局" type="button">
            <i class="fa-solid fa-grip-vertical"></i>
            <span class="layout-toggle-label">三列</span>
          </button>
          <div class="tag-filter" id="tagFilter">
            <span class="tag active" data-tag="all">全部</span>
            {allTags.map(tag => (
              <span class="tag" data-tag={tag}>{tag}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="blog-grid layout-grid-3" id="blogGrid">
        {dairyPosts.map((post, index) => (
          <article class="blog-card card" data-tags={post.tags.join(',')} data-title={post.title} data-index={index} style={`animation-delay: ${(index % 6) * 0.08}s`}>
            <a href={`/travel/${post.slug}`} class="blog-card-link">
              <div class="blog-card-body">
                <div class="blog-card-meta">
                  <span class="blog-date"><i class="fa-regular fa-calendar"></i> {post.date}</span>
                </div>
                <h3 class="blog-card-title">{post.title}</h3>
                <p class="blog-card-excerpt">{post.excerpt}</p>
                <div class="blog-card-tags">
                  {post.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-layout-centered {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 20px;
    padding: 28px 24px;
    justify-content: center;
  }

  .page-main {
    flex: 1;
    min-width: 0;
    max-width: 1100px;
  }

  /* 页面题头 */
  .page-header {
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    position: relative;
    padding-left: 14px;
  }

  .page-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 24px;
    border-radius: 2px;
    background: var(--primary);
  }

  .page-subtitle {
    font-size: 0.92rem;
    color: var(--text-muted);
    padding-left: 14px;
  }

  .filter-bar {
    margin-bottom: 24px;
  }

  .filter-toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .layout-toggle-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-family: inherit;
  }

  .layout-toggle-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-alpha);
  }

  .layout-toggle-btn i { font-size: 0.85rem; }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-filter .tag.active {
    background: var(--primary);
    color: #fff;
  }

  .blog-grid {
    display: grid;
    gap: 16px;
  }

  .blog-grid.layout-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-grid.layout-grid-1 {
    grid-template-columns: 1fr;
  }

  .blog-card {
    overflow: hidden;
    animation: fadeInUp 0.5s ease both;
  }

  .blog-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .blog-card.hidden-page { display: none; }

  .blog-card-body { padding: 16px; }

  .blog-card-meta { margin-bottom: 6px; }
  .blog-date { font-size: 0.82rem; color: var(--text-muted); }

  .blog-card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.5;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .blog-card:hover .blog-card-title { color: var(--primary); }

  .blog-card-excerpt {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .layout-grid-1 .blog-card-excerpt {
    -webkit-line-clamp: 5;
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .layout-grid-1 .blog-card-title { font-size: 1.2rem; }
  .layout-grid-1 .blog-card-body { padding: 20px 24px; }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  /* 分页样式已移至 global.css */

  @media (max-width: 1024px) {
    .page-layout-centered { flex-direction: column; }
    .blog-grid.layout-grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .blog-grid.layout-grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .blog-grid.layout-grid-3,
    .blog-grid.layout-grid-1 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const blogGrid = document.getElementById('blogGrid');
    if (!blogGrid) return;

    let layoutMode = (localStorage.getItem('yuami_travel_layout') as 'grid3' | 'list1') || 'grid3';
    let itemsPerPage = layoutMode === 'grid3' ? 9 : 5;

    const toggleBtn = document.getElementById('layoutToggleBtn');
    const toggleLabel = toggleBtn?.querySelector('.layout-toggle-label') as HTMLElement;
    const toggleIcon = toggleBtn?.querySelector('i') as HTMLElement;

    function applyLayout() {
      if (layoutMode === 'grid3') {
        blogGrid.classList.remove('layout-grid-1');
        blogGrid.classList.add('layout-grid-3');
        itemsPerPage = 9;
        if (toggleLabel) toggleLabel.textContent = '三列';
        if (toggleIcon) toggleIcon.className = 'fa-solid fa-grip-vertical';
      } else {
        blogGrid.classList.remove('layout-grid-3');
        blogGrid.classList.add('layout-grid-1');
        itemsPerPage = 5;
        if (toggleLabel) toggleLabel.textContent = '单列';
        if (toggleIcon) toggleIcon.className = 'fa-solid fa-list';
      }
    }

    applyLayout();

    toggleBtn?.addEventListener('click', () => {
      layoutMode = layoutMode === 'grid3' ? 'list1' : 'grid3';
      localStorage.setItem('yuami_travel_layout', layoutMode);
      applyLayout();
      currentPage = 1;
      applyFilters();
    });

    const tagFilter = document.getElementById('tagFilter');
    const cards = Array.from(document.querySelectorAll('.blog-card'));
    const paginationEl = document.getElementById('pagination');

    let currentPage = 1;
    let currentTag = 'all';
    let searchQuery = (window as any).__yuami_global_search || '';

    function getFilteredCards() {
      return cards.filter(card => {
        const el = card as HTMLElement;
        const tags = el.dataset.tags || '';
        const title = el.dataset.title?.toLowerCase() || '';
        const tagMatch = currentTag === 'all' || tags.includes(currentTag);
        const searchMatch = !searchQuery || title.includes(searchQuery);
        return tagMatch && searchMatch;
      });
    }

    function renderPagination(filteredCards: HTMLElement[]) {
      if (!paginationEl) return;
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / itemsPerPage));
      if (totalPages <= 1) { paginationEl.classList.add('hidden'); return; }
      paginationEl.classList.remove('hidden');
      if (currentPage > totalPages) currentPage = totalPages;

      let html = '';
      html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-action="prev"><i class="fa-solid fa-chevron-left"></i></button>`;
      const maxVisible = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
      let endPage = Math.min(totalPages, startPage + maxVisible - 1);
      if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
      }
      if (startPage > 1) {
        html += `<button class="page-btn" data-page="1">1</button>`;
        if (startPage > 2) {
          html += `<span class="page-ellipsis">...</span>`;
        }
      }
      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }
      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<span class="page-ellipsis">...</span>`;
        }
        html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
      }
      html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-action="next"><i class="fa-solid fa-chevron-right"></i></button>`;
      paginationEl.innerHTML = html;
    }

    function applyFilters() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / itemsPerPage));
      if (currentPage > totalPages) currentPage = totalPages;

      cards.forEach(card => { (card as HTMLElement).classList.add('hidden-page'); });
      const start = (currentPage - 1) * itemsPerPage;
      filteredCards.slice(start, start + itemsPerPage).forEach((card, i) => {
        (card as HTMLElement).classList.remove('hidden-page');
        (card as HTMLElement).style.animationDelay = `${i * 0.08}s`;
      });
      renderPagination(filteredCards);
    }

    tagFilter?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('tag')) return;
      tagFilter.querySelectorAll('.tag').forEach(t => t.classList.remove('active'));
      target.classList.add('active');
      currentTag = target.dataset.tag || 'all';
      currentPage = 1;
      applyFilters();
    });

    // 监听全局搜索事件
    window.addEventListener('yuami:global-search', ((e: CustomEvent) => {
      searchQuery = (e.detail?.query || '').toLowerCase();
      currentPage = 1;
      applyFilters();
    }) as EventListener);

    paginationEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.page-btn') as HTMLElement;
      if (!btn || btn.classList.contains('disabled') || btn.classList.contains('active')) return;
      const action = btn.dataset.action;
      const page = btn.dataset.page;
      if (action === 'prev') currentPage--;
      else if (action === 'next') currentPage++;
      else if (page) currentPage = parseInt(page);
      applyFilters();
      document.querySelector('.page-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    applyFilters();
  });
</script>
