---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Sakura from '../components/Sakura.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Live2D from '../components/Live2D.astro';
import { ViewTransitions } from 'astro:transitions';
import { siteConfig } from '../../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
const fullTitle = title === siteConfig.title ? title : `${title} - ${siteConfig.title}`;

// 从config读取字体和阴影配置
const fontFamily = siteConfig.font?.fontFamily || "'朱雀仿宋', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont, sans-serif";
const fontSize = siteConfig.font?.fontSize || '16px';
const fontFile = siteConfig.font?.fontFile || '/font/zqfs.woff2';
const shadowSm = siteConfig.shadow?.sm || '0 2px 8px rgba(125, 152, 245, 0.08)';
const shadowMd = siteConfig.shadow?.md || '0 4px 20px rgba(125, 152, 245, 0.12)';
const shadowLg = siteConfig.shadow?.lg || '0 8px 40px rgba(125, 152, 245, 0.16)';
const shadowHover = siteConfig.shadow?.hover || '0 8px 30px rgba(125, 152, 245, 0.2)';

// 是否启用各组件
const umamiEnabled = siteConfig.umami?.enabled !== false && siteConfig.umami?.src && siteConfig.umami?.websiteId;
const musicEnabled = siteConfig.music?.enabled !== false;
const sakuraEnabled = siteConfig.sakura?.enabled !== false;

// 背景配置
const bgConfig = siteConfig.background;
const bgEnabled = bgConfig?.enabled && ((bgConfig?.pc?.length || 0) > 0 || (bgConfig?.mobile?.length || 0) > 0);
const bgPcImages = bgConfig?.pc || [];
const bgMobileImages = bgConfig?.mobile || [];
const bgInterval = bgConfig?.interval || 3000;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7D98F5" />
    <link rel="icon" href={siteConfig.icon || '/home/icon.ico'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style is:inline>
      @font-face {
        font-family: '朱雀仿宋';
        src: url('/font/zqfs.woff2') format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      :root {
        font-family: {fontFamily};
        font-size: {fontSize};
        --shadow-sm: {shadowSm};
        --shadow-md: {shadowMd};
        --shadow-lg: {shadowLg};
        --shadow-hover: {shadowHover};
      }
      body {
        font-family: {fontFamily};
      }
    </style>
    <title>{fullTitle}</title>
    <ViewTransitions />
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      // 恢复记忆的主题色
      const savedColor = localStorage.getItem('yuami_theme_color');
      if (savedColor) {
        function hslToHex(h, s, l) {
          s /= 100; l /= 100;
          const a = s * Math.min(l, 1 - l);
          const f = (n) => {
            const k = (n + h / 30) % 12;
            const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
            return Math.round(255 * color).toString(16).padStart(2, '0');
          };
          return '#' + f(0) + f(8) + f(4);
        }
        function lighten(hex, amt) {
          hex = hex.replace('#', '');
          const r = parseInt(hex.substring(0,2),16)/255, g = parseInt(hex.substring(2,4),16)/255, b = parseInt(hex.substring(4,6),16)/255;
          const max = Math.max(r,g,b), min = Math.min(r,g,b);
          let h=0,s=0; const l=(max+min)/2;
          if(max!==min){const d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);switch(max){case r:h=((g-b)/d+(g<b?6:0))*60;break;case g:h=((b-r)/d+2)*60;break;case b:h=((r-g)/d+4)*60;break;}}
          return hslToHex(Math.round(h), Math.max(Math.round(s*100)-5,30), Math.min(Math.round(l*100)+amt,85));
        }
        function darken(hex, amt) {
          hex = hex.replace('#', '');
          const r = parseInt(hex.substring(0,2),16)/255, g = parseInt(hex.substring(2,4),16)/255, b = parseInt(hex.substring(4,6),16)/255;
          const max = Math.max(r,g,b), min = Math.min(r,g,b);
          let h=0,s=0; const l=(max+min)/2;
          if(max!==min){const d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);switch(max){case r:h=((g-b)/d+(g<b?6:0))*60;break;case g:h=((b-r)/d+2)*60;break;case b:h=((r-g)/d+4)*60;break;}}
          return hslToHex(Math.round(h), Math.min(Math.round(s*100)+5,100), Math.max(Math.round(l*100)-amt,20));
        }
        const hex = savedColor.replace('#','');
        const rv = parseInt(hex.substring(0,2),16), gv = parseInt(hex.substring(2,4),16), bv = parseInt(hex.substring(4,6),16);
        const root = document.documentElement.style;
        root.setProperty('--primary', savedColor);
        root.setProperty('--primary-light', lighten(savedColor, 15));
        root.setProperty('--primary-dark', darken(savedColor, 15));
        root.setProperty('--primary-alpha', 'rgba('+rv+','+gv+','+bv+',0.15)');
        root.setProperty('--primary-alpha-30', 'rgba('+rv+','+gv+','+bv+',0.3)');
        root.setProperty('--border-color', 'rgba('+rv+','+gv+','+bv+',0.15)');
        root.setProperty('--shadow-sm', '0 2px 8px rgba('+rv+','+gv+','+bv+',0.08)');
        root.setProperty('--shadow-md', '0 4px 20px rgba('+rv+','+gv+','+bv+',0.12)');
        root.setProperty('--shadow-lg', '0 8px 40px rgba('+rv+','+gv+','+bv+',0.16)');
        root.setProperty('--shadow-hover', '0 8px 30px rgba('+rv+','+gv+','+bv+',0.2)');
      }
    </script>
    <!-- Umami Analytics -->
    {umamiEnabled && (
      <script async src={siteConfig.umami.src} data-website-id={siteConfig.umami.websiteId}></script>
    )}
  </head>
  <body>
    <!-- 全屏背景层 -->
    {bgEnabled && (
      <div class="site-background" id="siteBackground"
        data-pc-images={JSON.stringify(bgPcImages)}
        data-mobile-images={JSON.stringify(bgMobileImages)}
        data-interval={bgInterval}
      >
        <div class="bg-image bg-current" id="bgCurrent"></div>
        <div class="bg-image bg-next" id="bgNext"></div>
      </div>
    )}

    <Navbar />
    <main class="page-content" style="flex: 1; padding-top: var(--nav-height); min-height: 0; position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer />
    {sakuraEnabled && <Sakura />}
    <FloatingButtons />
    <Live2D />

    <!-- 全局背景样式 -->
    {bgEnabled && (
    <style is:inline>
      .site-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        overflow: hidden;
      }
      .site-background .bg-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        transition: opacity 1s ease;
      }
      .site-background .bg-current {
        opacity: 1;
        z-index: 1;
      }
      .site-background .bg-next {
        opacity: 0;
        z-index: 2;
      }
      /* 遮罩层已移除，背景图片直接展示，通过卡片毛玻璃效果保证内容可读性 */
      /* 背景启用时，内容区域需要半透明背景增强可读性 */
      .site-background ~ .page-content .card,
      .site-background ~ .page-content .sidebar-panel {
        background: rgba(255, 255, 255, 0.88) !important;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }
      [data-theme="dark"] .site-background ~ .page-content .card,
      [data-theme="dark"] .site-background ~ .page-content .sidebar-panel {
        background: rgba(28, 32, 64, 0.88) !important;
      }
      /* Navbar在背景启用时更透明 */
      .site-background ~ .navbar.glass {
        background: rgba(255, 255, 255, 0.72);
      }
      [data-theme="dark"] .site-background ~ .navbar.glass {
        background: rgba(23, 27, 51, 0.78);
      }
    </style>
    )}

    <!-- 背景轮播脚本 -->
    {bgEnabled && (
    <script is:inline>
      (function() {
        function initBackground() {
          var bgContainer = document.getElementById('siteBackground');
          var bgCurrent = document.getElementById('bgCurrent');
          var bgNext = document.getElementById('bgNext');
          if (!bgContainer || !bgCurrent || !bgNext) return;

          var pcImages = JSON.parse(bgContainer.dataset.pcImages || '[]');
          var mobileImages = JSON.parse(bgContainer.dataset.mobileImages || '[]');
          var interval = parseInt(bgContainer.dataset.interval || '3000');

          var isMobile = window.innerWidth <= 768;
          var images = isMobile && mobileImages.length > 0 ? mobileImages : pcImages;

          function isApiUrl(url) {
            return url.startsWith('http') && !url.startsWith('/') && !url.startsWith('./');
          }

          var hasApiUrl = images.some(isApiUrl);
          if (images.length === 0) return;

          var currentIndex = 0;

          function setBgImage(el, url) {
            var finalUrl = isApiUrl(url) ? url + (url.indexOf('?') >= 0 ? '&' : '?') + '_t=' + Date.now() : url;
            el.style.backgroundImage = 'url("' + finalUrl + '")';
          }

          // 初始化第一张图
          setBgImage(bgCurrent, images[0]);

          // 单图且非API → 固定显示，不轮播
          if (images.length === 1 && !hasApiUrl) return;

          // 多图或API → 轮播
          function rotate() {
            currentIndex = (currentIndex + 1) % images.length;
            var nextUrl = images[currentIndex];
            setBgImage(bgNext, nextUrl);

            // 淡入淡出动画
            bgNext.style.opacity = '1';
            bgCurrent.style.opacity = '0';

            setTimeout(function() {
              bgCurrent.style.backgroundImage = bgNext.style.backgroundImage;
              bgCurrent.style.opacity = '1';
              bgNext.style.opacity = '0';
            }, 1000);
          }

          setInterval(rotate, interval);
        }

        // 首次加载
        initBackground();
        // View Transitions 导航后重新初始化
        document.addEventListener('astro:page-load', initBackground);
        // 响应窗口尺寸变化
        var resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(initBackground, 500);
        });
      })();
    </script>
    )}
  </body>
</html>