---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Sakura from '../components/Sakura.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Live2D from '../components/Live2D.astro';
import { ViewTransitions } from 'astro:transitions';
import { siteConfig } from '../../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
const fullTitle = title === siteConfig.title ? title : `${title} - ${siteConfig.title}`;

// 从config读取字体和阴影配置
const fontFamily = siteConfig.font?.fontFamily || "'朱雀仿宋', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont, sans-serif";
const fontSize = siteConfig.font?.fontSize || '16px';
const fontFile = siteConfig.font?.fontFile || '/font/zqfs.woff2';
const shadowSm = siteConfig.shadow?.sm || 'none';
const shadowMd = siteConfig.shadow?.md || 'none';
const shadowLg = siteConfig.shadow?.lg || 'none';
const shadowHover = siteConfig.shadow?.hover || 'none';

// 是否启用各组件
const umamiEnabled = siteConfig.umami?.enabled !== false && siteConfig.umami?.src && siteConfig.umami?.websiteId;
const busuanziEnabled = siteConfig.busuanzi?.enabled !== false;
const musicEnabled = siteConfig.music?.enabled !== false;
const sakuraEnabled = siteConfig.sakura?.enabled !== false;

// 背景配置
const bgConfig = siteConfig.background;
const bgEnabled = bgConfig?.enabled && ((bgConfig?.pc?.length || 0) > 0 || (bgConfig?.mobile?.length || 0) > 0);
const bgPcImages = bgConfig?.pc || [];
const bgMobileImages = bgConfig?.mobile || [];
const bgInterval = bgConfig?.interval || 3000;

// 加载动画配置
const loadingConfig = siteConfig.loadingAnimation;
const loadingEnabled = loadingConfig?.enabled !== false;
const loadingType = loadingConfig?.type || 'builtin';
const loadingSrc = loadingConfig?.src || '';
const loadingMinDuration = loadingConfig?.minDuration || 300;

// 引导页配置
const welcomeConfig = siteConfig.welcomePage;
const welcomeEnabled = welcomeConfig?.enabled !== false;
const welcomeBg = welcomeConfig?.backgroundImage || '';
const welcomeAvatar = welcomeConfig?.avatar || siteConfig.avatar || '/home/avatar.webp';
const welcomeTitle = welcomeConfig?.title || 'Welcome';
const welcomeSubtitle = welcomeConfig?.subtitle || '';

// 引导页打字机文本（从轩窗配置移过来）
const welcomeTypewriterTexts = siteConfig.typewriterTexts || [
  '生命绚烂，别被黑暗压垮。',
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7D98F5" />
    <link rel="icon" href={siteConfig.icon || '/home/icon.ico'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style is:inline>
      @font-face {
        font-family: '朱雀仿宋';
        src: url('/font/zqfs.woff2') format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      :root {
        font-family: {fontFamily};
        font-size: {fontSize};
        --shadow-sm: {shadowSm};
        --shadow-md: {shadowMd};
        --shadow-lg: {shadowLg};
        --shadow-hover: {shadowHover};
      }
      body {
        font-family: {fontFamily};
      }
      /* SPA导航时根据data属性立即隐藏已关闭的引导页，防止闪烁 */
      html[data-welcome-dismissed] .welcome-page { display: none !important; }
    </style>
    <title>{fullTitle}</title>
    <ViewTransitions />
    <!-- 防止主题闪烁 -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      // 恢复记忆的主题色
      const savedColor = localStorage.getItem('yuami_theme_color');
      if (savedColor) {
        function hslToHex(h, s, l) {
          s /= 100; l /= 100;
          const a = s * Math.min(l, 1 - l);
          const f = (n) => {
            const k = (n + h / 30) % 12;
            const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
            return Math.round(255 * color).toString(16).padStart(2, '0');
          };
          return '#' + f(0) + f(8) + f(4);
        }
        function lighten(hex, amt) {
          hex = hex.replace('#', '');
          const r = parseInt(hex.substring(0,2),16)/255, g = parseInt(hex.substring(2,4),16)/255, b = parseInt(hex.substring(4,6),16)/255;
          const max = Math.max(r,g,b), min = Math.min(r,g,b);
          let h=0,s=0; const l=(max+min)/2;
          if(max!==min){const d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);switch(max){case r:h=((g-b)/d+(g<b?6:0))*60;break;case g:h=((b-r)/d+2)*60;break;case b:h=((r-g)/d+4)*60;break;}}
          return hslToHex(Math.round(h), Math.max(Math.round(s*100)-5,30), Math.min(Math.round(l*100)+amt,85));
        }
        function darken(hex, amt) {
          hex = hex.replace('#', '');
          const r = parseInt(hex.substring(0,2),16)/255, g = parseInt(hex.substring(2,4),16)/255, b = parseInt(hex.substring(4,6),16)/255;
          const max = Math.max(r,g,b), min = Math.min(r,g,b);
          let h=0,s=0; const l=(max+min)/2;
          if(max!==min){const d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);switch(max){case r:h=((g-b)/d+(g<b?6:0))*60;break;case g:h=((b-r)/d+2)*60;break;case b:h=((r-g)/d+4)*60;break;}}
          return hslToHex(Math.round(h), Math.min(Math.round(s*100)+5,100), Math.max(Math.round(l*100)-amt,20));
        }
        const hex = savedColor.replace('#','');
        const rv = parseInt(hex.substring(0,2),16), gv = parseInt(hex.substring(2,4),16), bv = parseInt(hex.substring(4,6),16);
        const root = document.documentElement.style;
        root.setProperty('--primary', savedColor);
        root.setProperty('--primary-light', lighten(savedColor, 15));
        root.setProperty('--primary-dark', darken(savedColor, 15));
        root.setProperty('--primary-alpha', 'rgba('+rv+','+gv+','+bv+',0.15)');
        root.setProperty('--primary-alpha-30', 'rgba('+rv+','+gv+','+bv+',0.3)');
        root.setProperty('--border-color', 'rgba('+rv+','+gv+','+bv+',0.15)');
        root.setProperty('--shadow-sm', 'none');
        root.setProperty('--shadow-md', 'none');
        root.setProperty('--shadow-lg', 'none');
        root.setProperty('--shadow-hover', 'none');
      }
      // 恢复用户对全局背景/樱花特效的偏好
      var _bgPref = localStorage.getItem('yuami_bg_enabled');
      if (_bgPref === 'false') {
        document.documentElement.classList.add('bg-user-off');
      }
      var _sakuraPref = localStorage.getItem('yuami_sakura_enabled');
      if (_sakuraPref === 'false') {
        document.documentElement.classList.add('sakura-user-off');
      }
    </script>
    <!-- SPA导航时根据sessionStorage立即设置data属性，配合CSS防止引导页闪烁 -->
    <script is:inline>
      if (sessionStorage.getItem('yuami_welcome_dismissed')) {
        document.documentElement.setAttribute('data-welcome-dismissed', 'true');
      }
    </script>
    <!-- 注入引导页打字机文本 -->
    <script define:vars={{ welcomeTypewriterTexts }}>
      window.__yuami_welcome_typewriter_texts = welcomeTypewriterTexts;
    </script>
    <!-- Umami Analytics (legacy, disabled by default) -->
    {umamiEnabled && (
      <script async src={siteConfig.umami.src} data-website-id={siteConfig.umami.websiteId}></script>
    )}
    <!-- 不蒜子统计 - 使用多CDN备源 -->
    {busuanziEnabled && (
      <script is:inline>
        // 不蒜子多源加载：优先 ibruce.info，失败则用 lf6-cdn-tos
        (function() {
          var bsLoaded = false;
          var bsTimeout;
          function onBusuanziLoad() {
            bsLoaded = true;
            clearTimeout(bsTimeout);
          }
          // 加载主源
          var s1 = document.createElement('script');
          s1.async = true;
          s1.src = '//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
          s1.onload = onBusuanziLoad;
          s1.onerror = function() {
            // 主源失败，尝试备用源
            if (!bsLoaded) {
              var s2 = document.createElement('script');
              s2.async = true;
              s2.src = '//lf6-cdn-tos.bytecdntp.com/cdn/expire-1-M/busuanzi/2.3/busuanzi.pure.mini.js';
              s2.onload = onBusuanziLoad;
              s2.onerror = function() {
                // 两个源都失败，显示提示
                setBusuanziFallback();
              };
              document.head.appendChild(s2);
            }
          };
          document.head.appendChild(s1);
          // 超时处理：5秒未加载成功则显示fallback
          bsTimeout = setTimeout(function() {
            if (!bsLoaded) setBusuanziFallback();
          }, 5000);
          // fallback: 显示站点统计数字代替
          function setBusuanziFallback() {
            var els = document.querySelectorAll('#busuanzi_value_site_pv, #busuanzi_value_site_uv, #busuanzi_value_page_pv');
            els.forEach(function(el) {
              if (el.textContent === '—' || el.textContent.trim() === '') {
                el.textContent = 'N/A';
                el.style.fontSize = '0.85rem';
                el.style.opacity = '0.5';
              }
            });
          }
        })();
      </script>
    )}
  </head>
  <body>
    <!-- 全局加载动画 -->
    {loadingEnabled && (
    <div class="loading-overlay" id="loadingOverlay"
      data-type={loadingType}
      data-src={loadingSrc}
      data-min-duration={loadingMinDuration}
    >
      <div class="loading-content">
        {loadingType === 'builtin' && (
          <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <p class="loading-text">加载中...</p>
          </div>
        )}
        {loadingType === 'gif' && loadingSrc && (
          <img src={loadingSrc} alt="Loading" class="loading-gif" />
        )}
        {loadingType === 'online' && loadingSrc && (
          <iframe src={loadingSrc} class="loading-iframe" frameborder="0"></iframe>
        )}
      </div>
    </div>
    )}
    <style is:inline>
      .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        background: var(--bg-primary);
        display: flex;
        justify-content: center;
        align-items: center;
        transition: opacity 0.5s ease;
      }
      .loading-overlay.fade-out {
        opacity: 0;
        pointer-events: none;
      }
      .loading-content {
        text-align: center;
      }
      .loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }
      .spinner-ring {
        width: 48px;
        height: 48px;
        border: 3px solid var(--border-color);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .loading-text {
        font-size: 0.95rem;
        color: var(--text-muted);
      }
      .loading-gif {
        max-width: 200px;
        max-height: 200px;
      }
      .loading-iframe {
        width: 300px;
        height: 300px;
        border: none;
      }
      [data-theme="dark"] .loading-overlay {
        background: #0f1225;
      }
    </style>

    <!-- 引导页 -->
    {welcomeEnabled && (
    <div class="welcome-page" id="welcomePage">
      <div class="welcome-bg" style={welcomeBg ? `background-image: url(${welcomeBg}); background-size: cover; background-position: center;` : ''}></div>
      <div class="welcome-content">
        <div class="welcome-avatar-wrap">
          <div class="welcome-avatar-border"></div>
          <img src={welcomeAvatar} alt="Avatar" class="welcome-avatar" />
        </div>
        <div class="welcome-typewriter-row">
          <span class="welcome-typewriter-text" id="welcomeTypewriterText"></span>
          <span class="welcome-typewriter-cursor">|</span>
        </div>
      </div>
      <div class="welcome-scroll-hint">
        <span class="welcome-scroll-hint-text">向上滚动进入</span>
        <div class="welcome-scroll-hint-icon">
          <i class="fa-solid fa-chevron-up"></i>
        </div>
      </div>
    </div>
    )}
    <style is:inline>
      .welcome-page {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9998;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.7s ease;
        will-change: transform, opacity;
      }
      .welcome-page.dismissed {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
      }
      .welcome-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        z-index: 0;
      }
      [data-theme="dark"] .welcome-bg {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      }
      .welcome-content {
        position: relative;
        z-index: 1;
        text-align: center;
        color: #fff;
      }
      .welcome-avatar-wrap {
        position: relative;
        width: 130px;
        height: 130px;
        margin: 0 auto 24px;
      }
      .welcome-avatar-border {
        position: absolute;
        top: -4px;
        left: -4px;
        width: 138px;
        height: 138px;
        border-radius: 50%;
        overflow: hidden;
        z-index: 1;
      }
      .welcome-avatar-border::before {
        content: '';
        position: absolute;
        width: 200%;
        height: 200%;
        background: conic-gradient(transparent, transparent, transparent, transparent, #e0f0e9, #cca4e3, #e0c3fc, #f173ac);
        top: -50%;
        left: -50%;
        animation: welcomeRotate 3s linear infinite;
        z-index: 2;
      }
      .welcome-avatar-border::after {
        content: '';
        position: absolute;
        inset: 4px;
        background: rgba(0, 0, 0, 0.6);
        border-radius: 50%;
        z-index: 2;
      }
      @keyframes welcomeRotate {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      .welcome-avatar {
        position: relative;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255, 255, 255, 0.6);
        z-index: 3;
      }
      .welcome-avatar:hover {
        transform: scale(1.1);
        transition: transform 0.3s ease;
      }
      /* 打字机区域 */
      .welcome-typewriter-row {
        display: flex;
        align-items: baseline;
        justify-content: center;
        min-height: 2.4em;
        max-width: 720px;
        margin: 28px auto 0;
        flex-wrap: wrap;
      }
      .welcome-typewriter-text {
        font-size: 2rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.95);
        line-height: 1.7;
      }
      .welcome-typewriter-cursor {
        font-size: 2rem;
        color: rgba(255, 255, 255, 0.95);
        animation: welcomeBlink 1s step-end infinite;
        font-weight: 700;
        margin-left: 2px;
      }
      @keyframes welcomeBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
      /* 滚动提示 */
      .welcome-scroll-hint {
        position: absolute;
        bottom: 36px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        z-index: 2;
        color: #fff;
        opacity: 0.7;
        transition: opacity 0.3s;
        pointer-events: none;
      }
      .welcome-scroll-hint-text {
        font-size: 0.85rem;
        letter-spacing: 2px;
      }
      .welcome-scroll-hint-icon {
        font-size: 1.6rem;
        animation: welcomeBounce 1.8s infinite;
      }
      @keyframes welcomeBounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-12px); }
        60% { transform: translateY(-6px); }
      }
    </style>

    <!-- 卡片入场动画 - 初始隐藏，引导页关闭后触发 -->
    <style is:inline>
      @keyframes cardEntrance {
        from {
          opacity: 0;
          transform: translateY(15px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      /* 引导页存在时，卡片不播放动画 */
      .page-content .card,
      .page-content .sidebar-panel {
        opacity: 0;
      }
      /* 引导页关闭后，触发动画 */
      .page-content.cards-animated .card,
      .page-content.cards-animated .sidebar-panel {
        animation: cardEntrance 0.5s ease both;
        opacity: 1;
      }
    </style>

    <!-- 全屏背景层 -->
    {bgEnabled && (
      <div class="site-background" id="siteBackground"
        data-pc-images={JSON.stringify(bgPcImages)}
        data-mobile-images={JSON.stringify(bgMobileImages)}
        data-interval={bgInterval}
      >
        <div class="bg-image bg-current" id="bgCurrent"></div>
        <div class="bg-image bg-next" id="bgNext"></div>
      </div>
    )}

    <Navbar />
    <main class="page-content" style="flex: 1; padding-top: var(--nav-height); min-height: 0; position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer />
    {sakuraEnabled && <Sakura />}
    <FloatingButtons />
    <Live2D />

    <!-- 全局背景样式 -->
    {bgEnabled && (
    <style is:inline>
      .site-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        overflow: hidden;
      }
      .site-background .bg-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        transition: opacity 1s ease;
      }
      .site-background .bg-current {
        opacity: 1;
        z-index: 1;
      }
      .site-background .bg-next {
        opacity: 0;
        z-index: 2;
      }
      /* 背景启用时，所有内容区域半透明效果（无磨砂） */
      /* 子页面内容区域整体背景包裹 */
      .site-background:not(.disabled) ~ .page-content .page-main {
        background: rgba(255, 255, 255, 0.82);
        border-radius: var(--radius-lg);
        padding: 20px;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .page-main {
        background: rgba(28, 32, 64, 0.82);
      }
      /* 首页(轩窗)主内容区域半透明背景 */
      .site-background:not(.disabled) ~ .page-content .home-section .card:not(.qingjin-card) {
        background: rgba(255, 255, 255, 0.82) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .home-section .card:not(.qingjin-card) {
        background: rgba(28, 32, 64, 0.82) !important;
      }
      .site-background:not(.disabled) ~ .page-content .qingjin-card {
        background: transparent !important;
        border: none !important;
      }
      .site-background:not(.disabled) ~ .page-content .home-section .project-card {
        background: rgba(255, 255, 255, 0.82) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .home-section .project-card {
        background: rgba(28, 32, 64, 0.82) !important;
      }
      /* 卡片和侧边栏面板 */
      .site-background:not(.disabled) ~ .page-content .card:not(.qingjin-card),
      .site-background:not(.disabled) ~ .page-content .sidebar-panel {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .card:not(.qingjin-card),
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .sidebar-panel {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 游戏卡片 */
      .site-background:not(.disabled) ~ .page-content .game-card {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .game-card {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 搜索框 */
      .site-background:not(.disabled) ~ .page-content .search-box {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .search-box {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 筛选标签 - 确保文字可见 */
      .site-background:not(.disabled) ~ .page-content .filter-tab {
        background: rgba(255, 255, 255, 0.88) !important;
        color: var(--text-primary) !important;
        border: 1px solid var(--border-color);
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .filter-tab {
        background: rgba(28, 32, 64, 0.88) !important;
        color: var(--text-secondary) !important;
      }
      .site-background:not(.disabled) ~ .page-content .filter-tab:hover,
      .site-background:not(.disabled) ~ .page-content .filter-tab.active {
        background: var(--primary) !important;
        color: #fff !important;
        border-color: var(--primary);
      }
      /* 分页按钮 */
      .site-background:not(.disabled) ~ .page-content .page-btn {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .page-btn {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 闲游感悟 */
      .site-background:not(.disabled) ~ .page-content .reflection-section {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .reflection-section {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 评论区 */
      .site-background:not(.disabled) ~ .page-content .twikoo-card-bg {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .twikoo-card-bg {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 返回按钮 */
      .site-background:not(.disabled) ~ .page-content .back-btn {
        background: rgba(255, 255, 255, 0.78) !important;
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .back-btn {
        background: rgba(28, 32, 64, 0.78) !important;
      }
      /* 标签筛选 */
      .site-background:not(.disabled) ~ .page-content .tag {
        background: rgba(255, 255, 255, 0.78);
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content .tag {
        background: rgba(28, 32, 64, 0.78);
      }
      /* Navbar半透明 */
      .site-background:not(.disabled) ~ .navbar.glass {
        background: rgba(255, 255, 255, 0.65);
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .navbar.glass {
        background: rgba(23, 27, 51, 0.7);
      }
      /* Footer半透明 - 确保可见 */
      .site-footer {
        position: relative;
        z-index: 1;
      }
      .site-background:not(.disabled) ~ .page-content ~ .site-footer.glass {
        background: rgba(255, 255, 255, 0.65);
      }
      [data-theme="dark"] .site-background:not(.disabled) ~ .page-content ~ .site-footer.glass {
        background: rgba(23, 27, 51, 0.7);
      }
    </style>
    )}

    <!-- 用户偏好覆盖样式（始终渲染，防止首屏闪烁） -->
    <style is:inline>
      /* 用户关闭全局背景时隐藏背景层 */
      html.bg-user-off .site-background { display: none !important; }
      /* 用户关闭樱花特效时隐藏花瓣容器 */
      html.sakura-user-off .sakura-container { display: none !important; }
    </style>

    <!-- 背景轮播脚本 -->
    {bgEnabled && (
    <script is:inline>
      (function() {
        // 全局定时器ID，确保每次初始化前清除旧定时器
        var _bgTimerId = null;
        // 记录上次使用的设备类型，避免相同设备重复初始化
        var _lastDeviceType = null;

        function isApiUrl(url) {
          return url.startsWith('http') && !url.startsWith('/') && !url.startsWith('./');
        }

        function setBgImage(el, url, isApi) {
          var finalUrl = isApi ? url + (url.indexOf('?') >= 0 ? '&' : '?') + '_t=' + Date.now() : url;
          el.style.backgroundImage = 'url("' + finalUrl + '")';
        }

        function initBackground() {
          var bgContainer = document.getElementById('siteBackground');
          var bgCurrent = document.getElementById('bgCurrent');
          var bgNext = document.getElementById('bgNext');
          if (!bgContainer || !bgCurrent || !bgNext) return;

          var pcImages = JSON.parse(bgContainer.dataset.pcImages || '[]');
          var mobileImages = JSON.parse(bgContainer.dataset.mobileImages || '[]');
          var interval = parseInt(bgContainer.dataset.interval || '3000');

          var isMobile = window.innerWidth <= 768;
          var deviceType = isMobile ? 'mobile' : 'pc';

          // 相同设备类型不重复初始化（避免astro:page-load重复触发）
          if (_lastDeviceType === deviceType && _bgTimerId !== null) return;
          _lastDeviceType = deviceType;

          // 清除旧定时器，防止叠加
          if (_bgTimerId !== null) {
            clearInterval(_bgTimerId);
            _bgTimerId = null;
          }

          var images = isMobile && mobileImages.length > 0 ? mobileImages : pcImages;
          var hasApiUrl = images.some(isApiUrl);
          if (images.length === 0) return;

          var currentIndex = 0;

          // 重置显示状态
          bgCurrent.style.opacity = '1';
          bgNext.style.opacity = '0';

          // 初始化第一张图
          setBgImage(bgCurrent, images[0], isApiUrl(images[0]));

          // 单图且非API → 固定显示，不轮播
          if (images.length === 1 && !hasApiUrl) return;

          // 多图或API → 轮播
          function rotate() {
            currentIndex = (currentIndex + 1) % images.length;
            var nextUrl = images[currentIndex];
            setBgImage(bgNext, nextUrl, isApiUrl(nextUrl));

            // 淡入淡出动画
            bgNext.style.opacity = '1';
            bgCurrent.style.opacity = '0';

            setTimeout(function() {
              bgCurrent.style.backgroundImage = bgNext.style.backgroundImage;
              bgCurrent.style.opacity = '1';
              bgNext.style.opacity = '0';
            }, 1000);
          }

          _bgTimerId = setInterval(rotate, interval);
        }

        // 首次加载
        initBackground();
        // View Transitions 导航后重新初始化
        document.addEventListener('astro:page-load', function() {
          // 页面导航后重置状态，强制重新初始化
          _lastDeviceType = null;
          initBackground();
        });
        // 响应窗口尺寸变化（移动端/PC端切换）
        var resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function() {
            // resize时重置设备类型检查，确保切换时能重新初始化
            _lastDeviceType = null;
            initBackground();
          }, 500);
        });
      })();
    </script>
    )}

    <!-- 加载动画 & 引导页控制脚本（使用module script确保SPA导航后正确执行） -->
    <script>
      // === astro:after-swap: DOM交换后立即恢复引导页data属性，防止闪烁 ===
      document.addEventListener('astro:after-swap', () => {
        if (sessionStorage.getItem('yuami_welcome_dismissed')) {
          document.documentElement.setAttribute('data-welcome-dismissed', 'true');
        }
      });

      // === SPA导航开始时，重置并显示加载动画 ===
      document.addEventListener('astro:before-preparation', () => {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) {
          overlay.classList.remove('fade-out');
          overlay.style.display = '';
          overlay.style.opacity = '';
          overlay.style.pointerEvents = '';
        }
      });

      document.addEventListener('astro:page-load', () => {
        // === 加载动画控制（全局：每次页面加载/导航都显示） ===
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) {
          const minDuration = parseInt(overlay.dataset.minDuration || '300');
          const startTime = Date.now();
          let hidden = false;

          function hideOverlay() {
            if (hidden) return;
            hidden = true;
            const elapsed = Date.now() - startTime;
            const remaining = Math.max(0, minDuration - elapsed);
            setTimeout(() => {
              overlay.classList.add('fade-out');
              setTimeout(() => {
                overlay.style.display = 'none';
              }, 400);
            }, remaining);
          }

          if (document.readyState === 'complete') {
            hideOverlay();
          } else {
            window.addEventListener('load', hideOverlay);
          }
          // Safety: force hide after 3 seconds (用户要求3秒)
          setTimeout(hideOverlay, 3000);
        }

        // === 引导页控制 ===
        const welcomePage = document.getElementById('welcomePage');
        if (welcomePage) {
          const dismissed = sessionStorage.getItem('yuami_welcome_dismissed');
          if (dismissed) {
            welcomePage.style.display = 'none';
            // 同步恢复data属性，确保CSS规则生效
            document.documentElement.setAttribute('data-welcome-dismissed', 'true');
            // 引导页已关闭，直接显示卡片（无动画）
            const pageContent = document.querySelector('.page-content');
            if (pageContent) pageContent.classList.add('cards-animated');
          } else {
            // 滚轮检测到即直接上滑
            let isDismissed = false;

            function finishDismiss() {
              if (isDismissed) return;
              isDismissed = true;
              welcomePage.classList.add('dismissed');
              sessionStorage.setItem('yuami_welcome_dismissed', '1');
              document.documentElement.setAttribute('data-welcome-dismissed', 'true');
              const pageContent = document.querySelector('.page-content');
              if (pageContent) {
                pageContent.classList.add('cards-animated');
                pageContent.querySelectorAll('.card, .sidebar-panel').forEach((el, i) => {
                  (el as HTMLElement).style.animationDelay = `${i * 0.08}s`;
                });
              }
              setTimeout(() => {
                welcomePage.style.display = 'none';
              }, 800);
              cleanup();
            }

            function cleanup() {
              window.removeEventListener('wheel', onWheel);
              window.removeEventListener('touchstart', onTouchStart);
              window.removeEventListener('touchend', onTouchEnd);
              window.removeEventListener('keydown', onKey);
            }

            function onWheel(e: WheelEvent) {
              if (isDismissed) return;
              e.preventDefault();
              finishDismiss();
            }

            let touchStartY = 0;
            function onTouchStart(e: TouchEvent) {
              touchStartY = e.touches[0].clientY;
            }
            function onTouchEnd(e: TouchEvent) {
              if (isDismissed) return;
              const diff = touchStartY - e.changedTouches[0].clientY;
              if (Math.abs(diff) > 30) {
                finishDismiss();
              }
            }
            function onKey(e: KeyboardEvent) {
              if (isDismissed) return;
              if (e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                finishDismiss();
              }
            }

            window.addEventListener('wheel', onWheel, { passive: false });
            window.addEventListener('touchstart', onTouchStart, { passive: true });
            window.addEventListener('touchend', onTouchEnd, { passive: true });
            window.addEventListener('keydown', onKey);

            // 启动打字机效果（支持api:前缀动态获取）
            const typewriterEl = document.getElementById('welcomeTypewriterText');
            var rawTexts = (window as any).__yuami_welcome_typewriter_texts || [
              '生命绚烂，别被黑暗压垮。',
            ];
            if (typewriterEl) {
              var texts = rawTexts.slice();
              texts.forEach(function(item, idx) {
                if (typeof item === 'string' && item.indexOf('api:') === 0) {
                  var url = item.substring(4);
                  fetch(url, { cache: 'no-cache' }).then(function(res) {
                    if (!res.ok) return;
                    return res.text();
                  }).then(function(txt) {
                    if (!txt) return;
                    txt = txt.trim();
                    try {
                      var json = JSON.parse(txt);
                      txt = json.hitokoto || json.content || json.text || json.msg || json.data || txt;
                    } catch(e) {}
                    if (txt) texts[idx] = txt;
                  }).catch(function() {});
                }
              });
              var textIndex = 0;
              let charIndex = 0;
              let isDeleting = false;
              function typewrite() {
                const currentText = texts[textIndex];
                if (isDeleting) {
                  typewriterEl.textContent = currentText.substring(0, charIndex - 1);
                  charIndex--;
                } else {
                  typewriterEl.textContent = currentText.substring(0, charIndex + 1);
                  charIndex++;
                }
                let delay = isDeleting ? 40 : 80;
                if (!isDeleting && charIndex === currentText.length) {
                  delay = 2500;
                  isDeleting = true;
                } else if (isDeleting && charIndex === 0) {
                  isDeleting = false;
                  textIndex = (textIndex + 1) % texts.length;
                  delay = 500;
                }
                setTimeout(typewrite, delay);
              }
              typewrite();
            }
          }
        }
      });
    </script>
  </body>
</html>
